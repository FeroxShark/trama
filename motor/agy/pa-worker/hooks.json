{
  "pa-worker": {
    "PreToolUse": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "bash ./agy-pa.sh pre", "timeout": 30}]}
    ],
    "PostToolUse": [
      {"matcher": "*", "hooks": [{"type": "command", "command": "bash ./agy-pa.sh post", "timeout": 30}]}
    ],
    "PostInvocation": [
      {"type": "command", "command": "bash ./agy-pa.sh inv", "timeout": 10}
    ]
  }
}

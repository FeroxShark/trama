#!/usr/bin/env bash
# Guardia de cargo para los workers de codex (pa pone codex/bin primero en el PATH), la misma que
# hooks/latido.sh en un worker claude: nada de build de release (pisa el target compartido y el binario
# del dueño), `cargo install` ni `cargo clean` (el target es el del tree principal).
aqui="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
real=""
IFS=: read -ra dirs <<<"$PATH"
for d in "${dirs[@]}"; do
  [[ -z "$d" || "$(cd "$d" 2>/dev/null && pwd)" == "$aqui" ]] && continue
  [[ -x "$d/cargo" ]] && { real="$d/cargo"; break; }
done
[[ -n "$real" ]] || { echo "cargo: no encuentro el cargo de verdad en el PATH" >&2; exit 127; }
sub=""; prev=""
for a in "$@"; do
  [[ "$a" == -- ]] && break
  if [[ "$a" == --release || "$a" == -r || "$a" == --profile=release || ( "$prev" == --profile && "$a" == release ) ]]; then
    echo "BLOQUEADO: build de release en un worker: pisa el target compartido. El build lo hace el jefe después de integrar. Probá con cargo test/check o build debug; si de verdad hace falta release, decilo en DECISION." >&2
    exit 2
  fi
  [[ -z "$sub" && "$a" != -* && "$a" != +* ]] && sub="$a"
  prev="$a"
done
case "$sub" in
  install) echo "BLOQUEADO: nada de 'cargo install' en un worker: instalar lo hace el jefe después de integrar." >&2; exit 2 ;;
  clean)   echo "BLOQUEADO: nada de 'cargo clean' en un worker: el target es compartido con el tree principal (y con otros workers). Si sospechás de un artefacto roto, decilo en DECISION." >&2; exit 2 ;;
esac
exec "$real" "$@"

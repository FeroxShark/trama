#!/usr/bin/env bash
# Guardia de git para los workers de codex (pa pone codex/bin primero en el PATH). codex no tiene hooks
# como claude ni plugin como agy: lo que hooks/latido.sh bloquea por regex se bloquea acá, en el comando.
# Bloquea `git stash` (salvo list/show), `git add -A/--all/-u/--update/.` y `git commit -a/--all`;
# todo lo demás va al git de verdad (el primero del PATH que no es este directorio).
aqui="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
real=""
IFS=: read -ra dirs <<<"$PATH"
for d in "${dirs[@]}"; do
  [[ -z "$d" || "$(cd "$d" 2>/dev/null && pwd)" == "$aqui" ]] && continue
  [[ -x "$d/git" ]] && { real="$d/git"; break; }
done
[[ -n "$real" ]] || { echo "git: no encuentro el git de verdad en el PATH" >&2; exit 127; }
no() { echo "BLOQUEADO: $1" >&2; exit 2; }
SIN_A="nada de 'git commit -a' en un worker: commitea todo lo modificado, incluido lo de otra sesión. git add <archivo> y commit sin -a."
# El subcomando es el primer argumento que no es una opción global (las que llevan valor: -C, -c y
# --opción sin "=").
args=("$@"); i=0; n=${#args[@]}
while (( i < n )); do
  case "${args[i]}" in
    -C|-c|--git-dir|--work-tree|--namespace|--exec-path|--config-env) i=$((i+2)) ;;
    -*) i=$((i+1)) ;;
    *) break ;;
  esac
done
sub="${args[i]:-}"; resto=("${args[@]:i+1}")
case "$sub" in
  stash)
    [[ "${resto[0]:-}" == list || "${resto[0]:-}" == show ]] \
      || no "nada de 'git stash' en un worker: si te cortan a mitad, el trabajo sin commitear de otra sesión queda en el stash y desaparece del working tree. Trabajá encima de lo que haya y commiteá archivo por archivo." ;;
  add)
    for a in "${resto[@]}"; do
      [[ "$a" == -- ]] && continue
      [[ "$a" == . || "$a" == --all || "$a" == --update || "$a" =~ ^-[^-]*[Au] ]] \
        && no "nada de 'git add -A/-u' ni 'git add .' en un worker: te llevás cambios de otra sesión. Agregá los archivos que tocaste, uno por uno."
    done ;;
  commit)
    salta=0
    for a in "${resto[@]}"; do
      (( salta )) && { salta=0; continue; }
      case "$a" in
        --) break ;;
        -m|-F|-C|-c|--author|--date|--fixup|--squash|-t|--template) salta=1 ;;
        --all) no "$SIN_A" ;;
        --*) ;;
        -*) [[ "${a%%[mFCct]*}" == *a* ]] && no "$SIN_A"
            [[ "$a" =~ [mFCct]$ ]] && salta=1 ;;
      esac
    done ;;
esac
exec "$real" "$@"

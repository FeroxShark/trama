#!/usr/bin/env python3
"""tablero — el único lugar de pendientes, esperas, ideas y hecho del dueño.

Un item JSON por línea en $TABLERO_DIR/items.jsonl (default ~/tablero, repo git propio). Sin
daemon, sin MCP, sin SQLite: lo escriben a la vez `pa`, Shark y el jefe, así que toda escritura
va con flock sobre .lock + archivo temporal + rename atómico, y los que leen no toman el lock
(ven el archivo de antes o el de después, nunca uno a medias).

Las vistas (ficha, proyectos, hoy, resumen) se generan en el momento desde git + el estado de
`pa` + el tablero: no son archivos, así que no se desactualizan ni chocan en un rebase.

"""
import argparse
import contextlib
import fcntl
import functools
import glob
import json
import os
import re
import subprocess
import sys
import time
from datetime import date, datetime, timedelta

COLUMNAS = ["bandeja", "sigue", "en-curso", "espera-dueno", "espera-externo", "ideas", "hecho", "tirado"]
CERRADAS = ("hecho", "tirado")
AREAS = ("sistema", "casa", "personal", "producto")
# `estado` del registry -> etapa. Sin dato o con un valor que no está acá: "?".
ETAPAS = {
    "activo": "activo", "a-suplantar": "activo",
    "pausado": "pausado", "pausa": "pausado",
    "idea": "idea", "en preparacion": "idea", "en preparación": "idea",
    "infra": "infra", "retirado": "retirado",
}

# vista.json: sube cuando un campo cambia de significado o se va; sumar un campo no la toca.
VISTA_VERSION = 1
VISTA_HECHO_MAX = 50  # cerrados recientes que lleva la vista (Trama no los pide en cada refresco)
TITULO_MAX = 120      # tope del título de una integrada sacado del RESULTADO
TIPOS = ("pregunta", "prueba")
LETRAS = "abcdefghijklmnopqrstuvwxyz"  # ids de las opciones, en orden

HOME = os.path.expanduser("~")


@functools.lru_cache(maxsize=None)
def nombre_dueno():
    """Nombre del dueño: TRAMA_DUENO -> `dueno` de perfil.json -> $USER con mayúscula inicial -> "el usuario"."""
    n = (os.environ.get("TRAMA_DUENO") or "").strip()
    if not n:
        perfil = os.environ.get("TRAMA_PERFIL") or os.path.join(
            os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "trama", "perfil.json")
        try:
            with open(perfil, encoding="utf-8") as f:
                n = str(json.load(f).get("dueno") or "").strip()
        except (OSError, ValueError, AttributeError):
            n = ""
    if not n:
        u = (os.environ.get("USER") or "").strip()
        n = u[:1].upper() + u[1:]
    return n or "el usuario"


def D(texto):
    """Texto con {D} = nombre del dueño; "a el usuario" y "de el usuario" quedan como "al" y "del"."""
    return texto.replace("{D}", nombre_dueno()).replace(" a el usuario", " al usuario").replace(" de el usuario", " del usuario")


@functools.lru_cache(maxsize=None)
def columnas_legadas():
    """Nombres viejos de la columna del dueño (`espera-<su nombre>`): se leen como espera-dueno."""
    return {"espera-" + n.lower() for n in (nombre_dueno(), os.environ.get("USER") or "") if n} - {"espera-el usuario"}


def col_canon(c):
    return "espera-dueno" if c in columnas_legadas() else c


def col_arg(s):
    return col_canon(s.strip())


_dir_env = os.environ.get("TABLERO_DIR")
DIR = _dir_env or os.path.join(HOME, "tablero")
ITEMS = os.path.join(DIR, "items.jsonl")
SEQ = os.path.join(DIR, "seq")
ARCHIVO = os.path.join(DIR, "hecho")
# Con TABLERO_DIR seteado (tests) y sin TABLERO_VISTA, la vista cae adentro de ese directorio:
# un test que se olvida de TABLERO_VISTA no pisa la vista real que leen Shark y Trama.
VISTA = os.environ.get("TABLERO_VISTA") or (
    os.path.join(DIR, "vista.json") if _dir_env else os.path.join(HOME, ".local/state/tablero/vista.json"))
PA_STATE = os.environ.get("PA_STATE") or os.path.join(HOME, ".local/state/pa")
REGISTRY = os.environ.get("PROYECTOS_REGISTRY") or os.path.join(HOME, ".config/proyectos/registry.json")


def aviso(msg):
    print(f"tablero: {msg}", file=sys.stderr)


def morir(msg, rc=1):
    aviso(msg)
    sys.exit(rc)


# ---- fechas ----

def ahora():
    return datetime.now().astimezone().isoformat(timespec="seconds")


def hoy_str():
    return date.today().isoformat()


def edad(iso):
    try:
        s = time.time() - datetime.fromisoformat(iso).timestamp()
    except (TypeError, ValueError):
        return "?"
    return edad_seg(s)


def edad_seg(s):
    s = max(0, int(s))
    if s < 3600:
        return f"{s // 60}m"
    if s < 48 * 3600:
        return f"{s // 3600}h"
    return f"{s // 86400}d"


def fecha_arg(txt):
    """AAAA-MM-DD, hoy, mañana, +3d, +2s (semanas). `ya` la borra (devuelve None)."""
    t = txt.strip().lower()
    if t in ("", "ya", "nunca", "-"):
        return None
    if t == "hoy":
        return hoy_str()
    if t in ("mañana", "manana"):
        return (date.today() + timedelta(days=1)).isoformat()
    if len(t) > 2 and t[0] == "+" and t[-1] in "ds" and t[1:-1].isdigit():
        return (date.today() + timedelta(days=int(t[1:-1]) * (7 if t[-1] == "s" else 1))).isoformat()
    try:
        return date.fromisoformat(t).isoformat()
    except ValueError:
        morir(f"fecha inválida: '{txt}' (AAAA-MM-DD, hoy, mañana, +3d, +2s)", 2)


def recorte(txt, n):
    t = " ".join((txt or "").split())
    return t if len(t) <= n else t[: n - 1].rstrip() + "…"


def recorte_palabra(txt, n):
    """Como recorte, pero corta en un espacio: nunca deja una palabra por la mitad."""
    t = " ".join((txt or "").split())
    if len(t) <= n:
        return t
    c = t[:n]
    if t[n] != " " and " " in c:
        c = c[: c.rindex(" ")]
    return c.rstrip(" ,;:") + "…"


def leer_texto(ruta, que):
    """El texto de --detalle-archivo / --prueba-archivo / --sumar-archivo (`-` = stdin). Sirve
    para un texto que no puede viajar por argumento: el destructive-guard bloquea el comando de
    Bash que nombra un borrado aunque sea adentro de un título."""
    try:
        if ruta == "-":
            return sys.stdin.read().strip("\n")
        with open(ruta, encoding="utf-8") as f:
            return f.read().strip("\n")
    except (OSError, UnicodeDecodeError) as e:
        morir(f"{que}: no pude leer {ruta}: {e}", 2)


def texto_o_archivo(a, campo):
    """--<campo> o --<campo>-archivo (uno solo de los dos); None si no vino ninguno."""
    directo, archivo = getattr(a, campo), getattr(a, campo + "_archivo")
    if directo is not None and archivo is not None:
        morir(f"{a.cmd}: --{campo} y --{campo}-archivo no van juntos", 2)
    return leer_texto(archivo, f"--{campo}-archivo") if archivo is not None else directo


# ---- registry (misma resolución que bin/proyecto-ruta, más el slug de pa) ----

class Registro:
    def __init__(self):
        self._proy = None
        self._rutas = {}

    @property
    def proyectos(self):
        if self._proy is None:
            try:
                with open(REGISTRY, encoding="utf-8") as f:
                    d = json.load(f)
                self._proy = [p for p in d.get("projects", []) if isinstance(p, dict) and p.get("name")]
            except (OSError, ValueError, AttributeError):
                self._proy = []
        return self._proy

    def ruta(self, p):
        """Ruta real canónica, como proyecto-ruta: ~ expandido, archivo -> su carpeta, readlink -f."""
        k = id(p)
        if k not in self._rutas:
            r = os.path.expanduser(str(p.get("path") or ""))
            if r and os.path.isfile(r):
                r = os.path.dirname(r)
            self._rutas[k] = os.path.realpath(r) if r else ""
        return self._rutas[k]

    def slug(self, p):
        """El slug de pa: basename de la ruta real en minúscula (carpeta de $PA_STATE y de pa/<slug>/*)."""
        return re.sub(r"[^A-Za-z0-9._-]", "-", os.path.basename(self.ruta(p))).lower()   # igual que slug_de de pa

    def _canon(self, p):
        # Varios nombres con la MISMA carpeta son alias ("mpvpaper-guard" y "mpvpaper-guard /
        # vram-guard"): el canónico es el primero, o un mismo proyecto quedaría con dos nombres.
        r = self.ruta(p)
        for q in self.proyectos:
            if self.ruta(q) == r:
                return q
        return p

    def resolver(self, nombre):
        """-> (nombre canónico, entrada del registry o None, aviso o None).

        Exacto, exacto sin mayúsculas, slug de pa (`.hilo` e `integradas.tsv` traen el slug),
        área libre, y recién ahí substring único. El área va ANTES del substring: `casa` no
        tiene que caer en un proyecto que se llame casa-algo.
        """
        q = (nombre or "").strip()
        if not q:
            return "", None, None
        ps = self.proyectos
        ql = q.lower()
        for cond in (lambda p: p["name"] == q, lambda p: p["name"].lower() == ql, lambda p: self.slug(p) == ql):
            for p in ps:
                if cond(p):
                    c = self._canon(p)
                    return c["name"], c, None
        if ql in AREAS:
            return ql, None, None
        cands = [p for p in ps if ql in p["name"].lower()]
        rutas = {self.ruta(p) for p in cands}
        if len(rutas) == 1:
            c = self._canon(cands[0])
            return c["name"], c, None
        if len(rutas) > 1:
            return q, None, f"proyecto '{q}' es ambiguo ({', '.join(p['name'] for p in cands)}); lo anoto tal cual"
        return q, None, f"proyecto '{q}' no está en el registry ni es un área ({', '.join(AREAS)}); lo anoto igual"

    def canon(self, nombre):
        c, _, av = self.resolver(nombre)
        if av:
            aviso(av)
        return c


def etapa(ent):
    return ETAPAS.get(str(ent.get("estado") or "").strip().lower(), "?")


# ---- items: leer, escribir ----

def leer_jsonl(ruta, estricto=False):
    items = []
    try:
        f = open(ruta, encoding="utf-8")
    except FileNotFoundError:
        return items
    with f:
        for n, linea in enumerate(f, 1):
            linea = linea.strip()
            if not linea:
                continue
            try:
                it = json.loads(linea)
                if not isinstance(it, dict):
                    raise ValueError
                if isinstance(it.get("columna"), str):
                    it["columna"] = col_canon(it["columna"])
            except ValueError:
                # Reescribir sin esa línea la perdería para siempre: el que escribe se niega.
                if estricto:
                    morir(f"{ruta}:{n}: línea que no es un item JSON; no escribo para no perderla")
                aviso(f"{ruta}:{n}: línea que no es un item JSON, la salteo")
                continue
            items.append(it)
    return items


def leer_items(estricto=False):
    return leer_jsonl(ITEMS, estricto)


def escribir_atomico(ruta, texto, fsync=True):
    tmp = f"{ruta}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(texto)
            if fsync:
                f.flush()
                os.fsync(f.fileno())
        os.replace(tmp, ruta)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def preparar_repo():
    """Primera escritura: ~/tablero es un repo git propio. Se llama con el lock tomado."""
    if os.path.isdir(os.path.join(DIR, ".git")):
        return
    gi = os.path.join(DIR, ".gitignore")
    if not os.path.exists(gi):
        escribir_atomico(gi, ".lock\n*.tmp\nvista.json\n", fsync=False)
    with contextlib.suppress(OSError, subprocess.SubprocessError):
        subprocess.run(["git", "init", "-q", DIR], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)


class Tx:
    def __init__(self, items):
        self.items = items
        self.cambio = False


@contextlib.contextmanager
def escritura():
    """Lock exclusivo, items leídos adentro del lock y, si hubo cambio, items + vista reescritos."""
    os.makedirs(ARCHIVO, exist_ok=True)
    with open(os.path.join(DIR, ".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        preparar_repo()
        tx = Tx(leer_items(estricto=True))
        yield tx
        if tx.cambio:
            escribir_atomico(ITEMS, "".join(json.dumps(it, ensure_ascii=False) + "\n" for it in tx.items))
            escribir_vista(tx.items)


def nuevo_id(items):
    """Número incremental que no se reusa: `seq` sobrevive a que `archivar` saque los ids altos."""
    n = 0
    try:
        with open(SEQ) as f:
            n = int(f.read().strip() or 0)
    except FileNotFoundError:
        # sin seq (borrado a mano): que tampoco se reuse un id que ya está archivado
        for it in leer_archivo():
            if isinstance(it.get("id"), int):
                n = max(n, it["id"])
    except (OSError, ValueError):
        pass
    n = max([n] + [it["id"] for it in items if isinstance(it.get("id"), int)]) + 1
    escribir_atomico(SEQ, f"{n}\n")
    return n


def leer_archivo(mes=None):
    try:
        nombres = sorted(x for x in os.listdir(ARCHIVO) if x.endswith(".jsonl"))
    except OSError:
        return []
    items = []
    for x in nombres:
        if mes is None or x == f"{mes}.jsonl":
            items += leer_jsonl(os.path.join(ARCHIVO, x))
    return items


def abierto(it):
    return it.get("columna") not in CERRADAS


def pospuesto(it, hoy=None):
    h = it.get("hasta")
    return bool(h) and str(h) > (hoy or hoy_str())


def visible(it, hoy=None):
    return abierto(it) and not pospuesto(it, hoy)


def poner_columna(it, col, ts):
    it["columna"] = col
    if col in CERRADAS:
        it["cerrado"] = it.get("cerrado") or ts
    else:
        it["cerrado"] = None


def buscar(items, i):
    for it in items:
        if it.get("id") == i:
            return it
    morir(f"no hay item {i}")


def por_clave(items, clave):
    """El item de esa clave: el abierto si hay; si no, el último cerrado (para reabrirlo)."""
    hallado = None
    for it in items:
        if it.get("clave") == clave:
            if abierto(it):
                return it
            hallado = it
    return hallado


def linea(it):
    return "  ".join([
        str(it.get("id")), str(it.get("columna")), it.get("proyecto") or "-",
        it.get("titulo") or "", f"({edad(it.get('creado'))})"])


def orden_columna(it):
    c = it.get("columna")
    return (COLUMNAS.index(c) if c in COLUMNAS else len(COLUMNAS), it.get("id") or 0)


def sigue_de(items):
    """proyecto -> su item `sigue` (el de clave sigue:<proyecto>, uno solo por proyecto)."""
    return {it.get("proyecto"): it for it in items
            if abierto(it) and str(it.get("clave") or "").startswith("sigue:")}


def salida_json(d):
    print(json.dumps(d, ensure_ascii=False, indent=1))


# ---- pregunta o prueba: tipo, opciones, respuesta ----

def tipo_de(it):
    """`tipo` del item; si no lo trae (item viejo): `prueba` cuando tiene `prueba`, si no `pregunta`."""
    t = it.get("tipo")
    return t if t in TIPOS else ("prueba" if it.get("prueba") else "pregunta")


def publico(it):
    """El item como sale en JSON (--json y vista.json): con `tipo` siempre. Al archivo no se escribe."""
    return dict(it, tipo=tipo_de(it))


def armar_opciones(textos, cmd):
    if len(textos) > len(LETRAS):
        morir(f"{cmd}: demasiadas opciones ({len(textos)}; hasta {len(LETRAS)})", 2)
    ops = [{"id": LETRAS[i], "texto": " ".join(t.split())} for i, t in enumerate(textos)]
    if any(not o["texto"] for o in ops):
        morir(f"{cmd}: una --opcion está vacía", 2)
    return ops


def id_opcion(opciones, txt):
    """El id de una opción a partir de su id (`b`) o de su número de orden (`2`); None si no existe."""
    t = str(txt).strip().lower()
    ids = [o.get("id") for o in opciones or [] if isinstance(o, dict)]
    if t.isdigit():
        return ids[int(t) - 1] if 1 <= int(t) <= len(ids) else None
    return t if t in ids else None


def una_linea(txt):
    return " ".join(txt.split())


def poner_pregunta(it, a):
    """--tipo, --simple, --contexto, --opcion y --defecto sobre un item. Sólo toca lo que vino;
    valida antes de cambiar nada (un `morir` acá adentro deja el archivo como estaba)."""
    opciones = armar_opciones(a.opcion, a.cmd) if a.opcion else None
    if getattr(a, "sin_opciones", False):
        if opciones or a.defecto is not None:
            morir(f"{a.cmd}: --sin-opciones no va con --opcion ni con --defecto", 2)
        opciones = []
    defecto = None
    if a.defecto is not None:
        finales = it.get("opciones") if opciones is None else opciones
        defecto = id_opcion(finales, a.defecto)
        if defecto is None:
            hay = ", ".join(o["id"] for o in finales or []) or "ninguna"
            morir(f"{a.cmd}: --defecto '{a.defecto}' no es una de las opciones ({hay})", 2)
    if a.tipo is not None:
        it["tipo"] = a.tipo
    for k, v in (("titulo_simple", a.simple), ("contexto", a.contexto)):
        if v is None:
            continue
        v = una_linea(v) if k == "titulo_simple" else v.strip()
        if v:
            it[k] = v
        else:
            it.pop(k, None)
    if opciones is not None:
        # Reemplazo entero: los ids se reparten de nuevo, así que el por_defecto de antes ya no
        # apunta a lo mismo y se va (salvo que venga --defecto).
        it.pop("por_defecto", None)
        if opciones:
            it["opciones"] = opciones
        else:
            it.pop("opciones", None)
    if defecto is not None:
        it["por_defecto"] = defecto


def flags_pregunta(p):
    p.add_argument("--tipo", choices=TIPOS, help="si falta: prueba cuando el item tiene `prueba`, si no pregunta")
    p.add_argument("--simple", metavar="T", help="el título en una línea, con palabras simples, sin ids ni jerga")
    p.add_argument("--contexto", metavar="T", help="una o dos líneas de contexto")
    p.add_argument("--opcion", action="append", metavar="T", help="una opción de respuesta; repetible (ids a, b, c… en orden)")
    p.add_argument("--defecto", metavar="ID|N", help="la opción por defecto: su id o su número de orden")


def texto_respuesta(r):
    if not isinstance(r, dict):
        return str(r)
    p = []
    if "anda" in r:
        p.append("anda" if r["anda"] else "no anda")
    if r.get("opcion"):
        p.append(f"{r['opcion']}) {r.get('opcion_texto') or ''}".rstrip())
    if r.get("texto"):
        p.append(r["texto"])
    return " · ".join(p) + (f"  ({r['fecha']})" if r.get("fecha") else "")


# ---- git y estado de pa (sólo lectura) ----

def _git_env():
    # GIT_OPTIONAL_LOCKS=0: `git status` no refresca el índice ni deja index.lock en un repo
    # donde puede haber un worker commiteando.
    return dict(os.environ, GIT_OPTIONAL_LOCKS="0")


def git_varios(pedidos):
    """pedidos: {clave: (ruta, [args])}. Lanza todos juntos; -> {clave: stdout o None si falló}."""
    env = _git_env()
    procs = {}
    for k, (ruta, args) in pedidos.items():
        try:
            procs[k] = subprocess.Popen(
                ["git", "-C", ruta] + args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                encoding="utf-8", errors="replace", env=env)
        except OSError:
            procs[k] = None
    out = {}
    for k, p in procs.items():
        if p is None:
            out[k] = None
            continue
        try:
            o, _ = p.communicate(timeout=15)
        except subprocess.TimeoutExpired:
            p.kill()
            p.communicate()
            o = None
        out[k] = o if p.returncode == 0 else None
    return out


def git_muchos(pedidos):
    """Como git_varios pero de a tandas: para recorrer los 64 repos sin lanzar 64 git juntos."""
    out = {}
    claves = list(pedidos)
    for i in range(0, len(claves), 16):
        out.update(git_varios({k: pedidos[k] for k in claves[i:i + 16]}))
    return out


def leer_hilo(ruta):
    d = {}
    try:
        with open(ruta, encoding="utf-8", errors="replace") as f:
            for l in f:
                k, sep, v = l.rstrip("\n").partition("=")
                if sep:
                    d[k] = v
    except OSError:
        pass
    return d


def leer_integradas():
    """id -> última fila de integradas.tsv (la última fila de un id manda)."""
    ult = {}
    try:
        with open(os.path.join(PA_STATE, "integradas.tsv"), encoding="utf-8", errors="replace") as f:
            for l in f:
                c = l.rstrip("\n").split("\t")
                if len(c) >= 10 and c[0] != "fecha":
                    ult[c[1]] = c
    except OSError:
        pass
    return ult


def pid_vivo(ruta_pid):
    try:
        with open(ruta_pid) as f:
            return os.path.isdir(f"/proc/{int(f.read().strip())}")
    except (OSError, ValueError):
        return False


def corrida_viva(slug, cid):
    """La corrida `cid` de `slug` sigue viva: su `<id>.pid` (sólo --async lo escribe) o, para las de primer plano, un
    `<slug>[@puesto|.leer-<id>].running` con ese id y un pid vivo (el del worker; mientras arranca, el de pa)."""
    if pid_vivo(os.path.join(PA_STATE, slug, cid + ".pid")):
        return True
    pat = os.path.join(PA_STATE, glob.escape(slug))
    for f in glob.glob(pat + ".running") + glob.glob(pat + "@*.running") + glob.glob(pat + ".leer-*.running"):
        campos = {}
        try:
            with open(f, errors="replace") as fh:
                for l in fh:
                    k, _, v = l.rstrip("\n").partition("=")
                    campos.setdefault(k, v)
        except OSError:
            continue
        if campos.get("id") != cid:
            continue
        try:
            if os.path.isdir(f"/proc/{int(campos.get('pid') or campos.get('pa_pid') or '')}"):
                return True
        except ValueError:
            pass
    return False


_ENCABEZADO = re.compile(r"^[*#> \t-]*(RESULTADO|ARCHIVOS|DECISI[OÓ]N|SIGUE)[*]*:[*]*[ \t]*", re.M)
_OTRO_CAMPO = re.compile(r"\b(ARCHIVOS|DECISI[OÓ]N|SIGUE)[*]*:")
# fin de oración: punto, ! o ? seguido de un espacio y de algo que arranca otra oración
# (un "p. ej." o un `bin/pa.` seguido de minúscula no corta)
_FIN_ORACION = re.compile(r"[.!?…](?=\s+[A-ZÁÉÍÓÚÑ¿¡`\"«(\d]|\s*$)")


def primera_oracion_resultado(ruta_json):
    """Primera oración del RESULTADO de una corrida (`.result` de su JSON), o "" si no hay."""
    try:
        if os.path.getsize(ruta_json) > 8 << 20:
            return ""
        with open(ruta_json, encoding="utf-8", errors="replace") as f:
            res = json.load(f).get("result")
    except (OSError, ValueError, AttributeError):
        return ""
    if not isinstance(res, str):
        return ""
    ini = None
    for m in _ENCABEZADO.finditer(res):
        if m.group(1) == "RESULTADO":
            ini = m.end()   # el último manda, como en `campo_de` de pa
    if ini is None:
        return ""
    t = res[ini:]
    m = _ENCABEZADO.search(t)
    if m:
        t = t[: m.start()]
    m = _OTRO_CAMPO.search(t)   # todo en una línea: "RESULTADO: listo. ARCHIVOS: ninguno."
    if m:
        t = t[: m.start()]
    t = " ".join(t.replace("**", "").split())
    m = _FIN_ORACION.search(t)
    if m:
        t = t[: m.end()]
    return recorte_palabra(t, TITULO_MAX)


def titulo_integrada(slug, cid, fecha_iso):
    """Qué se integró, en una oración: el RESULTADO de la última corrida de esa rama (la dueña o
    un `--seguir`, que lleva `origen=<id>`) anterior a la integración. "" si ninguna lo tiene."""
    d = os.path.join(PA_STATE, slug)
    try:
        tope = datetime.fromisoformat(fecha_iso).strftime("%Y%m%d-%H%M%S")
    except ValueError:
        tope = "9"
    ids = [cid]
    try:
        # los ids ordenan por fecha: sólo hace falta abrir los .hilo de después de la dueña
        for x in sorted(os.listdir(d)):
            if x.endswith(".hilo") and cid < x[:-5] and x[:15] <= tope \
                    and leer_hilo(os.path.join(d, x)).get("origen") == cid:
                ids.append(x[:-5])
    except OSError:
        pass
    for i in reversed(ids):
        t = primera_oracion_resultado(os.path.join(d, i + ".json"))
        if t:
            return t
    return ""


def corridas(slug, n=3):
    """Últimas n corridas de pa del proyecto: fecha, tarea y en qué terminó."""
    d = os.path.join(PA_STATE, slug)
    try:
        nombres = sorted((x for x in os.listdir(d) if x.endswith(".hilo")), reverse=True)[:n]
    except OSError:
        return []
    integ = leer_integradas() if nombres else {}
    out = []
    for x in nombres:
        cid = x[:-5]
        h = leer_hilo(os.path.join(d, x))
        fila = integ.get(cid)
        if fila:
            res = fila[9]
        elif "decision_nada" not in h:
            res = "en curso" if corrida_viva(slug, cid) else "sin resultado"
        elif h.get("decision_nada") == "0":
            res = "espera decisión" + (f": {recorte(h['decision'], 80)}" if h.get("decision") else "")
        elif h.get("leer") == "1":
            res = "consulta"
        else:
            res = "sin integrar" if h.get("rama") else "ok"
        f = f"{cid[:4]}-{cid[4:6]}-{cid[6:8]}" if cid[:8].isdigit() else "?"
        out.append({"id": cid, "fecha": f, "tarea": recorte(h.get("tarea", ""), 70), "resultado": res})
    return out


def ramas_pa_en_disco(ruta):
    """Ramas pa/* de un repo leyendo sus refs del disco, sin lanzar git (resumen corre en cada
    arranque de sesión y no puede pagar un git por cada proyecto del registry)."""
    g = os.path.join(ruta, ".git")
    if os.path.isfile(g):  # worktree o submódulo: `gitdir: <ruta>` y, adentro, `commondir`
        try:
            with open(g) as f:
                g = os.path.normpath(os.path.join(ruta, f.read().split("gitdir:", 1)[1].strip()))
            with contextlib.suppress(OSError), open(os.path.join(g, "commondir")) as f:
                g = os.path.normpath(os.path.join(g, f.read().strip()))
        except (OSError, IndexError):
            return []
    elif not os.path.isdir(g):
        return []
    heads = os.path.join(g, "refs", "heads")
    nombres = set()
    for dp, _, fs in os.walk(os.path.join(heads, "pa")):
        for x in fs:
            if not x.endswith(".lock"):
                nombres.add(os.path.relpath(os.path.join(dp, x), heads))
    pk = os.path.join(g, "packed-refs")
    try:
        if os.path.getsize(pk) < 4 << 20:
            with open(pk, encoding="utf-8", errors="replace") as f:
                for l in f:
                    if " refs/heads/pa/" in l:
                        nombres.add(l.split(" ", 1)[1].strip()[len("refs/heads/"):])
    except OSError:
        pass
    return sorted(nombres)


def rama_en_curso(rama):
    """pa/<slug>/<id> con su worker vivo: todavía no es una rama que espere integración."""
    p = rama.split("/")
    return len(p) == 3 and corrida_viva(p[1], p[2])


def ramas_sin_integrar(reg):
    """Ramas pa/* sin mergear de todos los proyectos. Git sólo en los repos que tienen alguna."""
    pedidos = {}
    for p in reg.proyectos:
        r = reg.ruta(p)
        if r and r not in pedidos and ramas_pa_en_disco(r):
            pedidos[r] = (r, ["branch", "--no-merged", "HEAD", "--list", "pa/*", "--format=%(refname:short)"])
    ramas = []
    for o in git_varios(pedidos).values():
        ramas += [x for x in (o or "").split() if not rama_en_curso(x)]
    return sorted(ramas)


# ---- vista.json ----

def filas_retirados(reg, items, sg, hoy):
    """Los proyectos retirados del registry, sin git: nombre, descripción, abiertos y su sigue."""
    abiertos = {}
    for it in items:
        if visible(it, hoy):
            abiertos[it.get("proyecto") or ""] = abiertos.get(it.get("proyecto") or "", 0) + 1
    filas, rutas = [], set()
    for p in reg.proyectos:
        r = reg.ruta(p)
        if etapa(p) != "retirado" or r in rutas:
            continue
        rutas.add(r)
        n = p["name"]
        filas.append({"proyecto": n, "etapa": "retirado", "dias": None, "abiertos": abiertos.get(n, 0),
                      "sigue": (sg.get(n) or {}).get("titulo"), "desc": p.get("desc") or ""})
    return filas


def datos_hoy(reg, items, fecha, con_commits=True):
    integradas = []
    for cid, c in leer_integradas().items():
        if c[9] == "integrada" and c[0][:10] == fecha:
            h = leer_hilo(os.path.join(PA_STATE, c[2], cid + ".hilo"))
            integradas.append({
                "id": cid, "proyecto": c[2], "hora": c[0][11:16],
                "titulo": titulo_integrada(c[2], cid, c[0]) or recorte(h.get("tarea", ""), 80),
                "commits": int(c[7]) if c[7].isdigit() else 0})
    integradas.sort(key=lambda x: (x["hora"], x["id"]))
    vistos = set()
    cerrados = []
    for it in items + (leer_archivo(fecha[:7]) if con_commits else []):
        if str(it.get("cerrado") or "")[:10] == fecha and it.get("id") not in vistos:
            vistos.add(it.get("id"))
            cerrados.append(it)
    d = {"fecha": fecha, "integradas": integradas, "cerrados": [publico(it) for it in cerrados]}
    if con_commits:
        pedidos = {}
        rutas = set()
        for p in reg.proyectos:
            r = reg.ruta(p)
            if r and r not in rutas and os.path.isdir(r):
                rutas.add(r)
                # `-- .`: un proyecto que es una subcarpeta de un repo cuenta sólo lo suyo
                pedidos[p["name"]] = (r, ["rev-list", "--count", f"--since={fecha} 00:00:00",
                                          f"--until={fecha} 23:59:59", "HEAD", "--", "."])
        d["commits"] = {k: int(v) for k, v in git_muchos(pedidos).items() if v and v.strip().isdigit() and int(v) > 0}
    return d


def escribir_vista(items):
    """Lo que leen el QML de Shark y Trama. Se regenera en cada escritura, con el lock tomado.
    `hoy` va sin commits por proyecto: eso es un git por repo y acá se paga en cada escritura."""
    hoy = hoy_str()
    columnas = {c: [] for c in COLUMNAS if c not in CERRADAS}
    pospuestos = []
    for it in sorted(items, key=orden_columna):
        if not abierto(it):
            continue
        if pospuesto(it, hoy):
            pospuestos.append(publico(it))
        elif it.get("columna") in columnas:
            columnas[it["columna"]].append(publico(it))
    h = datos_hoy(None, items, hoy, con_commits=False)
    cont = {c: len(v) for c, v in columnas.items()}
    cont.update(abiertos=sum(len(v) for v in columnas.values()), pospuestos=len(pospuestos),
                cerrados_hoy=len(h["cerrados"]), integradas_hoy=len(h["integradas"]))
    hecho = sorted((it for it in items if it.get("columna") == "hecho"),
                   key=lambda it: (str(it.get("cerrado") or ""), it.get("id") or 0), reverse=True)
    sg = sigue_de(items)
    retirados = [{"proyecto": f["proyecto"], "desc": f["desc"], "abiertos": f["abiertos"], "sigue": f["sigue"]}
                 for f in filas_retirados(Registro(), items, sg, hoy)]
    v = {
        "version": VISTA_VERSION,
        "generado": ahora(),
        "contadores": cont,
        "columnas": columnas,
        "sigue": {p: {"id": it.get("id"), "titulo": it.get("titulo"), "head": it.get("head"), "tocado": it.get("tocado")}
                  for p, it in sg.items()},
        "hoy": h,
        # lo de acá abajo se sumó después (version 1): no está en `columnas` ni en `contadores`
        "pospuestos": sorted(pospuestos, key=lambda it: (str(it.get("hasta")), it.get("id") or 0)),
        "hecho": [publico(it) for it in hecho[:VISTA_HECHO_MAX]],
        "retirados": retirados,
    }
    try:
        os.makedirs(os.path.dirname(VISTA), exist_ok=True)
        escribir_atomico(VISTA, json.dumps(v, ensure_ascii=False), fsync=False)
    except OSError as e:
        aviso(f"no pude escribir la vista {VISTA}: {e}")


# ---- comandos que escriben ----

def cmd_init(a):
    with escritura() as tx:
        tx.cambio = True
    print(DIR)


def cmd_agregar(a):
    titulo = a.titulo.strip()
    if not titulo:
        morir("agregar: el título está vacío", 2)
    proy = Registro().canon(a.proyecto) if a.proyecto is not None else None
    hasta = fecha_arg(a.hasta) if a.hasta is not None else None
    a.detalle, a.prueba = texto_o_archivo(a, "detalle"), texto_o_archivo(a, "prueba")
    with escritura() as tx:
        ts = ahora()
        it = por_clave(tx.items, a.clave) if a.clave else None
        if it is None:
            poner_pregunta({}, a)  # valida antes de gastar un id
            it = {
                "id": nuevo_id(tx.items), "columna": None, "proyecto": proy or "", "titulo": titulo,
                "detalle": a.detalle or "", "prueba": a.prueba or "", "origen": a.origen or "",
                "clave": a.clave or "", "head": None, "creado": ts, "tocado": ts, "cerrado": None, "hasta": hasta}
            poner_columna(it, a.columna or "bandeja", ts)
            poner_pregunta(it, a)
            tx.items.append(it)
        else:
            poner_pregunta(it, a)
            # Clave que ya está: se actualiza, no se duplica. Si estaba cerrada vuelve a abrirse
            # (un FAIL del doctor que reaparece) y la edad arranca de nuevo.
            if not abierto(it):
                it["cerrado"] = None
                it["creado"] = ts
                poner_columna(it, a.columna or "bandeja", ts)
            elif a.columna:
                poner_columna(it, a.columna, ts)
            it["titulo"] = titulo
            for k in ("detalle", "prueba", "origen"):
                if getattr(a, k) is not None:
                    it[k] = getattr(a, k)
            if proy is not None:
                it["proyecto"] = proy
            if a.hasta is not None:
                it["hasta"] = hasta
            it["tocado"] = ts
        tx.cambio = True
    print(it["id"])


def cmd_mover(a):
    if a.columna is None and a.proyecto is None and a.hasta is None:
        morir("mover: pasá --columna, --proyecto o --hasta", 2)
    proy = Registro().canon(a.proyecto) if a.proyecto is not None else None
    hasta = fecha_arg(a.hasta) if a.hasta is not None else None
    with escritura() as tx:
        it = buscar(tx.items, a.id)
        ts = ahora()
        if a.columna:
            poner_columna(it, a.columna, ts)
        if proy is not None:
            it["proyecto"] = proy
        if a.hasta is not None:
            it["hasta"] = hasta
        it["tocado"] = ts
        tx.cambio = True
    print(linea(it))


def cmd_posponer(a):
    hasta = fecha_arg(a.fecha)
    with escritura() as tx:
        objetivos = [buscar(tx.items, i) for i in a.ids]
        ts = ahora()
        for it in objetivos:
            if not abierto(it):
                morir(f"posponer: el item {it.get('id')} está cerrado ({it.get('columna')})")
            it["hasta"] = hasta
            it["tocado"] = ts
            tx.cambio = True
    hoy = hoy_str()
    for it in objetivos:
        print(linea(it) + (f"  hasta {it['hasta']}" if pospuesto(it, hoy) else ""))


def cmd_editar(a):
    a.detalle, a.prueba, a.sumar = texto_o_archivo(a, "detalle"), texto_o_archivo(a, "prueba"), texto_o_archivo(a, "sumar")
    if all(x is None for x in (a.titulo, a.detalle, a.prueba, a.sumar, a.tipo, a.simple, a.contexto, a.opcion, a.defecto)) \
            and not a.sin_opciones:
        morir("editar: pasá --titulo, --detalle, --prueba, --sumar (o su -archivo), --tipo, --simple, --contexto, "
              "--opcion, --defecto o --sin-opciones", 2)
    if a.titulo is not None and not a.titulo.strip():
        morir("editar: el título está vacío", 2)
    if a.sumar is not None and not a.sumar.strip():
        morir("editar: --sumar está vacío", 2)
    with escritura() as tx:
        it = buscar(tx.items, a.id)
        poner_pregunta(it, a)
        for k in ("titulo", "detalle", "prueba"):
            if getattr(a, k) is not None:
                it[k] = getattr(a, k).strip() if k == "titulo" else getattr(a, k)
        if a.sumar is not None:
            # al final de lo que haya (también de un --detalle de esta misma llamada)
            it["detalle"] = (it["detalle"].rstrip("\n") + "\n" if it.get("detalle") else "") + a.sumar
        it["tocado"] = ahora()
        tx.cambio = True
    print(linea(it))


def cmd_responder(a):
    """La respuesta del dueño queda en el item; no lo cierra ni lo mueve (eso lo hace el que la lee)."""
    if a.texto is not None:   # `responder 42 "la opción 2"`: el texto suelto es --respuesta
        if a.respuesta is not None:
            morir("responder: el texto va suelto o con --respuesta, no los dos", 2)
        a.respuesta = a.texto
    prueba = a.anda is not None
    if a.borrar:
        if prueba or a.respuesta is not None or a.opcion is not None or a.nota is not None:
            morir("responder: --borrar va solo", 2)
    elif prueba and (a.respuesta is not None or a.opcion is not None):
        morir("responder: --anda/--no-anda van con --nota, no con --respuesta ni --opcion", 2)
    elif not prueba and a.nota is not None:
        morir("responder: --nota va con --anda o --no-anda", 2)
    elif not prueba and a.respuesta is None and a.opcion is None:
        morir("responder: pasá --respuesta, --opcion, --anda o --no-anda", 2)
    with escritura() as tx:
        it = buscar(tx.items, a.id)
        if not abierto(it):
            morir(f"responder: el item {it.get('id')} está cerrado ({it.get('columna')})")
        ts = ahora()
        if a.borrar:
            if "respuesta" not in it:
                return print(linea(it))
            del it["respuesta"]
        elif prueba:
            if tipo_de(it) != "prueba":
                morir(f"responder: el item {it.get('id')} es una pregunta, no una prueba (--respuesta / --opcion)", 2)
            it["respuesta"] = {"anda": a.anda, "texto": (a.nota or "").strip(), "fecha": ts}
        else:
            r = {"texto": (a.respuesta or "").strip()}
            if a.opcion is not None:
                oid = id_opcion(it.get("opciones"), a.opcion)
                if oid is None:
                    hay = ", ".join(o["id"] for o in it.get("opciones") or []) or "ninguna"
                    morir(f"responder: --opcion '{a.opcion}' no es una de las opciones del item ({hay})", 2)
                # el texto viaja con el id: si después cambian las opciones, la respuesta se sigue entendiendo
                r["opcion"] = oid
                r["opcion_texto"] = next(o["texto"] for o in it["opciones"] if o.get("id") == oid)
            elif not r["texto"]:
                morir("responder: --respuesta está vacía", 2)
            r["fecha"] = ts
            it["respuesta"] = r
        it["tocado"] = ts
        tx.cambio = True
    print(linea(it) + (f"  respuesta: {texto_respuesta(it['respuesta'])}" if it.get("respuesta") else ""))


def _cerrar(a, columna):
    clave = getattr(a, "clave", None)
    nota = getattr(a, "nota", None)
    if not a.ids and not clave:
        morir(f"{a.cmd}: pasá un id" + (" o --clave" if columna == "hecho" else ""), 2)
    with escritura() as tx:
        objetivos = [buscar(tx.items, i) for i in a.ids]
        if clave:
            # Sin item abierto con esa clave no es un error: el doctor cierra en cada pasada buena.
            objetivos += [it for it in tx.items if it.get("clave") == clave and abierto(it)]
        ts = ahora()
        for it in objetivos:
            if it.get("columna") == columna:
                continue
            it["columna"] = columna
            it["cerrado"] = ts
            it["tocado"] = ts
            if nota:
                it["detalle"] = (it.get("detalle") + "\n" if it.get("detalle") else "") + f"cierre: {nota}"
            tx.cambio = True
            print(linea(it))


def cmd_cerrar(a):
    _cerrar(a, "hecho")


def cmd_tirar(a):
    _cerrar(a, "tirado")


def cmd_sigue(a):
    texto = a.texto.strip()
    if not texto:
        morir("sigue: el texto está vacío", 2)
    reg = Registro()
    proy, ent, av = reg.resolver(a.proyecto)
    if not proy:
        morir("sigue: el proyecto está vacío", 2)
    if av:
        aviso(av)
    head = a.head
    if not head and ent and os.path.isdir(reg.ruta(ent)):
        head = (git_varios({"h": (reg.ruta(ent), ["rev-parse", "HEAD"])})["h"] or "").strip() or None
    clave = f"sigue:{proy}"
    with escritura() as tx:
        ts = ahora()
        it = por_clave(tx.items, clave)
        if it is None:
            it = {
                "id": nuevo_id(tx.items), "columna": "sigue", "proyecto": proy, "titulo": texto, "detalle": "",
                "prueba": "", "origen": "sigue", "clave": clave, "head": head, "creado": ts, "tocado": ts,
                "cerrado": None, "hasta": None}
            tx.items.append(it)
        else:
            # Uno solo por proyecto: el paso nuevo reemplaza al anterior en el mismo item.
            if it.get("titulo") != texto or not abierto(it):
                it["creado"] = ts
            it.update(columna="sigue", proyecto=proy, titulo=texto, head=head, tocado=ts, cerrado=None, hasta=None)
        tx.cambio = True
    print(it["id"])


def cmd_archivar(a):
    corte = datetime.now().astimezone() - timedelta(days=a.dias)
    n = 0
    with escritura() as tx:
        quedan, por_mes = [], {}
        for it in tx.items:
            mes = None
            if not abierto(it):
                try:
                    cuando = datetime.fromisoformat(it.get("cerrado") or it.get("tocado") or "")
                    if cuando.tzinfo is None:
                        cuando = cuando.astimezone()
                    if cuando < corte:
                        mes = cuando.strftime("%Y-%m")
                except ValueError:
                    pass
            if mes:
                por_mes.setdefault(mes, []).append(it)
            else:
                quedan.append(it)
        # Primero al archivo y recién después fuera de items.jsonl: si se corta en el medio queda
        # un item repetido en el archivo, no uno perdido.
        for mes, its in por_mes.items():
            with open(os.path.join(ARCHIVO, f"{mes}.jsonl"), "a", encoding="utf-8") as f:
                f.write("".join(json.dumps(it, ensure_ascii=False) + "\n" for it in its))
                f.flush()
                os.fsync(f.fileno())
            n += len(its)
        if n:
            tx.items[:] = quedan
            tx.cambio = True
    print(f"archivados: {n}")


# ---- comandos que leen ----

def cmd_listar(a):
    items = leer_items()
    cols = None
    if a.columna:
        cols = [col_canon(c.strip()) for c in a.columna.split(",") if c.strip()]
        malas = [c for c in cols if c not in COLUMNAS]
        if malas:
            morir(f"columna desconocida: {', '.join(malas)} (hay: {', '.join(COLUMNAS)})", 2)
    proy = Registro().resolver(a.proyecto)[0] if a.proyecto else None
    hoy = hoy_str()
    sal = []
    for it in sorted(items, key=orden_columna):
        if proy is not None and it.get("proyecto") != proy:
            continue
        if a.pospuestos:
            # sólo los que están escondidos por su `hasta` (abiertos), para traerlos de vuelta
            if not (abierto(it) and pospuesto(it, hoy)) or (cols is not None and it.get("columna") not in cols):
                continue
        elif cols is not None:
            # una columna pedida por nombre se muestra aunque sea hecho/tirado; los pospuestos no
            if it.get("columna") not in cols or (pospuesto(it, hoy) and not a.todo):
                continue
        elif not a.todo and not visible(it, hoy):
            continue
        sal.append(it)
    if a.json:
        return salida_json([publico(it) for it in sal])
    for it in sal:
        print(linea(it) + (f"  hasta {it['hasta']}" if pospuesto(it, hoy) else ""))


def cmd_ver(a):
    it = next((x for x in leer_items() if x.get("id") == a.id), None)
    if it is None:
        it = next((x for x in leer_archivo() if x.get("id") == a.id), None)
    if it is None:
        morir(f"no hay item {a.id}")
    if a.json:
        return salida_json(publico(it))
    print(linea(it))
    print(f"tipo: {tipo_de(it)}")
    for k in ("titulo_simple", "contexto", "detalle", "prueba"):
        if it.get(k):
            print(f"{k}: {it[k]}")
    if it.get("opciones"):
        print("opciones:")
        for o in it["opciones"]:
            print(f"  {o.get('id')}) {o.get('texto')}" + ("  (por defecto)" if o.get("id") == it.get("por_defecto") else ""))
    if it.get("respuesta"):
        print(f"respuesta: {texto_respuesta(it['respuesta'])}")
    for k in ("origen", "clave", "head", "creado", "tocado", "cerrado", "hasta"):
        if it.get(k):
            print(f"{k}: {it[k]}")


def datos_ficha(reg, nombre):
    proy, ent, av = reg.resolver(nombre)
    if av:
        aviso(av)
    items = leer_items()
    hoy = hoy_str()
    mios = [it for it in items if it.get("proyecto") == proy and visible(it, hoy)]
    d = {"proyecto": proy, "desc": "", "etapa": None, "commit": None, "sucio": None, "ramas": [],
         "sigue": None, "espera_dueno": [publico(it) for it in mios if it.get("columna") == "espera-dueno"],
         "en_curso": [publico(it) for it in mios if it.get("columna") == "en-curso"], "corridas": []}
    sg = sigue_de(items).get(proy)
    if sg:
        d["sigue"] = {"id": sg.get("id"), "texto": sg.get("titulo"), "head": sg.get("head"), "viejo": None}
    if not ent:
        return d
    d["desc"] = ent.get("desc") or ""
    d["etapa"] = etapa(ent)
    ruta, slug = reg.ruta(ent), reg.slug(ent)
    d["corridas"] = corridas(slug)
    if not os.path.isdir(ruta):
        return d
    pedidos = {
        "commit": (ruta, ["log", "-1", "--format=%h%x09%cs%x09%ct%x09%s", "--", "."]),
        "sucio": (ruta, ["status", "--porcelain", "--", "."]),
        "ramas": (ruta, ["branch", "--no-merged", "HEAD", "--list", f"pa/{slug}/*", "--format=%(refname:short)"]),
    }
    if sg and sg.get("head"):
        pedidos["viejo"] = (ruta, ["rev-list", "--count", f"{sg['head']}..HEAD"])
    g = git_varios(pedidos)
    c = (g["commit"] or "").rstrip("\n").split("\t", 3)
    if len(c) == 4:  # sin esto no hay repo (o ningún commit toca la carpeta): se omite todo lo de git
        d["commit"] = {"hash": c[0], "fecha": c[1], "asunto": c[3],
                       "edad": edad_seg(time.time() - int(c[2])) if c[2].isdigit() else "?"}
        d["sucio"] = bool((g["sucio"] or "").strip())
        d["ramas"] = [{"rama": x, "en_curso": rama_en_curso(x)} for x in (g["ramas"] or "").split()]
        if "viejo" in pedidos:
            v = (g["viejo"] or "").strip()
            # None de git: ese HEAD ya no existe en el repo (rebase, reset): seguro que está viejo
            d["sigue"]["viejo"] = int(v) if v.isdigit() else -1
    return d


def _marca_viejo(sg):
    v = sg.get("viejo")
    if not v:
        return ""
    return f"puede estar viejo: {v} commits después" if v > 0 else "puede estar viejo: el HEAD de entonces ya no está"


def cmd_ficha(a):
    d = datos_ficha(Registro(), a.proyecto)
    if a.json:
        return salida_json(d)
    corta = a.corta
    L = []
    cab = d["proyecto"] + (f" [{d['etapa']}]" if d["etapa"] else " (no está en el registry)" if d["proyecto"] not in AREAS else " (área)")
    if d["desc"]:
        cab += " — " + recorte(d["desc"], 100 if corta else 200)
    L.append(cab)
    c = d["commit"]
    if c:
        L.append(f"commit: {c['hash']} {c['fecha']} {recorte(c['asunto'], 80)} ({c['edad']}) · árbol {'sucio' if d['sucio'] else 'limpio'}")
    if d["ramas"]:
        rs = [r["rama"] + (" (en curso)" if r["en_curso"] else "") for r in d["ramas"]]
        L.append(f"ramas sin integrar ({len(rs)}): " + ", ".join(rs[:6]) + (f" … +{len(rs) - 6}" if len(rs) > 6 else ""))
    sg = d["sigue"]
    if sg:
        marca = _marca_viejo(sg)
        L.append(f"sigue: {recorte(sg['texto'], 160 if corta else 400)}" + (f" ({marca})" if marca else ""))
    for clave, titulo in (("espera_dueno", "espera-dueno"), ("en_curso", "en-curso")):
        its = d[clave]
        if not its:
            continue
        if corta:
            L.append(f"{titulo} ({len(its)}): " + recorte("; ".join(f"#{it['id']} {it.get('titulo')}" for it in its), 200))
        else:
            L.append(f"{titulo}:")
            for it in its:
                L.append(f"  {it['id']}  {it.get('titulo')}" + (f" · probar: {it['prueba']}" if it.get("prueba") else "") + f"  ({edad(it.get('creado'))})")
    if d["corridas"]:
        if corta:
            L.append("corridas: " + "; ".join(f"{r['fecha'][5:]} {recorte(r['resultado'], 30)} «{recorte(r['tarea'], 40)}»" for r in d["corridas"]))
        else:
            L.append("corridas:")
            for r in d["corridas"]:
                L.append(f"  {r['fecha']}  {r['resultado']}  {r['tarea']}")
    print("\n".join(L[:8] if corta else L))


def cmd_proyectos(a):
    reg = Registro()
    items = leer_items()
    hoy = hoy_str()
    abiertos = {}
    for it in items:
        if visible(it, hoy):
            abiertos[it.get("proyecto") or ""] = abiertos.get(it.get("proyecto") or "", 0) + 1
    sg = sigue_de(items)
    filas, rutas, pedidos = [], set(), {}
    for p in reg.proyectos:
        et = etapa(p)
        r = reg.ruta(p)
        if (et == "retirado" and not a.retirados) or r in rutas:
            continue
        rutas.add(r)
        n = p["name"]
        filas.append({"proyecto": n, "etapa": et, "dias": None, "abiertos": abiertos.pop(n, 0),
                      "sigue": (sg.get(n) or {}).get("titulo")})
        if r and os.path.isdir(r):
            pedidos[n] = (r, ["log", "-1", "--format=%ct", "--", "."])
    t = time.time()
    for n, o in git_muchos(pedidos).items():
        if o and o.strip().isdigit():
            next(f for f in filas if f["proyecto"] == n)["dias"] = int((t - int(o)) // 86400)
    # los retirados (sólo con --retirados) van después de los vivos
    filas.sort(key=lambda f: (f["etapa"] == "retirado", f["dias"] is None, f["dias"] or 0, f["proyecto"].lower()))
    # áreas y nombres sueltos con algo abierto: no están en el registry pero también son trabajo
    for n in sorted(k for k in abiertos if k):
        filas.append({"proyecto": n, "etapa": "área" if n in AREAS else "?", "dias": None,
                      "abiertos": abiertos[n], "sigue": (sg.get(n) or {}).get("titulo")})
    if a.json:
        return salida_json(filas)
    for f in filas:
        print("  ".join([
            f["proyecto"], f["etapa"], "-" if f["dias"] is None else f"{f['dias']}d",
            f"abiertos:{f['abiertos']}"]) + (f"  sigue: {recorte(f['sigue'], 100)}" if f["sigue"] else ""))


def cmd_hoy(a):
    fecha = fecha_arg(a.fecha) if a.fecha else hoy_str()
    if not fecha:
        morir("hoy: --fecha vacía", 2)
    d = datos_hoy(Registro(), leer_items(), fecha)
    if a.json:
        return salida_json(d)
    if not (d["integradas"] or d["cerrados"] or d["commits"]):
        return print(f"hoy {fecha}: nada registrado")
    print(f"hoy {fecha}")
    if d["integradas"]:
        print(f"integradas ({len(d['integradas'])}):")
        for x in d["integradas"]:
            print(f"  {x['hora']}  {x['proyecto']}  {x['titulo'] or x['id']}  ({x['commits']} commits)")
    if d["cerrados"]:
        print(f"cerrados ({len(d['cerrados'])}):")
        for it in d["cerrados"]:
            print(f"  {it.get('id')}  {it.get('columna')}  {it.get('proyecto') or '-'}  {it.get('titulo')}")
    if d["commits"]:
        print("commits: " + ", ".join(f"{k} {v}" for k, v in sorted(d["commits"].items(), key=lambda kv: -kv[1])))


def informe_barrendero():
    """El informe de la última barrida nocturna (bin/barrendero), si es de hoy o ayer. -> dict o None."""
    ruta = os.path.join(os.environ.get("BARRENDERO_DIR") or os.path.join(HOME, ".local/state/barrendero"), "informe.json")
    try:
        with open(ruta, encoding="utf-8") as f:
            inf = json.load(f)
        edad_d = (datetime.now().date() - datetime.strptime(inf["fecha"], "%Y-%m-%d").date()).days
    except (OSError, ValueError, KeyError, TypeError):
        return None
    if edad_d > 1 or not isinstance(inf, dict):
        return None
    return inf


def linea_barrendero(inf):
    c, m, f = (len(inf.get(k) or []) for k in ("cerrados", "movidos", "fusionados"))
    if not (c or m or f):
        return None
    ids = [f"#{x['id']}" for k in ("cerrados", "fusionados", "movidos") for x in (inf.get(k) or [])]
    return (f"barrendero ({inf['fecha']}): cerró {c}, movió {m}, fusionó {f} — "
            + ", ".join(ids[:8]) + (f" … +{len(ids) - 8}" if len(ids) > 8 else "") + " (barrendero --deshacer)")


def cmd_resumen(a):
    reg = Registro()
    hoy = hoy_str()
    vis = [it for it in leer_items() if visible(it, hoy)]
    esperan = sorted((it for it in vis if it.get("columna") == "espera-dueno"),
                     key=lambda it: (it.get("creado") or "", it.get("id") or 0))
    doctor = [it for it in vis if str(it.get("origen") or "").startswith("doctor")
              or str(it.get("clave") or "").startswith("doctor:")]
    bandeja = sum(1 for it in vis if it.get("columna") == "bandeja")
    ramas = ramas_sin_integrar(reg)
    if a.json:
        return salida_json({"espera_dueno": [publico(it) for it in esperan], "ramas": ramas,
                            "doctor": [publico(it) for it in doctor], "bandeja": bandeja,
                            "barrendero": informe_barrendero()})
    cola = []
    if ramas:
        cola.append(f"ramas sin integrar ({len(ramas)}): " + ", ".join(ramas[:5]) + (f" … +{len(ramas) - 5}" if len(ramas) > 5 else ""))
    if doctor:
        cola.append(f"doctor ({len(doctor)}): " + recorte("; ".join(f"#{it['id']} {it.get('proyecto') or '-'} {it.get('titulo')}" for it in doctor), 220))
    if bandeja:
        cola.append(f"bandeja: {bandeja} sin clasificar")
    barr = informe_barrendero()
    if barr and linea_barrendero(barr):
        cola.append(linea_barrendero(barr))
    L = []
    if esperan:
        L.append(f"te esperan {len(esperan)} (más viejo primero):")
        lugar = max(1, a.max - len(cola) - 1)
        mostrar = esperan if len(esperan) <= lugar else esperan[: max(0, lugar - 1)]
        for it in mostrar:
            L.append(f"  {it['id']}  {it.get('proyecto') or '-'}  {recorte(it.get('titulo'), 120)}"
                     + (f" · probar: {recorte(it['prueba'], 80)}" if it.get("prueba") else "") + f"  ({edad(it.get('creado'))})")
        if len(mostrar) < len(esperan):
            L.append(f"  … y {len(esperan) - len(mostrar)} más: tablero listar --columna espera-dueno")
    L += cola
    print("\n".join(L[: max(1, a.max)]) if L else "tablero: nada pendiente")


# ---- línea de comandos ----

def _id(s):
    try:
        return int(s.lstrip("#"))
    except ValueError:
        raise argparse.ArgumentTypeError(f"id inválido: {s}")


AYUDA = D(f"""columnas: {' | '.join(COLUMNAS)}
  bandeja -> sigue -> en-curso -> espera-dueno / espera-externo -> hecho | tirado; aparte, ideas.
proyecto: un nombre del registry (como en `pa`) o un área libre ({', '.join(AREAS)}).
  Un nombre que no se conoce se anota igual y avisa por stderr.
clave:    idempotencia para fuentes automáticas (pa:<id>, doctor:<proyecto>:<chequeo>):
  `agregar --clave K` sobre una clave abierta la actualiza; cerrada, la reabre.
hasta:    AAAA-MM-DD, hoy, mañana, +3d, +2s. El item no aparece hasta ese día. `ya` lo trae de vuelta.
  `listar --pospuestos` los muestra; `posponer <id> <fecha|ya>` cambia o quita la fecha.
texto por archivo: --detalle-archivo F, --prueba-archivo F (y --sumar-archivo F en editar), con
  `-` = stdin: para un texto que no puede ir como argumento de un comando de Bash.
pregunta o prueba (lo que Trama le muestra a {{D}} en espera-dueno): --tipo, --simple (título en
  palabras simples), --contexto, --opcion repetible (ids a, b, c…) y --defecto (id o número).
  `responder` guarda la respuesta en el item y NO lo cierra ni lo mueve.
salida:   una línea por item: id  columna  proyecto  título  (edad).

entorno:  TABLERO_DIR (~/tablero)  TABLERO_VISTA (~/.local/state/tablero/vista.json)
          PA_STATE (~/.local/state/pa)  PROYECTOS_REGISTRY (~/.config/proyectos/registry.json)
""")


def main():
    ap = argparse.ArgumentParser(
        prog="tablero", description=D("Pendientes, esperas, ideas y hecho de {D}, en un solo lugar."),
        epilog=AYUDA, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", metavar="<comando>")

    def cmd(nombre, fn, ayuda, json_=False):
        p = sub.add_parser(nombre, help=ayuda, description=ayuda)
        p.set_defaults(fn=fn)
        if json_:
            p.add_argument("--json", action="store_true", help="salida JSON")
        return p

    p = cmd("agregar", cmd_agregar, "agrega un item (a bandeja si no hay --columna) e imprime su id")
    p.add_argument("titulo", metavar="<título>")
    p.add_argument("--columna", type=col_arg, choices=COLUMNAS)
    p.add_argument("--proyecto")
    p.add_argument("--detalle")
    p.add_argument("--detalle-archivo", metavar="F", help="el detalle sale de ese archivo (`-` = stdin)")
    p.add_argument("--prueba", help=D("comando o nombre exacto de lo que {D} tiene que probar"))
    p.add_argument("--prueba-archivo", metavar="F", help="la prueba sale de ese archivo (`-` = stdin)")
    p.add_argument("--origen", help="quién lo anotó (pa, doctor, shark…)")
    p.add_argument("--clave", help="si ya hay un item con esa clave lo actualiza (o lo reabre)")
    p.add_argument("--hasta", metavar="FECHA", help="posponer hasta ese día")
    flags_pregunta(p)

    p = cmd("listar", cmd_listar, "abiertos (sin hecho, tirado ni pospuestos), una línea por item", True)
    p.add_argument("--proyecto")
    p.add_argument("--columna", metavar="C[,C2]")
    p.add_argument("--todo", action="store_true", help="también hecho, tirado y pospuestos")
    p.add_argument("--pospuestos", action="store_true", help="sólo los pospuestos (abiertos con `hasta` en el futuro)")

    p = cmd("ver", cmd_ver, "un item con todos sus campos (tipo, opciones y respuesta incluidos)", True)
    p.add_argument("id", type=_id)

    p = cmd("mover", cmd_mover, "cambia columna, proyecto o hasta de un item")
    p.add_argument("id", type=_id)
    p.add_argument("--columna", type=col_arg, choices=COLUMNAS)
    p.add_argument("--proyecto")
    p.add_argument("--hasta", metavar="FECHA")

    p = cmd("editar", cmd_editar, "cambia título, detalle, prueba o los campos de pregunta de un item")
    p.add_argument("id", type=_id)
    p.add_argument("--titulo")
    p.add_argument("--detalle", help="reemplaza el detalle entero")
    p.add_argument("--detalle-archivo", metavar="F", help="lo mismo, desde un archivo (`-` = stdin)")
    p.add_argument("--prueba")
    p.add_argument("--prueba-archivo", metavar="F")
    p.add_argument("--sumar", metavar="T", help="agrega T al final del detalle, en una línea nueva")
    p.add_argument("--sumar-archivo", metavar="F", help="lo mismo, desde un archivo (`-` = stdin)")
    flags_pregunta(p)  # --opcion reemplaza la lista entera; --simple "" o --contexto "" los borra
    p.add_argument("--sin-opciones", action="store_true", help="saca las opciones y su por defecto")

    p = cmd("responder", cmd_responder, D("guarda la respuesta de {D} en el item, sin cerrarlo ni moverlo"))
    p.add_argument("id", type=_id)
    p.add_argument("texto", nargs="?", metavar="texto", help="la respuesta en texto libre (igual que --respuesta)")
    p.add_argument("--respuesta", metavar="T", help="texto libre")
    p.add_argument("--opcion", metavar="ID|N", help="la opción elegida: su id o su número de orden")
    g = p.add_mutually_exclusive_group()
    g.add_argument("--anda", dest="anda", action="store_true", default=None, help="una prueba: anduvo")
    g.add_argument("--no-anda", dest="anda", action="store_false", help="una prueba: no anduvo")
    p.add_argument("--nota", metavar="T", help="con --anda / --no-anda: qué se vio")
    p.add_argument("--borrar", action="store_true", help="saca la respuesta (vuelve a estar sin contestar)")

    p = cmd("posponer", cmd_posponer, "cambia o quita el `hasta` de un item: `posponer 12 +3d`, `posponer 12 ya`")
    p.add_argument("ids", type=_id, nargs="+", metavar="id")
    p.add_argument("fecha", metavar="<fecha|ya>")

    p = cmd("cerrar", cmd_cerrar, "pasa a hecho, por id o por --clave (clave sin item abierto: no hace nada)")
    p.add_argument("ids", type=_id, nargs="*", metavar="id")
    p.add_argument("--clave")
    p.add_argument("--nota", help="se suma al detalle como `cierre: …`")

    p = cmd("tirar", cmd_tirar, "pasa a tirado (no se va a hacer)")
    p.add_argument("ids", type=_id, nargs="+", metavar="id")

    p = cmd("sigue", cmd_sigue, "el próximo paso de un proyecto: uno solo, reemplaza al anterior; guarda el HEAD")
    p.add_argument("proyecto")
    p.add_argument("texto", metavar="<texto>")
    p.add_argument("--head", metavar="HASH", help="default: el HEAD del repo del proyecto ahora")

    p = cmd("ficha", cmd_ficha, "dónde quedó un proyecto: commit, ramas sin integrar, sigue, esperas, corridas de pa", True)
    p.add_argument("proyecto")
    p.add_argument("--corta", action="store_true", help="8 líneas como mucho (va al prompt de los workers)")

    p = cmd("proyectos", cmd_proyectos, "los no retirados por días sin tocar, con etapa, abiertos y su sigue", True)
    p.add_argument("--retirados", action="store_true", help="suma al final los retirados (etapa `retirado`)")

    p = cmd("hoy", cmd_hoy, "lo hecho en el día: integradas de pa, items cerrados, commits por proyecto", True)
    p.add_argument("--fecha", metavar="F")

    p = cmd("resumen", cmd_resumen, D("lo que se inyecta al arrancar una sesión: qué espera a {D}, ramas, doctor, bandeja"), True)
    p.add_argument("--max", type=int, default=12, metavar="N", help="líneas como mucho (default 12)")

    p = cmd("archivar", cmd_archivar, "mueve hecho y tirado viejos a hecho/AAAA-MM.jsonl")
    p.add_argument("--dias", type=int, default=30, help="cerrados hace más de N días (default 30)")

    cmd("init", cmd_init, "crea el directorio del tablero (repo git, hecho/, items.jsonl) si no existe")

    a = ap.parse_args()
    if not a.cmd:
        ap.print_help(sys.stderr)
        sys.exit(2)
    try:
        a.fn(a)
        sys.stdout.flush()
    except BrokenPipeError:
        # `tablero listar | sed -n 1,5p`: el lector cortó; no es un error de tablero
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
# trama-estado — qué hay instalado y andando para Trama: claude, agy, Ollama y el motor.
#
#   trama-estado --json    una línea de JSON (contrato abajo); sale 0 siempre que pueda imprimir
#   trama-estado           lo mismo en palabras
#
# {"version":1,
#  "claude":{"instalado":bool,"logueado":bool},
#  "agy":{"instalado":bool,"logueado":bool},
#  "ollama":{"url":str,"responde":bool,"modelos":[str]},
#  "motor":{"vivo":bool,"url":str}}   (+ "proceso":bool, extra: el proceso existe aunque no atienda HTTP)
#
# Sólo biblioteca estándar. Nunca falla por algo que no encuentra: lo que falta sale en false.
# Entorno (para probar): TRAMA_CLAUDE / TRAMA_AGY (otro nombre del binario), TRAMA_MODELOS (otro
# modelos.json), TRAMA_PUERTO (puerto del motor, default 8791), OLLAMA_HOST (si modelos.json no dice).
# Doc: docs/instalacion-de-producto-trama.md
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.request

HOME = os.path.expanduser("~")
# `agy models`: una línea por modelo, "id<TAB>nombre" o sólo el id (gemini-…, claude-…, gpt-…; mismo patrón que bin/cuentas).
# Sin sesión no hay ninguna.
MODELO_AGY = re.compile(r"^\s*(?:[a-z0-9][a-z0-9.-]*\t|(?:gemini|claude|gpt)[-\w.]*\s*$)", re.I)


def salida(cmd, espera=10):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=espera, stdin=subprocess.DEVNULL)
        return p.returncode, p.stdout
    except Exception:
        return 1, ""


def en_path(nombre, extra=()):
    ruta = shutil.which(nombre)
    if ruta:
        return ruta
    # un PATH pelado (systemd, wsl.exe) no trae ~/.local/bin
    for d in [os.path.join(HOME, ".local", "bin"), *extra]:
        local = os.path.join(d, nombre)
        if os.path.isfile(local) and os.access(local, os.X_OK):
            return local
    return None


def dirs_agy():
    # donde cae agy si no está en el PATH: /usr/local/bin y el ~/.antigravity*/bin del instalador
    return ["/usr/local/bin"] + sorted(glob.glob(os.path.join(HOME, ".antigravity*", "bin")))


def claude():
    ruta = en_path(os.environ.get("TRAMA_CLAUDE", "claude"))
    if not ruta:
        return {"instalado": False, "logueado": False}
    logueado = False
    rc, out = salida([ruta, "auth", "status", "--json"])
    try:
        logueado = rc == 0 and bool(json.loads(out).get("loggedIn"))
    except Exception:
        # claude viejo sin `auth status`: queda el archivo de credenciales.
        logueado = os.path.exists(os.path.join(os.environ.get("CLAUDE_CONFIG_DIR", os.path.join(HOME, ".claude")), ".credentials.json"))
    return {"instalado": True, "logueado": logueado}


def agy():
    ruta = en_path(os.environ.get("TRAMA_AGY", "agy"), dirs_agy())
    if not ruta:
        return {"instalado": False, "logueado": False}
    # agy guarda el login de Google en el llavero del sistema (no hay archivo que mirar): con sesión lista modelos.
    # Colgado: salida() corta a los 15 s y devuelve "" (queda en false).
    _, out = salida([ruta, "models"], 15)
    return {"instalado": True, "logueado": any(MODELO_AGY.match(l) for l in out.splitlines())}


def modelos_json():
    ruta = os.environ.get("TRAMA_MODELOS") or os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "trama", "modelos.json")
    try:
        with open(ruta, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {}


def pedir(url, espera=3):
    """GET; devuelve (código HTTP, cuerpo) o (None, '') si no hay nadie. Un 4xx/5xx también es 'responde'."""
    try:
        with urllib.request.urlopen(urllib.request.Request(url), timeout=espera) as r:
            return r.status, r.read(1 << 20).decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        return e.code, ""
    except Exception:
        return None, ""


def ollama():
    url = ""
    for l in (modelos_json().get("locales") or []):
        if isinstance(l, dict) and isinstance(l.get("url"), str) and l["url"]:
            url = l["url"]
            break
    if not url:
        url = os.environ.get("OLLAMA_HOST") or "http://localhost:11434"
        if "://" not in url:
            url = "http://" + url
    url = url.rstrip("/")
    cod, cuerpo = pedir(url + "/api/tags")
    nombres = []
    if cod == 200:
        try:
            nombres = [m["name"] for m in json.loads(cuerpo).get("models", []) if isinstance(m, dict) and m.get("name")]
        except Exception:
            pass
    return {"url": url, "responde": cod == 200, "modelos": nombres}


def motor():
    url = "http://127.0.0.1:%s" % (os.environ.get("TRAMA_PUERTO") or "8791")
    cod, _ = pedir(url + "/")
    # `proceso`: el motor (su `dueno` en ~/.local/state/hilos) está vivo aunque no atienda HTTP todavía.
    proceso = False
    try:
        with open(os.path.join(os.environ.get("HILOS_STATE") or os.path.join(HOME, ".local", "state", "hilos"), "dueno")) as f:
            os.kill(int(json.load(f)["pid"]), 0)
        proceso = True
    except Exception:
        pass
    return {"vivo": cod is not None, "url": url, "proceso": proceso}


def main():
    est = {"version": 1, "claude": claude(), "agy": agy(), "ollama": ollama(), "motor": motor()}
    if "--json" in sys.argv[1:]:
        print(json.dumps(est, ensure_ascii=False))
        return 0
    si = lambda b: "sí" if b else "no"
    print("claude   instalado: %s · sesión: %s" % (si(est["claude"]["instalado"]), si(est["claude"]["logueado"])))
    print("agy      instalado: %s · sesión: %s" % (si(est["agy"]["instalado"]), si(est["agy"]["logueado"])))
    o = est["ollama"]
    print("ollama   %s · responde: %s · modelos: %s" % (o["url"], si(o["responde"]), ", ".join(o["modelos"]) or "ninguno"))
    print("motor    %s · vivo: %s" % (est["motor"]["url"], si(est["motor"]["vivo"])))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # el contrato: sale 0 siempre que pueda imprimir
        print(json.dumps({"version": 1, "claude": {"instalado": False, "logueado": False}, "agy": {"instalado": False, "logueado": False},
                          "ollama": {"url": "", "responde": False, "modelos": []}, "motor": {"vivo": False, "url": "", "proceso": False}, "error": str(e)}))
        sys.exit(0)

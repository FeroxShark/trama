#!/usr/bin/env python3
"""cuentas — varias cuentas por proveedor (Claude, Google/agy, ChatGPT/codex, OpenCode), cada una con su carpeta de credenciales.

  cuentas [--json] [--verificar]               las cuentas (la de siempre de cada proveedor + las agregadas)
  cuentas agregar PROVEEDOR "Nombre" [--id ID] crea la cuenta y su carpeta (no hace el login)
  cuentas quitar ID [--borrar-credenciales]    la saca de la lista; la carpeta queda salvo con el flag
  cuentas renombrar ID "Nombre"                cambia el nombre (también el de la cuenta de siempre)
  cuentas login ID [--imprimir]                lanza el login de esa cuenta (interactivo); --imprimir sólo lo muestra
  cuentas env ID [--json]                      el entorno con que se corre un worker de esa cuenta
  cuentas ver ID [--json]                      una cuenta
  cuentas plan ID gratis|go|go-plus            el plan de OpenCode de una cuenta agregada de OpenCode (el de la de
                                               siempre es `opencode_plan` de modelos.json: lo escribe la app)
  cuentas plan ID --detectar                   lo detecta por `opencode models` (con `opencode-go/*` es go, si no gratis; Go Plus no se
                                               distingue de Go) y, en una agregada, lo guarda; rc 3 si no se pudo saber
  (`cuentas --json --verificar` suma `plan_detectado` a cada cuenta de OpenCode)
  cuentas importar-perfiles [--dir D] [--nativa F] [--json]
                                               importa las cuentas de Claude de una Trama vieja, de dos formatos: (1) la carpeta de
                                               perfiles (<home>/.local/state/hilos/perfiles_claude, o D: perfiles.json + una carpeta por
                                               perfil con .credentials.json y .claude.json) y (2) el cuentas.json de la Trama nativa vieja
                                               de Windows (%APPDATA%\\Trama\\cuentas.json, o F: mismo esquema que el nuestro, cada dir
                                               con sus credenciales). Crea las que no estén (mismo email, id o carpeta) y COPIA (nunca
                                               mueve ni borra; permisos 0600) las credenciales o la carpeta entera (sin los
                                               .oauth_refresh.lock.owner.tmp.*); no imprime su contenido. Sin nada viejo no hace nada

PROVEEDOR: claude | google | chatgpt | opencode. La cuenta de siempre de cada proveedor tiene el id del proveedor y usa las
credenciales de siempre (sin tocar nada): sin cuentas.json todo sigue como antes. Las agregadas viven en
~/.config/trama/cuentas.json (TRAMA_CUENTAS) y cada una tiene su carpeta (default <carpeta de cuentas.json>/cuentas/<id>):
  claude   CLAUDE_CONFIG_DIR=<carpeta> (y sin ANTHROPIC_API_KEY); settings, hooks, skills, plugins y projects son
           symlinks a ~/.claude: sólo las credenciales (.credentials.json, .claude.json) son de la cuenta
  google   HOME=<carpeta> y DBUS_SESSION_BUS_ADDRESS roto: agy no encuentra el llavero y guarda el token en un archivo
           de ese HOME; ~/.gemini/config, git, ~/.config/trama, ~/.local/{bin,state} y ~/.claude son symlinks
  chatgpt  CODEX_HOME=<carpeta>; config.toml, AGENTS.md y prompts son symlinks a ~/.codex
  opencode XDG_DATA_HOME=<carpeta>/data y XDG_STATE_HOME=<carpeta>/state. Verificado con opencode 2.1.4: el login vive en
           $XDG_DATA_HOME/opencode/opencode.db (tabla `credential`; antes, auth.json), así que cada cuenta lleva su
           PROPIO data dir (con él, también sus sesiones). Pero el CLI de 2.x habla con un servicio de fondo (su registro
           es $XDG_STATE_HOME/opencode/service.json, en el puerto 49374) que ya corre con los datos de la persona: sin
           `--standalone` cualquier comando vería la cuenta de la persona aunque cambie XDG_DATA_HOME. Por eso los
           comandos de una cuenta agregada llevan `--standalone` (servidor propio, sin el servicio) y su XDG_STATE_HOME
           propio, que además hace que un comando que se olvide el flag falle (puerto ocupado) en vez de usar la cuenta
           equivocada. `opencode acp` (los líderes) corre dentro del proceso: alcanza con el entorno. La config
           (XDG_CONFIG_HOME, ~/.config/opencode) es la de siempre.
           También TRAMA_OPENCODE_CUENTA=<id> y TRAMA_OPENCODE_PLAN=<plan> (el runner cuenta los pedidos y elige el
           modelo chico según el plan de esa cuenta; con TRAMA_OPENCODE_CUENTA el runner agrega --standalone).
           La de siempre no toca nada (usa el servicio y los datos de siempre) y aparece si opencode está instalado.
Sin dependencias (python3 estándar). TRAMA_CUENTAS_HOME = el home de
verdad de donde salen los symlinks (default $HOME).
"""
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import unicodedata

VERSION = 1
PROVEEDORES = {   # id: (nombre de la cuenta de siempre, motor que la usa)
    "claude": ("Claude", "claude"),
    "google": ("Google AI Pro", "agy"),
    "chatgpt": ("ChatGPT", "codex"),
    "opencode": ("OpenCode", "opencode"),
}
PLANES_OPENCODE = ("gratis", "go", "go-plus")
ID_OK = re.compile(r"^[a-z0-9][a-z0-9-]{0,39}$")
DBUS_ROTO = "unix:path=/nonexistent/trama-sin-llavero"
LINKS = {   # proveedor: rutas relativas al home de verdad -> misma ruta relativa en la carpeta de la cuenta
    "claude": [(".claude/" + n, n) for n in ("settings.json", "CLAUDE.md", "hooks", "skills", "agents", "commands",
                                             "plugins", "projects", "sessions", "output-styles", "keybindings.json")],
    "google": [(n, n) for n in (".gemini/config", ".gemini/GEMINI.md", ".gitconfig", ".config/git", ".config/trama",
                                ".local/bin", ".local/state", ".claude")],
    "chatgpt": [(".codex/" + n, n) for n in ("config.toml", "AGENTS.md", "prompts")],
    "opencode": [(".local/share/opencode/bin", "data/opencode/bin")],   # sus LSP bajados (en 2.x no existe: no se enlaza nada)
}
# `agy models`: el id solo, o "id<TAB>nombre" (mismo patrón que bin/trama-estado)
MODELO_AGY = re.compile(r"^\s*(?:(?:gemini|claude|gpt)[-\w.]*\s*$|[a-z0-9][a-z0-9.-]*\t)", re.I)


def err(m):
    sys.stderr.write("cuentas: %s\n" % m)


def home_real():
    return os.environ.get("TRAMA_CUENTAS_HOME") or os.path.expanduser("~")


def ruta():
    return os.environ.get("TRAMA_CUENTAS") or os.path.join(home_real(), ".config", "trama", "cuentas.json")


def dir_default(cid):
    return os.path.join(os.path.dirname(os.path.abspath(ruta())), "cuentas", cid)


def leer_archivo():
    """Las entradas de cuentas.json. Sin archivo: []. Inválido: una línea por stderr y [] (todo sigue como antes)."""
    try:
        with open(ruta()) as f:
            d = json.load(f)
    except FileNotFoundError:
        return []
    except Exception as e:
        err("%s inválido (%s): uso sólo las cuentas de siempre" % (ruta(), e))
        return []
    out = []
    for c in (d.get("cuentas") if isinstance(d, dict) else None) or []:
        if not isinstance(c, dict) or c.get("proveedor") not in PROVEEDORES or not ID_OK.match(str(c.get("id", ""))):
            err("entrada inválida en %s: %s (la salteo)" % (ruta(), json.dumps(c, ensure_ascii=False)))
            continue
        out.append(c)
    return out


def cargar():
    """Todas las cuentas: la de siempre de claude y google (y la de chatgpt si hay alguna de chatgpt), más las agregadas.
    Cada una: id, proveedor, motor, nombre, dir (None = la de siempre), defecto."""
    ent = leer_archivo()
    por_id = {}
    for c in ent:
        por_id.setdefault(c["id"], c)
    out = []
    provs = ["claude", "google"] + (["chatgpt"] if any(c["proveedor"] == "chatgpt" for c in ent) else []) \
        + (["opencode"] if opencode_bin() or any(c["proveedor"] == "opencode" for c in ent) else [])
    for p in provs:
        r = por_id.get(p)
        out.append({"id": p, "proveedor": p, "motor": PROVEEDORES[p][1],
                    "nombre": (r or {}).get("nombre") or PROVEEDORES[p][0], "dir": None, "defecto": True})
    for c in ent:
        if c["id"] in PROVEEDORES or c is not por_id[c["id"]]:
            continue
        d = os.path.expanduser(c.get("dir") or dir_default(c["id"]))
        cu = {"id": c["id"], "proveedor": c["proveedor"], "motor": PROVEEDORES[c["proveedor"]][1],
              "nombre": c.get("nombre") or c["id"], "dir": os.path.abspath(d), "defecto": False}
        if c["proveedor"] == "opencode":
            cu["plan"] = c.get("plan") if c.get("plan") in PLANES_OPENCODE else "gratis"
        out.append(cu)
    return out


def opencode_bin():
    """El binario opencode (el PATH o ~/.opencode/bin, como pa): None si no está."""
    c = shutil.which("opencode")
    if c:
        return c
    f = os.path.join(home_real(), ".opencode", "bin", "opencode")
    return f if os.access(f, os.X_OK) else None


def buscar(cid):
    return next((c for c in cargar() if c["id"] == cid), None)


def guardar(ent):
    p = ruta()
    os.makedirs(os.path.dirname(os.path.abspath(p)), exist_ok=True)
    tmp = "%s.%d" % (p, os.getpid())
    with open(tmp, "w") as f:
        json.dump({"version": VERSION, "cuentas": ent}, f, ensure_ascii=False, indent=2)
        f.write("\n")
    os.replace(tmp, p)


class Candado:
    def __enter__(self):
        os.makedirs(os.path.dirname(os.path.abspath(ruta())), exist_ok=True)
        self.f = open(ruta() + ".lock", "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        self.f.close()


MARCA_DIR = ".trama-cuenta"   # la deja `agregar`/`login`: sólo se borra una carpeta que la lleva (o que cuelga de la carpeta de cuentas)


def dirs_opencode(c):
    """(datos, estado) de una cuenta agregada de OpenCode: XDG_DATA_HOME y XDG_STATE_HOME."""
    return os.path.join(c["dir"], "data"), os.path.join(c["dir"], "state")


def asegurar_links(c):
    """Crea la carpeta de la cuenta y los symlinks a lo compartido. No pisa nada que ya exista."""
    if c["defecto"]:
        return
    os.makedirs(c["dir"], mode=0o700, exist_ok=True)
    if c["proveedor"] == "opencode":
        for d in dirs_opencode(c):
            os.makedirs(d, mode=0o700, exist_ok=True)
    try:
        with open(os.path.join(c["dir"], MARCA_DIR), "x") as f:
            f.write(c["id"] + "\n")
    except FileExistsError:
        pass
    except OSError as e:
        err("no pude marcar %s: %s" % (c["dir"], e))
    for src, dst in LINKS[c["proveedor"]]:
        s = os.path.join(home_real(), src)
        t = os.path.join(c["dir"], dst)
        if not os.path.lexists(s) or os.path.lexists(t):
            continue
        os.makedirs(os.path.dirname(t), exist_ok=True)
        try:
            os.symlink(s, t)
        except OSError as e:
            err("no pude enlazar %s: %s" % (t, e))


def entorno(c):
    """(poner, sacar): variables a poner y a sacar para correr un worker de esa cuenta. La de siempre: nada."""
    if c["defecto"]:
        return {}, []
    if c["proveedor"] == "claude":
        return {"CLAUDE_CONFIG_DIR": c["dir"]}, ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL"]
    if c["proveedor"] == "google":
        return {"HOME": c["dir"], "DBUS_SESSION_BUS_ADDRESS": DBUS_ROTO}, []
    if c["proveedor"] == "opencode":
        datos, estado = dirs_opencode(c)
        return {"XDG_DATA_HOME": datos, "XDG_STATE_HOME": estado, "TRAMA_OPENCODE_CUENTA": c["id"],
                "TRAMA_OPENCODE_PLAN": c.get("plan") or "gratis"}, []
    return {"CODEX_HOME": c["dir"]}, ["OPENAI_API_KEY"]


def opencode_standalone(c, sub):
    """["--standalone"] si ese subcomando de opencode lo tiene (2.x) y la cuenta es una agregada; si no, []. La de siempre nunca lo lleva:
    usa el servicio de fondo y los datos de la persona, como siempre. `sub`: ["auth", "login"], ["auth", "list"]…"""
    if c["defecto"]:
        return []
    try:
        r = subprocess.run([opencode_bin() or "opencode"] + sub + ["--help"], env=env_de(c), capture_output=True, text=True,
                           timeout=15, stdin=subprocess.DEVNULL)
        return ["--standalone"] if re.search(r"(^|\s)--standalone(\s|$)", r.stdout + r.stderr, re.M) else []
    except Exception:
        return []


def comando_login(c):
    poner, sacar = entorno(c)
    base = {"claude": ["claude", "auth", "login"], "google": ["agy"], "chatgpt": ["codex", "login"],
            "opencode": [opencode_bin() or "opencode", "auth", "login"] + (opencode_standalone(c, ["auth", "login"]) if c["proveedor"] == "opencode" else [])}[c["proveedor"]]
    pre = ["env"] + ["-u%s" % v for v in sacar] + ["%s=%s" % kv for kv in sorted(poner.items())] if (poner or sacar) else []
    return pre + base


def env_de(c):
    e = dict(os.environ)
    poner, sacar = entorno(c)
    for v in sacar:
        e.pop(v, None)
    e.update(poner)
    return e


def logueado_opencode(c, verificar):
    """True/False/None. opencode 1.x: auth.json en el data dir (sólo se cuentan las claves, nunca los valores). 2.x: el login está en
    opencode.db y sólo lo dice `opencode auth list` (lento y con proceso: sólo con `verificar`). En la cuenta agregada va con
    --standalone y su entorno; si el comando falla o no se entiende, None (no se sabe), nunca un False inventado."""
    datos = dirs_opencode(c)[0] if c["dir"] else os.environ.get("XDG_DATA_HOME") or os.path.join(home_real(), ".local", "share")
    try:
        with open(os.path.join(datos, "opencode", "auth.json")) as f:
            j = json.load(f)
        if isinstance(j, dict) and len(j) > 0:
            return True
    except Exception:
        pass
    b = opencode_bin()
    if not verificar or not b:
        return None
    sa = opencode_standalone(c, ["auth", "list"])
    for extra in (["--format", "json"], []):
        try:
            r = subprocess.run([b, "auth", "list"] + sa + extra, env=env_de(c), capture_output=True, text=True, timeout=25,
                               stdin=subprocess.DEVNULL, cwd=os.environ.get("TMPDIR", "/tmp"))
        except Exception:
            return None
        if r.returncode != 0:
            continue
        if extra:
            try:
                j = json.loads(r.stdout)
            except ValueError:
                continue
            if isinstance(j, list):
                return any(isinstance(x, dict) and x.get("connections") for x in j)
        else:
            t = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", r.stdout)
            m = re.search(r"(\d+)\s+credentials?", t, re.I)
            if m:
                return int(m.group(1)) > 0
            return any("stored" in l.lower() for l in t.splitlines())
    return None


def logueado(c, verificar=False):
    """True/False si se sabe, None si no hay forma barata de saberlo (agy guarda el token en el llavero)."""
    p = c["proveedor"]
    if p == "claude":
        if verificar and shutil.which("claude"):
            try:
                r = subprocess.run(["claude", "auth", "status", "--json"], env=env_de(c), capture_output=True,
                                   text=True, timeout=20, stdin=subprocess.DEVNULL)
                return bool(json.loads(r.stdout).get("loggedIn"))
            except Exception:
                pass
        d = c["dir"] or os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(home_real(), ".claude")
        return os.path.exists(os.path.join(d, ".credentials.json"))
    if p == "chatgpt":
        d = c["dir"] or os.environ.get("CODEX_HOME") or os.path.join(home_real(), ".codex")
        return os.path.exists(os.path.join(d, "auth.json"))
    if p == "opencode":
        return logueado_opencode(c, verificar)
    if verificar and shutil.which("agy"):
        try:
            r = subprocess.run(["agy", "models"], env=env_de(c), capture_output=True, text=True, timeout=20,
                               stdin=subprocess.DEVNULL, cwd=os.environ.get("TMPDIR", "/tmp"))
            return any(MODELO_AGY.match(l) for l in r.stdout.splitlines())
        except Exception:
            return False
    return None


def slug(nombre):
    s = unicodedata.normalize("NFKD", nombre).encode("ascii", "ignore").decode().lower()
    s = re.sub(r"[^a-z0-9]+", "-", s).strip("-")[:36]
    return s or "cuenta"


def plan_de_modelos(salida):
    """El plan de OpenCode que dice la salida de `opencode models`: "go" si lista algún `opencode-go/*` (el catálogo de Go sólo aparece con
    Go conectado), "gratis" si lista modelos pero ninguno de Go, None si no lista nada (no se sabe). Go Plus NO se distingue de Go: usa el mismo
    catálogo `opencode-go/*`; ese salto sigue siendo manual."""
    ids = [l.strip() for l in re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", salida or "").splitlines() if re.match(r"^\s*[a-z0-9][\w.-]*/[\w.:-]+\s*$", l)]
    if any(i.startswith("opencode-go/") for i in ids):
        return "go"
    return "gratis" if ids else None


def plan_detectado(c):
    """El plan de esa cuenta de OpenCode según lo que lista `opencode models` con SU entorno (la agregada, con --standalone). None si no se pudo
    preguntar. Siempre con tope de tiempo: opencode 2.x se cuelga con algunos estados."""
    b = opencode_bin()
    if not b:
        return None
    try:
        r = subprocess.run([b, "models"] + opencode_standalone(c, ["models"]), env=env_de(c), capture_output=True, text=True, timeout=40,
                           stdin=subprocess.DEVNULL, cwd=os.environ.get("TMPDIR", "/tmp"))
    except Exception:
        return None
    return plan_de_modelos(r.stdout) if r.returncode == 0 else None


def publico(c, verificar=False):
    d = dict(c)
    d["logueado"] = logueado(c, verificar)
    if verificar and c["proveedor"] == "opencode":
        d["plan_detectado"] = plan_detectado(c)
    return d


def cmd_listar(a):
    js = "--json" in a
    ver = "--verificar" in a
    cs = [publico(c, ver) for c in cargar()]
    if js:
        print(json.dumps({"version": VERSION, "archivo": ruta(), "cuentas": cs}, ensure_ascii=False))
        return 0
    for c in cs:
        lg = {True: "con sesión", False: "sin sesión", None: "sesión sin verificar"}[c["logueado"]]
        print("%-22s %-8s %-24s %s%s" % (c["id"], c["proveedor"], c["nombre"], lg,
                                         "" if c["defecto"] else "  (%s)" % c["dir"]))
    return 0


def cmd_agregar(a):
    if len(a) < 2 or a[0] not in PROVEEDORES:
        err("uso: cuentas agregar claude|google|chatgpt|opencode \"Nombre\" [--id ID]")
        return 2
    prov, nombre, resto = a[0], a[1], a[2:]
    cid = None
    if resto[:1] == ["--id"] and len(resto) == 2:
        cid = resto[1]
    elif resto:
        err("uso: cuentas agregar claude|google|chatgpt|opencode \"Nombre\" [--id ID]")
        return 2
    with Candado():
        ent = leer_archivo()
        usados = set(PROVEEDORES) | {c["id"] for c in ent}
        if cid is not None:
            if not ID_OK.match(cid):
                err("id inválido: %s (minúsculas, números y guiones; hasta 40)" % cid)
                return 2
            if cid in usados:
                err("ya existe una cuenta con id %s" % cid)
                return 2
        else:
            base = slug(nombre)
            cid, n = base, 2
            while cid in usados:
                cid, n = "%s-%d" % (base, n), n + 1
        ent.append({"id": cid, "proveedor": prov, "nombre": nombre})
        guardar(ent)
    c = buscar(cid)
    asegurar_links(c)
    print(cid)
    sys.stderr.write("cuentas: falta el login: cuentas login %s\n" % cid)
    return 0


def carpeta_borrable(c):
    """¿Se puede borrar la carpeta de esa cuenta con --borrar-credenciales? Sólo una carpeta propia: que cuelgue de la carpeta de
    cuentas (<carpeta de cuentas.json>/cuentas) o que lleve la marca que le puso `cuentas`. Nunca el home, ni el estado, los datos
    o la config de siempre (~/.local/state/opencode, ~/.claude…), ni algo que los contenga o esté adentro de ellos."""
    d = os.path.realpath(c["dir"] or "")
    if not c["dir"] or not os.path.isdir(d) or os.path.islink(c["dir"]):
        return False
    h = os.path.realpath(home_real())
    protegidas = [h] + [os.path.realpath(os.path.join(h, r)) for r in (
        ".local", ".local/share", ".local/state", ".config", ".cache", ".claude", ".codex", ".gemini", ".opencode",
        ".local/share/opencode", ".local/state/opencode", ".config/opencode", ".cache/opencode", ".config/trama")]
    for p in protegidas:
        if d == p or p.startswith(d + os.sep):
            return False
    if d.startswith(os.path.join(h, ".local", "share", "opencode") + os.sep) or d.startswith(os.path.join(h, ".local", "state", "opencode") + os.sep):
        return False
    raiz = os.path.realpath(os.path.join(os.path.dirname(os.path.abspath(ruta())), "cuentas"))
    if d.startswith(raiz + os.sep):
        return True
    try:
        with open(os.path.join(d, MARCA_DIR)) as f:
            return f.read().strip() == c["id"]
    except OSError:
        return False


def cmd_quitar(a):
    if not a or a[1:] not in ([], ["--borrar-credenciales"]):
        err("uso: cuentas quitar ID [--borrar-credenciales]")
        return 2
    cid = a[0]
    if cid in PROVEEDORES:
        err("%s es la cuenta de siempre de su proveedor: no se quita (se puede renombrar)" % cid)
        return 2
    with Candado():
        c = buscar(cid)
        if not c:
            err("no hay ninguna cuenta %s" % cid)
            return 1
        borrar = "--borrar-credenciales" in a and c["dir"] and os.path.isdir(c["dir"])
        if borrar and not carpeta_borrable(c):
            err("no borro %s: no es una carpeta propia de trama (sacala a mano si de verdad es esa); la cuenta sigue en la lista" % c["dir"])
            return 1
        guardar([e for e in leer_archivo() if e["id"] != cid])
    if borrar:
        # los symlinks a lo compartido se borran como links, nunca se sigue adentro
        shutil.rmtree(c["dir"])
        print("cuenta %s quitada y su carpeta borrada" % cid)
    else:
        print("cuenta %s quitada%s" % (cid, " (su carpeta queda en %s)" % c["dir"] if c["dir"] else ""))
    return 0


def cmd_renombrar(a):
    if len(a) != 2 or not a[1].strip():
        err("uso: cuentas renombrar ID \"Nombre\"")
        return 2
    cid, nombre = a
    with Candado():
        if not buscar(cid):
            err("no hay ninguna cuenta %s" % cid)
            return 1
        ent = leer_archivo()
        for e in ent:
            if e["id"] == cid:
                e["nombre"] = nombre
                break
        else:   # la de siempre, todavía sin entrada
            ent.append({"id": cid, "proveedor": cid, "nombre": nombre})
        guardar(ent)
    print("%s: %s" % (cid, nombre))
    return 0


def cmd_login(a):
    if not a or a[1:] not in ([], ["--imprimir"]):
        err("uso: cuentas login ID [--imprimir]")
        return 2
    c = buscar(a[0])
    if not c:
        err("no hay ninguna cuenta %s" % a[0])
        return 1
    asegurar_links(c)
    cmd = comando_login(c)
    if "--imprimir" in a:
        print(" ".join(x if re.match(r"^[\w@%+=:,./-]+$", x) else "'%s'" % x.replace("'", "'\\''") for x in cmd))
        return 0
    if not shutil.which(cmd[0] if cmd[0] != "env" else next(x for x in cmd[1:] if "=" not in x and not x.startswith("-u"))):
        err("no está instalado el CLI de %s" % c["proveedor"])
        return 1
    os.execvp(cmd[0], cmd)


def cmd_env(a):
    if not a or a[1:] not in ([], ["--json"]):
        err("uso: cuentas env ID [--json]")
        return 2
    c = buscar(a[0])
    if not c:
        err("no hay ninguna cuenta %s" % a[0])
        return 1
    asegurar_links(c)
    poner, sacar = entorno(c)
    if "--json" in a:
        print(json.dumps({"id": c["id"], "proveedor": c["proveedor"], "motor": c["motor"], "nombre": c["nombre"],
                          "defecto": c["defecto"], "poner": poner, "sacar": sacar, **({"plan": c["plan"]} if "plan" in c else {})},
                         ensure_ascii=False))
    else:
        for v in sacar:
            print("-%s" % v)
        for k, v in sorted(poner.items()):
            print("%s=%s" % (k, v))
    return 0


def cmd_ver(a):
    if not a or a[1:] not in ([], ["--json"], ["--verificar"], ["--json", "--verificar"], ["--verificar", "--json"]):
        err("uso: cuentas ver ID [--json] [--verificar]")
        return 2
    c = buscar(a[0])
    if not c:
        err("no hay ninguna cuenta %s" % a[0])
        return 1
    d = publico(c, "--verificar" in a)
    print(json.dumps(d, ensure_ascii=False) if "--json" in a else "%s %s %s" % (d["id"], d["proveedor"], d["nombre"]))
    return 0


def cmd_plan(a):
    if len(a) == 2 and a[1] == "--detectar":
        # El plan que dice `opencode models` de esa cuenta (la de siempre incluida): se imprime y, en una agregada, se guarda. 3 = no se pudo saber.
        c = buscar(a[0])
        if not c or c["proveedor"] != "opencode":
            err("no hay ninguna cuenta de OpenCode %s" % a[0])
            return 1
        plan = plan_detectado(c)
        if not plan:
            return 3
        if not c["defecto"] and plan != (c.get("plan") or "gratis") and not (plan == "go" and c.get("plan") == "go-plus"):
            return cmd_plan([a[0], plan])
        print("%s: %s" % (a[0], plan))
        return 0
    if len(a) != 2 or a[1] not in PLANES_OPENCODE:
        err("uso: cuentas plan ID gratis|go|go-plus|--detectar")
        return 2
    cid, plan = a
    if cid == "opencode":
        err("el plan de la cuenta de siempre de OpenCode es `opencode_plan` de modelos.json (Ajustes > Plan y cupos)")
        return 2
    with Candado():
        c = buscar(cid)
        if not c or c["proveedor"] != "opencode":
            err("no hay ninguna cuenta de OpenCode %s" % cid)
            return 1
        ent = leer_archivo()
        for e in ent:
            if e["id"] == cid:
                if plan == "gratis":
                    e.pop("plan", None)
                else:
                    e["plan"] = plan
        guardar(ent)
    print("%s: %s" % (cid, plan))
    return 0


ID_VIEJO_OK = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_.-]*$")
ARCHIVOS_PERFIL = (".credentials.json", ".claude.json")   # lo que se copia de cada perfil viejo (el primero es obligatorio)


def email_de_claude_json(d):
    """El email de la cuenta que dice <d>/.claude.json (oauthAccount.emailAddress), o None. Sólo se lee ese campo."""
    try:
        with open(os.path.join(d, ".claude.json")) as f:
            e = json.load(f)["oauthAccount"]["emailAddress"]
        return (e.strip() or None) if isinstance(e, str) else None
    except Exception:
        return None


def perfiles_viejos(d):
    """[(id viejo, nombre, email)] de la carpeta de perfiles de una Trama vieja: los de perfiles.json y, después, las subcarpetas
    con .credentials.json que el registro no nombra. Nombre y email None si no los dice."""
    out, vistos = [], set()
    try:
        with open(os.path.join(d, "perfiles.json")) as f:
            reg = json.load(f)
        lista = reg.get("cuentas") if isinstance(reg, dict) else None
    except Exception:
        lista = None
    for c in lista if isinstance(lista, list) else []:
        if not isinstance(c, dict) or not isinstance(c.get("id"), str) or not ID_VIEJO_OK.match(c["id"]) or c["id"] in vistos:
            continue
        vistos.add(c["id"])
        txt = lambda k: c[k].strip() if isinstance(c.get(k), str) and c[k].strip() else None
        out.append((c["id"], txt("nombre"), txt("email")))
    try:
        sub = sorted(os.listdir(d))
    except OSError:
        sub = []
    for n in sub:
        if n not in vistos and ID_VIEJO_OK.match(n) and os.path.isfile(os.path.join(d, n, ARCHIVOS_PERFIL[0])):
            out.append((n, None, None))
    return out


def copiar_privado(src, dst):
    """Copia src a dst (por un temporal) con permisos sólo del usuario. No toca src."""
    tmp = "%s.%d.tmp" % (dst, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as o, open(src, "rb") as i:
        shutil.copyfileobj(i, o)
    os.replace(tmp, dst)
    os.chmod(dst, 0o600)


PREFIJO_LOCK_REFRESCO = ".oauth_refresh.lock.owner.tmp."   # temporales de la Trama nativa vieja: no se copian


def copiar_arbol(src, dst):
    """Copia la carpeta src a dst (archivos 0600, carpetas 0700) sin seguir symlinks ni llevar los temporales de refresco. No toca src."""
    os.makedirs(dst, mode=0o700, exist_ok=True)
    for n in sorted(os.listdir(src)):
        s, t = os.path.join(src, n), os.path.join(dst, n)
        if n.startswith(PREFIJO_LOCK_REFRESCO) or os.path.islink(s):
            continue
        if os.path.isdir(s):
            copiar_arbol(s, t)
        elif os.path.isfile(s):
            copiar_privado(s, t)


def carpeta_origen_segura(src, destino):
    """¿Se puede copiar src entera a destino? No si es el home (o lo contiene) ni si una contiene a la otra."""
    s, d, h = (os.path.realpath(x) for x in (src, destino, home_real()))
    return not (s == h or h.startswith(s + os.sep) or d.startswith(s + os.sep) or s.startswith(d + os.sep) or s == d)


def cuentas_nativas(f):
    """[(id, nombre, dir)] de las cuentas de Claude del cuentas.json de la Trama nativa vieja (mismo esquema que el nuestro). Más tolerante que
    el nuestro con el id (el viejo puede traer `cuenta_123`): sólo se pide que sea un nombre de carpeta seguro. Archivo roto: []."""
    try:
        with open(f) as fh:
            d = json.load(fh)
    except Exception:
        return []
    out, vistos = [], set()
    for c in (d.get("cuentas") if isinstance(d, dict) else None) or []:
        if not isinstance(c, dict) or not isinstance(c.get("id"), str) or not ID_VIEJO_OK.match(c["id"]) or c["id"] in vistos \
                or c.get("proveedor", "claude") != "claude" or c["id"] in PROVEEDORES:
            continue
        vistos.add(c["id"])
        txt = lambda k: c[k].strip() if isinstance(c.get(k), str) and c[k].strip() else None
        out.append((c["id"], txt("nombre"), txt("dir")))
    return out


def archivo_nativo_viejo():
    """El cuentas.json de la Trama nativa vieja de Windows: %APPDATA%\\Trama\\cuentas.json (None si no hay APPDATA)."""
    a = os.environ.get("APPDATA")
    return os.path.join(a, "Trama", "cuentas.json") if a else None


def cmd_importar_perfiles(a):
    uso = "uso: cuentas importar-perfiles [--dir D] [--nativa F] [--json]"
    d, nativa, js, i = None, None, False, 0
    while i < len(a):
        if a[i] == "--json":
            js = True
        elif a[i] == "--dir" and i + 1 < len(a) and d is None:
            d, i = a[i + 1], i + 1
        elif a[i] == "--nativa" and i + 1 < len(a) and nativa is None:
            nativa, i = a[i + 1], i + 1
        else:
            err(uso)
            return 2
        i += 1
    if d is None:
        d = os.path.join(home_real(), ".local", "state", "hilos", "perfiles_claude")
    d = os.path.expanduser(d)
    nativa = os.path.expanduser(nativa) if nativa else archivo_nativo_viejo()
    importadas, omitidas, lineas = [], 0, []
    hay_perfiles, hay_nativa = os.path.isdir(d), bool(nativa) and os.path.isfile(nativa)
    if hay_perfiles or hay_nativa:
        with Candado():
            ent = leer_archivo()
            usados = set(PROVEEDORES) | {c["id"] for c in ent}
            actual = email_de_claude_json(home_real())   # la cuenta de siempre de Claude no se importa dos veces
            emails = {actual.lower()} if actual else set()
            de_antes, carpetas = set(), set()
            for c in ent:
                if c["proveedor"] != "claude":
                    continue
                cdir = os.path.expanduser(c.get("dir") or dir_default(c["id"]))
                carpetas.add(os.path.realpath(cdir))
                e = c.get("email") if isinstance(c.get("email"), str) else None
                e = e or email_de_claude_json(cdir)
                if e:
                    emails.add(e.lower())
                if isinstance(c.get("importada_de"), str):
                    de_antes.add(c["importada_de"])

            def agregar(cid, nombre, email, origen, copiar):
                """Copia (con `copiar(destino)`), anota la cuenta y la deja lista. False si no se pudo copiar."""
                destino = dir_default(cid)
                try:
                    copiar(destino)
                except OSError as e:
                    err("no pude copiar la cuenta %s: %s" % (origen, e))
                    return False
                nueva = {"id": cid, "proveedor": "claude", "nombre": nombre}
                if email:
                    nueva["email"] = email
                nueva["importada_de"] = origen
                ent.append(nueva)
                usados.add(cid)
                if email:
                    emails.add(email.lower())
                carpetas.add(os.path.realpath(destino))
                guardar(ent)
                asegurar_links(buscar(cid))
                importadas.append(cid)
                lineas.append("importada: %s (%s)" % (cid, nombre))
                return True

            if hay_perfiles:
                for vid, nombre, email in perfiles_viejos(d):
                    src = os.path.join(d, vid)
                    if os.path.islink(src) or not os.path.isfile(os.path.join(src, ARCHIVOS_PERFIL[0])):
                        omitidas += 1
                        lineas.append("salteada: %s (sin %s)" % (vid, ARCHIVOS_PERFIL[0]))
                        continue
                    email = email or email_de_claude_json(src)
                    if vid in de_antes or (email and email.lower() in emails):
                        omitidas += 1
                        lineas.append("ya estaba: %s" % (nombre or email or vid))
                        continue
                    nombre = nombre or email or vid
                    base = slug(nombre)
                    cid, n = base, 2
                    while cid in usados:
                        cid, n = "%s-%d" % (base, n), n + 1

                    def copiar(destino, src=src):
                        os.makedirs(destino, mode=0o700, exist_ok=True)
                        for f in ARCHIVOS_PERFIL:
                            if os.path.isfile(os.path.join(src, f)):
                                copiar_privado(os.path.join(src, f), os.path.join(destino, f))
                    if not agregar(cid, nombre, email, vid, copiar):
                        omitidas += 1
            if hay_nativa:
                base_dir = os.path.dirname(os.path.abspath(nativa))
                for vid, nombre, dcfg in cuentas_nativas(nativa):
                    cid = vid if ID_OK.match(vid) else slug(vid)
                    src = os.path.abspath(os.path.join(base_dir, os.path.expanduser(dcfg or os.path.join("cuentas", vid))))
                    nombre = nombre or vid
                    if "nativa:" + vid in de_antes or cid in usados or os.path.realpath(src) in carpetas:
                        omitidas += 1
                        lineas.append("ya estaba: %s" % nombre)
                        continue
                    if not os.path.isdir(src) or os.path.islink(src):
                        omitidas += 1
                        lineas.append("salteada: %s (sin carpeta)" % vid)
                        continue
                    if not carpeta_origen_segura(src, dir_default(cid)):
                        omitidas += 1
                        lineas.append("salteada: %s (carpeta no segura para copiar)" % vid)
                        continue
                    email = email_de_claude_json(src)
                    if email and email.lower() in emails:
                        omitidas += 1
                        lineas.append("ya estaba: %s" % nombre)
                        continue
                    if not agregar(cid, nombre, email, "nativa:" + vid, lambda destino, src=src: copiar_arbol(src, destino)):
                        omitidas += 1
    else:
        lineas.append("no hay perfiles viejos en %s" % d)
    if js:
        print(json.dumps({"importadas": len(importadas), "omitidas": omitidas, "cuentas": importadas}, ensure_ascii=False))
        return 0
    for l in lineas:
        print(l)
    print("importadas: %d" % len(importadas))
    return 0


def main(argv):
    if not argv or argv[0] in ("--json", "--verificar"):
        return cmd_listar(argv)
    if argv[0] in ("-h", "--help"):
        sys.stdout.write(__doc__)
        return 0
    f = {"agregar": cmd_agregar, "quitar": cmd_quitar, "renombrar": cmd_renombrar, "login": cmd_login,
         "env": cmd_env, "ver": cmd_ver, "listar": cmd_listar, "plan": cmd_plan,
         "importar-perfiles": cmd_importar_perfiles}.get(argv[0])
    if not f:
        sys.stdout.write(__doc__)
        return 2
    return f(argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

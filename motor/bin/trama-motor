#!/usr/bin/env bash
# trama-motor — el motor de Trama (dist-electron/motor.js) sin ventana, para el producto.
#
#   trama-motor [run]                 en primer plano (lo que corre la unit trama-motor.service)
#   trama-motor start|stop|restart    la unit de usuario; sin systemd de usuario lo lanza suelto (start) / lo baja (stop)
#   trama-motor status                trama-estado en palabras
#   trama-motor logs                  journalctl --user -u trama-motor -f
#
# Dónde está la app: $TRAMA_APP, si no la ruta que dejó instalar-producto.sh en ~/.config/trama/app.
# Node puro (como el Dell): sin Electron ni pantalla. TRAMA_LOCAL=1 = el motor escucha en 127.0.0.1:8791.
# Doc: docs/instalacion-de-producto-trama.md
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/trama"
estado_dir="${PA_STATE:-$HOME/.local/state/pa}"
app="${TRAMA_APP:-}"
[[ -n "$app" || ! -f "$CONF/app" ]] || app="$(<"$CONF/app")"

correr() {
  [[ -n "$app" && -f "$app/dist-electron/motor.js" ]] \
    || { echo "trama-motor: no encuentro la app (TRAMA_APP o $CONF/app); corré instalar-producto.sh" >&2; exit 2; }
  export HILOS_MOTOR=1 TRAMA_UNIDAD=1 TRAMA_LOCAL=1
  export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
  exec node "$app/dist-electron/motor.js"
}

con_systemd() { systemctl --user show-environment >/dev/null 2>&1 && [[ -f "$HOME/.config/systemd/user/trama-motor.service" ]]; }

pid_suelto="$estado_dir/trama-motor.pid"

case "${1:-run}" in
  run) correr ;;
  start)
    if con_systemd; then exec systemctl --user start trama-motor.service; fi
    if [[ -f "$pid_suelto" ]] && kill -0 "$(<"$pid_suelto")" 2>/dev/null; then echo "trama-motor: ya corre ($(<"$pid_suelto"))"; exit 0; fi
    mkdir -p "$estado_dir"
    setsid nohup "$0" run >"$estado_dir/trama-motor.log" 2>&1 </dev/null &
    echo $! >"$pid_suelto"
    echo "trama-motor: lanzado suelto (sin systemd de usuario), pid $!; log en $estado_dir/trama-motor.log" ;;
  stop)
    if con_systemd; then exec systemctl --user stop trama-motor.service; fi
    if [[ -f "$pid_suelto" ]] && kill -0 "$(<"$pid_suelto")" 2>/dev/null; then kill "$(<"$pid_suelto")"; rm -f "$pid_suelto"; echo "trama-motor: detenido"; fi ;;
  restart) "$0" stop || true; sleep 1; exec "$0" start ;;
  status) exec trama-estado ;;
  logs) exec journalctl --user -u trama-motor.service -f ;;
  *) echo "uso: trama-motor [run|start|stop|restart|status|logs]" >&2; exit 2 ;;
esac

#!/usr/bin/env bash
# gate <proyecto> <id> --chequeo CMD --permitidos F [--test COPIA[:RUTA]] [--extras CMD] [--rojos CMD] [--main REF] [--log F]
#
# Compuerta de cada corrida (F6) del protocolo de orquestación (motor/docs/protocolo-orquestacion.txt, sección 4).
# La corre el líder, no el worker: la VERIFICACION del worker es un indicio, esto es la prueba. Corre los cinco pasos
# aunque alguno falle (así el reintento lleva toda la evidencia) y sale con el exit del PRIMER paso que falló.
#
#   1. alcance        los archivos que la rama cambió contra main están todos en --permitidos
#                     (una ruta por línea: exacta, `dir/` = todo lo de adentro, o glob con * ; # y vacías se ignoran)
#   2. test congelado (sólo con --test) pisa en el worktree RUTA con COPIA (la del plan) y corre el chequeo y los rojos
#                     con esa. Si la rama cambió el test, avisa y no rechaza: lo que manda es la copia. RUTA = dónde está
#                     en el repo; sin ella, el único archivo de la rama con el mismo nombre que COPIA. Sin --test es el
#                     camino trivial: no hay test congelado y se saltea (y lo dice). Al salir se restaura el worktree
#   3. chequeo        --chequeo CMD corre en el worktree de la rama y da exit 0
#   3b extras         los *.extra.test.* que agregó o cambió la rama corren aparte, con --extras CMD (exit 0). Sin --extras
#                     avisa que no corrieron
#   4. rojos nuevos   --rojos CMD (corre los tests e imprime los que fallan, uno por línea) en la rama y en main:
#                     lo que falla en la rama y no en main es nuevo. La base de main se guarda una vez por sha en
#                     $PA_STATE/<proyecto>/base-<sha>.txt. Sin --rojos se saltea (y lo dice)
#   5. compactación   con --log F, avisa si el log del worker menciona compactación. Es aviso: no rechaza (el gate
#                     juzga el código, no la memoria del worker)
#
# <id> es el de la rama pa/<proyecto>/<id> (también vale la rama entera). Si la rama ya no tiene worktree, se saca uno
# desechable en /tmp/gate-<id> y se borra al terminar.
#
# Exits:  0 verde · 2 uso · 3 no resuelve proyecto/rama/main/archivos del gate · 21 fuera de lo permitido ·
#         22 test congelado cambiado · 23 el chequeo dio rojo · 24 rojos nuevos contra main
set -uo pipefail

AQUI="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE="${PA_STATE:-$HOME/.local/state/pa}"

uso() { sed -n '2p' "${BASH_SOURCE[0]}" | sed 's/^# *//' >&2; exit 2; }
ayuda() { awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/,""); print}' "${BASH_SOURCE[0]}"; exit 0; }
fatal() { echo "gate: $*" >&2; exit 3; }

proy=""; id=""; chequeo=""; permitidos=""; test_arg=""; extras_cmd=""; rojos=""; main_ref="main"; log=""
bk=""; existia=0   # backup del archivo de test del worktree mientras está pisado (paso 2)
pos=()
while (($#)); do
  case "$1" in
    --chequeo)    [[ $# -ge 2 ]] || uso; chequeo="$2"; shift 2 ;;
    --permitidos) [[ $# -ge 2 ]] || uso; permitidos="$2"; shift 2 ;;
    --test)       [[ $# -ge 2 ]] || uso; test_arg="$2"; shift 2 ;;
    --extras)     [[ $# -ge 2 ]] || uso; extras_cmd="$2"; shift 2 ;;
    --rojos)      [[ $# -ge 2 ]] || uso; rojos="$2"; shift 2 ;;
    --main)       [[ $# -ge 2 ]] || uso; main_ref="$2"; shift 2 ;;
    --log)        [[ $# -ge 2 ]] || uso; log="$2"; shift 2 ;;
    -h|--help)    ayuda ;;
    -*)           echo "gate: opción desconocida: $1" >&2; uso ;;
    *)            pos+=("$1"); shift ;;
  esac
done
((${#pos[@]} == 2)) || uso
proy="${pos[0]}"; id="${pos[1]}"
[[ -n "$chequeo" && -n "$permitidos" ]] || uso
[[ -f "$permitidos" ]] || fatal "no existe --permitidos: $permitidos"
copia=""; test_ruta=""
if [[ -n "$test_arg" ]]; then
  copia="${test_arg%%:*}"
  [[ "$test_arg" == *:* ]] && test_ruta="${test_arg#*:}"
  [[ -f "$copia" ]] || fatal "no existe la copia del test: $copia"
fi

PR="$AQUI/proyecto-ruta"; [[ -x "$PR" ]] || PR="$(command -v proyecto-ruta || true)"
[[ -n "$PR" ]] || fatal "no encuentro proyecto-ruta"
repo="$("$PR" "$proy" 2>/dev/null)" && [[ -n "$repo" ]] || fatal "no resuelvo el proyecto: $proy"
slug="$(basename "$repo")"; slug="${slug//[^A-Za-z0-9._-]/-}"; slug="${slug,,}"   # = slug_de de pa
rama="$id"; [[ "$id" == pa/* ]] || rama="pa/$slug/$id"
git -C "$repo" rev-parse --verify -q "refs/heads/$rama" >/dev/null || fatal "no existe la rama $rama en $repo"
git -C "$repo" rev-parse --verify -q "$main_ref" >/dev/null || fatal "no existe $main_ref en $repo"

# Worktree de la rama: el que ya la tiene, o uno desechable.
wt="$(git -C "$repo" worktree list --porcelain | awk -v r="refs/heads/$rama" '/^worktree /{w=substr($0,10)} $0=="branch " r{print w; exit}')"
desechables=()
limpiar() { local d; for d in "${desechables[@]}"; do git -C "$repo" worktree remove --force "$d" >/dev/null 2>&1; done; }
restaurar() { # devuelve al worktree el archivo de test que el paso 2 pisó
  [[ -n "$bk" ]] || return 0
  if ((existia)); then cp -p "$bk" "$wt/$test_ruta"; else rm -f "$wt/$test_ruta"; fi
  rm -f "$bk"; bk=""
}
trap 'restaurar; limpiar' EXIT
if [[ -z "$wt" || ! -d "$wt" ]]; then
  wt="/tmp/gate-${rama//\//-}"
  git -C "$repo" worktree add --detach "$wt" "$rama" >/dev/null 2>&1 || fatal "no pude sacar un worktree de $rama en $wt"
  desechables+=("$wt")
fi

falla=0
rojo() { # <exit> <mensaje>: anota la falla; el primero manda el exit
  echo "ROJO  $2"
  ((falla == 0)) && falla="$1"
}

# 1. alcance
fuera=()
while IFS= read -r f; do
  [[ -n "$f" ]] || continue
  ok=0
  while IFS= read -r p || [[ -n "$p" ]]; do
    p="${p%$'\r'}"; [[ -z "$p" || "$p" == \#* ]] && continue
    # shellcheck disable=SC2053
    if [[ "$f" == "$p" || ( "$p" == */ && "$f" == "$p"* ) || "$f" == $p ]]; then ok=1; break; fi
  done <"$permitidos"
  ((ok)) || fuera+=("$f")
done < <(git -C "$repo" diff --name-only "$main_ref...$rama")
if ((${#fuera[@]})); then
  rojo 21 "1 alcance: ${#fuera[@]} archivo(s) fuera de lo permitido"; printf '        %s\n' "${fuera[@]}"
else echo "OK    1 alcance"; fi

# 1b. snapshots: un __snapshots__/ cambiado tiene su ruta nombrada en --permitidos (no alcanza con un dir/ o un *)
snap_fuera=()
while IFS= read -r f; do
  [[ "$f" == *__snapshots__/* ]] || continue
  ok=0
  while IFS= read -r p || [[ -n "$p" ]]; do
    p="${p%$'\r'}"; [[ -z "$p" || "$p" == \#* || "$p" != *__snapshots__* ]] && continue
    # shellcheck disable=SC2053
    if [[ "$f" == $p ]]; then ok=1; break; fi
  done <"$permitidos"
  ((ok)) || snap_fuera+=("$f")
done < <(git -C "$repo" diff --name-only "$main_ref...$rama")
if ((${#snap_fuera[@]})); then
  rojo 26 "1b snapshots: ${#snap_fuera[@]} snapshot(s) sin ruta explícita en --permitidos"; printf '        %s\n' "${snap_fuera[@]}"
else echo "OK    1b snapshots"; fi

# 2. test congelado (sin --test: camino trivial, no hay test que congelar)
if [[ -z "$test_arg" ]]; then echo "SALTEADO 2 test congelado (sin --test)"
else
  if [[ -z "$test_ruta" ]]; then
    mapfile -t cand < <(git -C "$repo" ls-tree -r --name-only "$rama" | awk -v b="$(basename "$copia")" '{n=split($0,a,"/"); if (a[n]==b) print}')
    if ((${#cand[@]} == 1)); then test_ruta="${cand[0]}"; fi
  fi
  if [[ -z "$test_ruta" ]]; then
    rojo 22 "2 test congelado: la rama no tiene un único archivo llamado $(basename "$copia") (pasá --test COPIA:RUTA)"
  else
    git -C "$repo" show "$rama:$test_ruta" 2>/dev/null | cmp -s - "$copia" \
      || echo "AVISO 2 la rama cambió $test_ruta (o no lo tiene): el gate corre la copia congelada, no rechaza"
    bk="$(mktemp)"
    if [[ -e "$wt/$test_ruta" ]]; then existia=1; cp -p "$wt/$test_ruta" "$bk"; fi
    mkdir -p "$(dirname "$wt/$test_ruta")" && cp "$copia" "$wt/$test_ruta" || fatal "no pude pisar $test_ruta en $wt"
    echo "OK    2 test congelado ($test_ruta pisado con la copia)"
  fi
fi

# 3. chequeo de la subtarea
sal3="$(cd "$wt" && bash -c "$chequeo" 2>&1)"; ex3=$?
if ((ex3 == 0)); then echo "OK    3 chequeo"
else rojo 23 "3 chequeo: exit $ex3"; printf '%s\n' "$sal3" | tail -n 15 | sed 's/^/        /'; fi

# 3b. extras: los *.extra.test.* que agregó o cambió la rama corren aparte, con --extras
mapfile -t extras < <(git -C "$repo" diff --name-only --diff-filter=AM "$main_ref...$rama" | awk -F/ '$NF ~ /\.extra\.test\./')
if ((${#extras[@]} == 0)); then echo "OK    3b sin extras"
elif [[ -z "$extras_cmd" ]]; then echo "AVISO 3b ${#extras[@]} extra(s) sin --extras: no corrieron"; printf '        %s\n' "${extras[@]}"
else
  sal3b="$(cd "$wt" && bash -c "$extras_cmd" 2>&1)"; ex3b=$?
  if ((ex3b == 0)); then echo "OK    3b extras (${#extras[@]})"
  else rojo 23 "3b extras: exit $ex3b"; printf '%s\n' "$sal3b" | tail -n 15 | sed 's/^/        /'; fi
fi

# 4. rojos nuevos contra main
if [[ -z "$rojos" ]]; then echo "SALTEADO 4 rojos nuevos (sin --rojos)"
else
  sha="$(git -C "$repo" rev-parse --short "$main_ref")"
  base="$STATE/$slug/base-$sha.txt"
  if [[ ! -f "$base" ]]; then
    bwt="/tmp/base-$sha"
    if [[ ! -d "$bwt" ]]; then
      git -C "$repo" worktree add --detach "$bwt" "$main_ref" >/dev/null 2>&1 || fatal "no pude sacar $main_ref en $bwt"
    fi
    mkdir -p "$(dirname "$base")"
    (cd "$bwt" && bash -c "$rojos" 2>&1) | sort -u >"$base.tmp" && mv -f "$base.tmp" "$base"
  fi
  nuevos="$(cd "$wt" && bash -c "$rojos" 2>&1 | sort -u | comm -13 "$base" -)"
  if [[ -z "$nuevos" ]]; then echo "OK    4 rojos nuevos (base $(wc -l <"$base") en $sha)"
  else rojo 24 "4 rojos nuevos contra $main_ref ($sha)"; printf '%s\n' "$nuevos" | sed 's/^/        /'; fi
fi

restaurar

# 5. compactación (aviso)
if [[ -n "$log" ]]; then
  if [[ -f "$log" ]] && grep -qi 'compactaci' "$log"; then echo "AVISO 5 el worker compactó (no rechaza: manda el código)"
  else echo "OK    5 sin compactación"; fi
fi

((falla == 0)) && echo "GATE VERDE $rama" || echo "GATE ROJO $rama (exit $falla)"
exit "$falla"

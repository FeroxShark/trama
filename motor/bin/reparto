# --- ritmo semanal y perfiles -------------------------------------------------------------------------
# Para cada ventana "7d" con dato (de Claude, de un grupo de agy o de codex):
#   disponible   = 1 - reserva_lider                      (sólo el Claude oficial: lo que los workers pueden gastar; el resto es del líder)
#   usado_w      = min(1, usado / disponible)             (lo gastado visto desde los workers: con la reserva entera gastada vale 1)
#   esperado     = fracción de la ventana ya transcurrida, ponderada por días: un día "ausente" del plan pesa 0 (el presupuesto
#                  semanal se reparte entre los demás); piso RITMO_MIN_ESPERADO para no dividir por casi cero al empezar la semana
#   ratio        = usado_w / esperado                      (1 = justo al ritmo que termina la semana en ~100 %)
#   gastar-hoy / ahorrar-hoy del plan pisan el ratio de hoy (RATIO_GASTAR_HOY / RATIO_AHORRAR_HOY)
# Puntaje (se suma al de siempre: calidad útil + urgencia − costo − carga):
#   encima  = -PESO_RITMO × mult_perfil × min(max(ratio - 1, 0), TOPE_EXCESO)
#   debajo  : presión = (1 - ratio×esperado) / (1 - esperado)  (cuántas veces el ritmo medio hay que gastar lo que queda; 1 = al ritmo)
#             atras   = clamp(presión - 1, 0, 1)               (presión ≥ 2 = del todo atrasado)
#             cerca   = clamp((96 - h_activas) / 72, 0,25 a 1)  (h_activas = horas de días con trabajo que quedan hasta el reinicio)
#             s_ritmo = atras × cerca
#             bono    = +PESO_BONO_RITMO × max(0, s_ritmo - urgencia7d)    <- sólo lo que la urgencia (que ya premia el cupo que se
#                       pierde pronto) no cubre: así no se cuenta dos veces. La urgencia de la ventana semanal usa h_activas (un reinicio
#                       justo después de una ausencia es más urgente hoy).
#   sesgo del perfil (sólo Claude oficial, perfil ahorro): -SESGO_AHORRO × (1 - max(s_ritmo, urgencia7d)): el atraso o la urgencia lo levantan.
# Perfiles: equilibrado = lo de siempre más el ritmo; ahorro = ritmo ×2,5 + sesgo contra Claude + reserva_lider 0,35 + mínimos de
# codigo-acotado/lectura/mecanico una banda más abajo; rendimiento = ritmo ×0,25 y costo ×0,5 (la calidad manda).
PERFILES = {
    "equilibrado": {"ritmo": 1.0, "sesgo": 0.0, "costo": 1.0, "reserva_lider": 0.0, "relaja": False},
    "ahorro":      {"ritmo": 2.5, "sesgo": 25.0, "costo": 1.0, "reserva_lider": 0.35, "relaja": True},
    "rendimiento": {"ritmo": 0.25, "sesgo": 0.0, "costo": 0.5, "reserva_lider": 0.0, "relaja": False},
}

    ("claude-sonnet-5-5",         "sonnet",  "Claude Sonnet 5.5",   "claude",    None,           None,                None),
    ("claude-haiku-5-5",          "haiku",   "Claude Haiku 5.5",    "claude",    None,           None,                None),
    ("agy:claude-opus-5-5",       "opus",    "Claude Opus 5.5 (por Google)",   "google", "claude-gpt", "claude-opus-5-5",   EFFORTS_AGY),
    ("agy:claude-sonnet-5-5",     "sonnet",  "Claude Sonnet 5.5 (por Google)", "google", "claude-gpt", "claude-sonnet-5-5", EFFORTS_AGY),
    ("agy:gpt-oss-120b",          "gpt-oss", "GPT-OSS 120B",        "google",    "claude-gpt",   "gpt-oss-120b",      ("medium",)),
    ("gemini-4-argon",            "argon",   "Gemini 4 Argon",      "google",    "gemini-4-argon", "gemini-4-argon",  EFFORTS_AGY),
    ("gemini-3.8-flash",          "flash",   "Gemini 3.8 Flash",    "google",    "gemini",       "gemini-3.8-flash",  EFFORTS_AGY),
    ("codex:gpt-6.1-sol",         "sol",     "GPT-6.1 Sol (Codex)", "openai",    "codex",        "gpt-6.1-sol",       EFFORTS_CODEX),
    ("codex:gpt-6-astra",         "astra",   "GPT-6 Astra (Codex)", "openai",    "codex",        "gpt-6-astra",       EFFORTS_CODEX),
    ("codex:gpt-6-luna",          "luna",    "GPT-6 Luna (Codex)",  "openai",    "codex",        "gpt-6-luna",        EFFORTS_CODEX),
]


def err(m):
    sys.stderr.write("reparto: %s\n" % m)


@contextlib.contextmanager
def bloqueo(f):
    """flock exclusivo sobre `<f>.lock` mientras se lee-modifica-reemplaza `f` (el rename atómico sigue: el lock
    es de un archivo aparte porque el rename cambia el inodo de `f`). Sin poder bloquear, sigue sin lock."""
    fd = None
    try:
        fd = os.open(f + ".lock", os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
    except OSError:
        pass
    try:
        yield
    finally:
        if fd is not None:
            os.close(fd)   # cerrar suelta el flock


# --- cuentas (bin/cuentas) ---------------------------------------------------------------------------
_CUENTAS = []


def mod_cuentas():
    """El módulo bin/cuentas (mismo directorio; REPARTO_CUENTAS_BIN para tests). None si no está o falla."""
    if not _CUENTAS:
        p = os.environ.get("REPARTO_CUENTAS_BIN") or os.path.join(os.path.dirname(os.path.realpath(__file__)), "cuentas")
        try:
            ld = importlib.machinery.SourceFileLoader("cuentas_trama", p)
            spec = importlib.util.spec_from_loader("cuentas_trama", ld)
            m = importlib.util.module_from_spec(spec)
            ld.exec_module(m)
            _CUENTAS.append(m)
        except Exception:
            _CUENTAS.append(None)
    return _CUENTAS[0]


def lista_cuentas():
    """Las cuentas de bin/cuentas; sin módulo, sólo las de siempre (claude y google, sin carpeta)."""
    m = mod_cuentas()
    if m:
        try:
            return m.cargar()
        except Exception as e:
            err("no pude leer las cuentas: %s" % e)
    return [{"id": "claude", "proveedor": "claude", "motor": "claude", "nombre": "Claude", "dir": None, "defecto": True},
            {"id": "google", "proveedor": "google", "motor": "agy", "nombre": "Google AI Pro", "dir": None, "defecto": True}]


def env_cuenta(c):
    m = mod_cuentas()
    if not c or c.get("defecto") or not m:
        return None
    try:
        return m.env_de(c)
    except Exception:
        return None


PROVEEDORES = ("claude", "google", "chatgpt")


def prov_de(s):
    """Proveedor de una suscripción de --cupos (la forma vieja sólo tiene id claude / google)."""
    return s.get("proveedor") or s.get("id")


def cuenta_de(s):
    return s.get("cuenta") or s.get("id") or prov_de(s)


def suf(cuenta):
    """Sufijo de las claves de grupo (carga, agotados, asignaciones): nada para la cuenta de siempre (también la de OpenCode)."""
    return "" if not cuenta or cuenta in PROVEEDORES or cuenta in ("openai", "opencode") else "@" + cuenta


# --- configuración -----------------------------------------------------------------------------------
def ruta_modelos():
    xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")   # igual que pa y trama-estado
    return os.environ.get("TRAMA_MODELOS") or os.path.join(xdg, "trama", "modelos.json")


def _cargar_config():
    """Defaults mezclados con las claves nuevas de modelos.json. Inválido: una línea y defaults."""
    cfg = {
        "calidad_usuario": set(),
        "calidad": {k: vieja_a_aa(v) for k, v in CALIDAD.items()}, "minimo_por_tipo": dict(MINIMO_POR_TIPO), "solo_en": dict(SOLO_EN),
        "effort_por_tipo": dict(EFFORT_POR_TIPO), "costo": dict(COSTO), "reserva": RESERVA,
        "reparto": "auto", "grupos_hasta": dict(GRUPOS_HASTA), "hasta_pisado": {}, "workers": {}, "locales": [],
        "llena": LLENA, "peso_urgencia": PESO_URGENCIA, "peso_costo": PESO_COSTO, "peso_carga": PESO_CARGA,
        "preferido_por_tipo": dict(PREFERIDO_POR_TIPO),
        "agy_min_libre_5h": AGY_MIN_LIBRE_5H, "agy_min_libre_tipos": list(AGY_MIN_LIBRE_TIPOS),
        "excluir": [], "permitir_max": False, "efforts_permitidos": {},
        "uso_por_modelo": list(USO_POR_MODELO.items()), "tipos_poco_importantes": list(TIPOS_POCO_IMPORTANTES),
        "tipos_finales": list(TIPOS_FINALES), "sin_cupo": "otro", "sin_cupo_de": "default",
        "perfil": PERFIL_DEFECTO, "reserva_lider": None, "peso_ritmo": PESO_RITMO, "peso_bono_ritmo": PESO_BONO_RITMO,
        "opencode_plan": "gratis",
    }
    p = ruta_modelos()
    if not os.path.isfile(p):
        return cfg
    try:
        with open(p) as f:
            j = json.load(f)
        if not isinstance(j, dict):
            raise ValueError("no es un objeto")
    except Exception as e:
        err("%s no se pudo leer (%s): uso los defaults" % (p, e))
        return cfg
    malo = invalido(j)
    if malo:
        err("%s no va (%s): uso los defaults" % (p, malo))
        return cfg
    for k in ("calidad", "minimo_por_tipo", "solo_en", "effort_por_tipo", "costo", "preferido_por_tipo"):
        if isinstance(j.get(k), dict):
            cfg[k].update(j[k])
    # Migración: sin "calidad_unidades": "aa", los números del dueño están en la escala vieja 0-100 y se pasan a unidades de AA al leer.
    nuevo = j.get("calidad_unidades") == "aa"
    esnum = lambda v: isinstance(v, (int, float)) and not isinstance(v, bool)
    cv = (lambda v: v) if nuevo else (lambda v: vieja_a_aa(v) if esnum(v) else v)
    if isinstance(j.get("calidad"), dict):
        for k, v in j["calidad"].items():
            cfg["calidad"][k] = cv(v)
    if isinstance(j.get("minimo_por_tipo"), dict):
        for k, v in j["minimo_por_tipo"].items():
            cfg["minimo_por_tipo"][k] = cv(v)
    if isinstance(j.get("calidad"), dict):
        cfg["calidad_usuario"] = set(j["calidad"])   # lo que fijó el dueño: gana a Artificial Analysis
    if isinstance(j.get("calidad_effort"), dict):   # {"opus": {"low": 80, "high": 95}}: gana a Artificial Analysis para ese esfuerzo
        cfg["calidad_effort_usuario"] = {k: {e: cv(v) for e, v in d.items() if e in EFFORTS_AA and esnum(v)}
                                         for k, d in j["calidad_effort"].items() if isinstance(d, dict)}
    if isinstance(j.get("reserva"), (int, float, dict)) and not isinstance(j.get("reserva"), bool):
        cfg["reserva"] = j["reserva"]   # null o ausente: sin reserva
    if j.get("perfil") in PERFILES:
        cfg["perfil"] = j["perfil"]
    if j.get("opencode_plan") in PLANES_OPENCODE:   # cualquier otra cosa: gratis (Go apagado)
        cfg["opencode_plan"] = j["opencode_plan"]
    if isinstance(j.get("reserva_lider"), (int, float)) and not isinstance(j.get("reserva_lider"), bool):
        cfg["reserva_lider"] = j["reserva_lider"]   # ausente/null: el del perfil
    if isinstance(j.get("excluir"), list):
        cfg["excluir"] = [x.strip().lower() for x in j["excluir"] if x.strip()]
    if isinstance(j.get("permitir_max"), bool):
        cfg["permitir_max"] = j["permitir_max"]
    if isinstance(j.get("efforts_permitidos"), dict):   # {"opus": ["low","high"]}: los esfuerzos que los workers pueden usar (lista vacía = excluido)
        cfg["efforts_permitidos"] = {k.strip().lower(): [e for e in v if e in EFFORTS_AA] for k, v in j["efforts_permitidos"].items()}
    if isinstance(j.get("uso_por_modelo"), dict):   # las reglas del usuario van antes que las de fábrica
        cfg["uso_por_modelo"] = [(k.strip().lower(), v) for k, v in j["uso_por_modelo"].items()] + cfg["uso_por_modelo"]
    for k in ("tipos_poco_importantes", "tipos_finales"):
        if isinstance(j.get(k), list):
            cfg[k] = [x.strip().lower() for x in j[k]]
    if j.get("sin_cupo") in SIN_CUPO:
        cfg["sin_cupo"], cfg["sin_cupo_de"] = j["sin_cupo"], "sin_cupo"
    elif isinstance(j.get("gemini"), dict) and j["gemini"].get("sin_claude") in ("claude", "esperar", "fallar"):
        v = j["gemini"]["sin_claude"]
        cfg["sin_cupo"], cfg["sin_cupo_de"] = ("otro" if v == "claude" else v), "gemini.sin_claude"
    if j.get("reparto") in ("auto", "fijo"):
        cfg["reparto"] = j["reparto"]
    if isinstance(j.get("grupos_hasta"), dict):   # {"claude-gpt": "2026-11-02"|null}: cuándo vence cada grupo
        for gid, h in j["grupos_hasta"].items():
            if h is None or isinstance(h, str):
                cfg["grupos_hasta"][gid] = cfg["hasta_pisado"][gid] = h
    if isinstance(j.get("grupos"), dict):   # {"claude-gpt": {"hasta": "2026-11-02"|null}}
        for gid, g in j["grupos"].items():
            if isinstance(g, dict) and "hasta" in g:
                cfg["grupos_hasta"][gid] = cfg["hasta_pisado"][gid] = g["hasta"]
    if isinstance(j.get("workers"), dict):
        cfg["workers"] = j["workers"]
    if isinstance(j.get("locales"), list):
        cfg["locales"] = [x for x in j["locales"] if isinstance(x, dict) and x.get("id")]
    for k in ("llena", "peso_urgencia", "peso_costo", "peso_carga", "agy_min_libre_5h", "peso_ritmo", "peso_bono_ritmo"):
        if isinstance(j.get(k), (int, float)) and not isinstance(j.get(k), bool):
            cfg[k] = j[k]
    if isinstance(j.get("agy_min_libre_tipos"), list):
        cfg["agy_min_libre_tipos"] = [str(x) for x in j["agy_min_libre_tipos"]]
    return cfg


# --- Artificial Analysis (inteligencia medida) ------------------------------------------------------
# La app (electron/artificial-analysis.ts) baja los índices de Artificial Analysis (con la key del dueño, una
# vez por día) y deja el resultado en <state>/aa-modelos.json; reparto sólo LEE ese archivo (REPARTO_AA=<archivo> lo cambia, "0" lo
# apaga). Acá vive el emparejamiento de nombres porque acá se conocen los ids de los modelos (los de opencode aparecen solos).
# SIN calibración: la inteligencia de un modelo es el índice de inteligencia general de AA, para todos los modelos y todos los esfuerzos (es lo que
# AA mide completo). Coding, agentic, costo, tokens y tiempo por tarea son extras que se muestran si existen; una entrada sin índice de
# inteligencia no entra. Lo que la API de AA no trae lo completa `datos/aa-suplemento.json` (cargado a mano; la API manda). Los mínimos por tipo ("sonnet", "haiku", "argon") valen el índice de inteligencia de esa familia
# al esfuerzo del tipo. Precedencia de `calidad`: modelos.json (usuario) > Artificial Analysis > defaults > estimación por el nombre
# (esos dos últimos, convertidos con vieja_a_aa: ver "unidades de la inteligencia").
AA_PREFIJOS = re.compile(r"^(?:opencode|dsh|agy|codex|ollama):")
# Niveles de esfuerzo con los que AA etiqueta sus variantes ("minimal" cuenta como low). "max" sólo vale entre paréntesis, con la
# palabra "effort" o como sufijo del slug cuando existe el modelo sin él (Kimi K3 Max es un modelo, no un esfuerzo).
AA_NIVELES = {"minimal": "low", "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max"}
AA_NIVELES_SUFIJO = frozenset(k for k in AA_NIVELES if k != "max")
# Palabras que describen el MODO de una variante, no el modelo: no cuentan en el emparejamiento ("adaptive", "thinking"...).
# Los tamaños y variantes (flash, mini, lite, nano, small, air, 120b...) NO están acá: dos modelos con distinto tamaño nunca se juntan.
AA_CALIFICADORES = frozenset(("reasoning", "thinking", "adaptive", "effort", "non", "nonreasoning", "default", "fallback"))
EFFORT_TABLA = "high"   # el esfuerzo con que --tabla muestra la inteligencia de cada modelo (el de debug, diseno, codigo-multi, frontend y final)
EFFORTS_AA = ("low", "medium", "high", "xhigh", "max")   # de menos a más; "none" (Non-reasoning) no entra al mapa por effort
# "Reasoning" / "Thinking" / "Adaptive" sin nivel = el modelo en su effort por defecto: se toma como `high`. Una entrada pelada (sin
# ninguna etiqueta) de un modelo claude/gpt/codex/gemini también se toma como `high`, pero sólo si no hay otra variante medida en high.
AA_NIVEL_DEFECTO = "high"
AA_CON_NIVEL_DEFECTO = re.compile(r"claude|gpt|codex|gemini|(?<![a-z])o\d")
AA_PRIORIDAD = {"explicito": 3, "defecto": 2, "sin_razonar": 1, "pelado": 0}


def aa_pelar(toks):
    """Saca del final los calificadores de modo y de esfuerzo (`adaptive`, `thinking`, `-high`, `max effort`...). Nunca vacía la lista."""
    toks = list(toks)
    while len(toks) > 1:
        t = toks[-1]
        if t == "effort":
            toks.pop()
            if len(toks) > 1 and toks[-1] in AA_NIVELES:
                toks.pop()
        elif t in AA_CALIFICADORES or t in AA_NIVELES_SUFIJO:
            toks.pop()
        else:
            break
    return toks


def aa_tokens(nombre):
    """Nombre o id (de Trama o de Artificial Analysis) -> lista de tokens normalizados, o [] si no queda nada.
    Minúsculas; sin prefijos de proveedor (`opencode:opencode/`, `dsh:<p>/`, `agy:`, `codex:`, `ollama:`); sin paréntesis
    ("(OpenCode, gratis)", "(Reasoning)"); sin `free`, sin fechas de 8 dígitos ni calificadores de modo/esfuerzo al final (`-high`,
    `-thinking`, `adaptive`, `max effort`); puntuación = separador, salvo el punto de una versión (3.8); dos números sueltos
    seguidos son una versión ("5-5" = "5.5", y "v2-6" = "v2.6", "k2-5" = "k2.5"). Tamaños y variantes (flash, mini, 120b) se conservan."""
    s = (nombre or "").strip().lower()
    s = re.sub(r"\([^)]*\)", " ", s)
    while AA_PREFIJOS.match(s):
        s = AA_PREFIJOS.sub("", s, count=1)
    s = s.split("/")[-1]
    s = re.sub(r"\bx[- ]high\b", "xhigh", s)
    s = re.sub(r"\bextra[- ]high\b", "xhigh", s)
    s = re.sub(r"\bno[- ]?(?:thinking|reasoning)\b", "nonreasoning", s)
    toks = [t.strip(".") for t in re.split(r"[^a-z0-9.]+", s)]
    toks = [t for t in toks if t and t != "free" and not re.fullmatch(r"20\d{6}", t)]
    out = []
    for t in toks:
        if out and re.fullmatch(r"\d{1,2}", t) and re.fullmatch(r"(?:[a-z]{1,8})?\d{1,2}", out[-1]):
            out[-1] = "%s.%s" % (out[-1], t)
        else:
            out.append(t)
    return aa_pelar(out)


def _num(v):
    """float si v es un número de verdad (no bool, no NaN), si no None."""
    return float(v) if isinstance(v, (int, float)) and not isinstance(v, bool) and v == v else None


def aa_puntaje_m(m):
    """(puntaje, métrica) de un modelo de AA: su ÍNDICE DE INTELIGENCIA general, métrica "int", para todos los modelos y esfuerzos. Coding y
    agentic NO son base (a lo sumo extras: ver aa_indice). Sin índice de inteligencia, None."""
    i = _num(m.get("intelligence"))
    return (i, "int") if i is not None else None


def aa_puntaje(m):
    """Puntaje de un modelo de AA (ver aa_puntaje_m)."""
    r = aa_puntaje_m(m)
    return r[0] if r else None


def _aa_texto(s):
    s = (s or "").lower()
    s = re.sub(r"\bx[- ]high\b", "xhigh", s)
    return re.sub(r"\bextra[- ]high\b", "xhigh", s)


def aa_esfuerzo_info(m):
    """(nivel, tipo) de una entrada de AA. nivel: "low"|"medium"|"high"|"xhigh"|"max" o None. tipo: "explicito" (dice el nivel:
    "(high)", "(Adaptive Reasoning, Max Effort)", "Low effort", slug -low/-medium/-high/-xhigh/-minimal), "defecto" ("Reasoning" /
    "Thinking" / "Adaptive" sin nivel: es el effort por defecto del modelo y se toma como `high`), "sin_razonar" ("Non-reasoning", con
    o sin nivel) o "pelado" (sin ninguna etiqueta)."""
    campos = [_aa_texto(m.get("name")), _aa_texto(m.get("slug"))]
    sin = any(re.search(r"non[- ]?(?:reasoning|thinking)|no[- ]?(?:reasoning|thinking)", c) for c in campos)
    nivel = None
    for c in campos:   # 1. dentro de un paréntesis
        for par in re.findall(r"\(([^)]*)\)", c):
            nivel = next((AA_NIVELES[t] for t in re.split(r"[^a-z0-9]+", par) if t in AA_NIVELES), None)
            if nivel:
                break
        if nivel:
            break
    if nivel is None:   # 2. "<nivel> effort" / "effort: <nivel>"
        for c in campos:
            mo = re.search(r"\b(minimal|low|medium|high|xhigh|max)[ -]+(?:reasoning[ -]+)?effort\b", c) or re.search(r"\beffort[ :=-]+(minimal|low|medium|high|xhigh|max)\b", c)
            if mo:
                nivel = AA_NIVELES[mo.group(1)]
                break
    if nivel is None:   # 3. sufijo del nombre o del slug (sin max, que puede ser parte del nombre)
        for c in campos:
            toks = [t for t in re.split(r"[^a-z0-9]+", re.sub(r"\([^)]*\)", " ", c)) if t]
            i = len(toks)
            while i > 1 and (toks[i - 1] in AA_CALIFICADORES or toks[i - 1] in AA_NIVELES_SUFIJO):
                if nivel is None and toks[i - 1] in AA_NIVELES_SUFIJO:
                    nivel = AA_NIVELES[toks[i - 1]]
                i -= 1
            if nivel:
                break
    if nivel:
        return nivel, ("sin_razonar" if sin else "explicito")
    if sin:
        return None, "sin_razonar"
    if re.search(r"reasoning|thinking|adaptive", " ".join(campos)):
        return AA_NIVEL_DEFECTO, "defecto"
    return None, "pelado"


def aa_esfuerzo(m):
    """Esfuerzo de una entrada de AA por su nombre o slug: "low"|"medium"|"high"|"xhigh"|"max" (ver aa_esfuerzo_info; "Reasoning" sin
    nivel vale "high"), "none" si es Non-reasoning sin nivel, o None si no dice (la entrada pelada sólo cuenta para el mejor puntaje)."""
    nivel, tipo = aa_esfuerzo_info(m)
    if nivel:
        return nivel
    return "none" if tipo == "sin_razonar" else None


def aa_indice(modelos):
    """({tokens unidos: {métrica: (puntaje, nombre, slug)}}, {frozenset(tokens): ...}, {tokens unidos: {esfuerzo: (prioridad, puntaje)}}, {frozenset: ...}).
    La única métrica es "int" (índice de inteligencia general). Si varios caen en la misma clave (Reasoning y Non-reasoning, esfuerzos)
    gana el de más puntaje; los dos últimos guardan el puntaje de cada esfuerzo conocido: gana la variante mejor etiquetada
    (explícita > "Reasoning" sin nivel > Non-reasoning con nivel > pelada) y, a igual etiqueta, el mayor puntaje."""
    ents = []
    for m in modelos:
        pm = aa_puntaje_m(m)
        if pm is None:
            continue
        ents.append((m, pm, [aa_tokens(m.get("name")), aa_tokens(m.get("slug"))]))
    bases = {" ".join(tk) for _, _, tks in ents for tk in tks if tk}
    exacto, conjunto, ex_ef, co_ef = {}, {}, {}, {}
    for m, (p, met), tks in ents:
        nivel, tipo = aa_esfuerzo_info(m)
        if nivel is None and tipo != "sin_razonar" and tks[0][-1:] != ["max"] and len(tks[1]) > 2 and tks[1][-1] == "max" and " ".join(aa_pelar(tks[1][:-1])) in bases:
            nivel, tipo = "max", "explicito"   # slug "...-max" y existe el modelo sin max: es el esfuerzo, no parte del nombre
            tks[1] = aa_pelar(tks[1][:-1])
        if nivel is None and tipo == "pelado" and AA_CON_NIVEL_DEFECTO.search(((m.get("name") or "") + " " + (m.get("slug") or "")).lower()):
            nivel = AA_NIVEL_DEFECTO
        prio = AA_PRIORIDAD[tipo]
        # La base es siempre la inteligencia (`p`); coding, agentic, costo, tokens y tiempo por tarea son extras que se muestran si existen.
        extra = {k: _num(m.get(k)) for k in ("coding", "agentic", "cost", "tokens", "time") if _num(m.get(k)) is not None}
        extra["intel"] = p
        if m.get("_suplemento"):
            extra["suplemento"] = True
            if m.get("aproximado"):
                extra["aproximado"] = True
        for tk in tks:
            if not tk:
                continue
            for d, de, k in ((exacto, ex_ef, " ".join(tk)), (conjunto, co_ef, frozenset(tk))):
                e = d.setdefault(k, {})
                if met not in e or p > e[met][0]:
                    e[met] = (p, m.get("name") or m.get("slug"), m.get("slug") or "")
                if nivel in EFFORTS_AA:
                    ef = de.setdefault(k, {})
                    if nivel not in ef or (prio, p) > ef[nivel][:2]:
                        ef[nivel] = (prio, p, extra)
    return exacto, conjunto, ex_ef, co_ef


def aa_entrada(aa, mid):
    """({métrica: (puntaje, nombre, slug)}, clave de efforts) de ese id en AA, o (None, None). Primero el nombre normalizado igual;
    después los mismos tokens en otro orden. Nada más: sin parecidos (un tamaño o una variante distinta es otro modelo)."""
    tk = aa_tokens(mid)
    if not aa or not tk:
        return None, None
    k1 = " ".join(tk)
    if k1 in aa["exacto"]:
        return aa["exacto"][k1], ("ex", k1)
    k2 = frozenset(tk)
    if k2 in aa["conjunto"]:
        return aa["conjunto"][k2], ("co", k2)
    return None, None


def aa_buscar(aa, mid):
    """(índice de inteligencia, nombre en AA, "int") de ese id (el mejor esfuerzo medido), o None."""
    e, _ = aa_entrada(aa, mid)
    if not e or "int" not in e:
        return None
    return (e["int"][0], e["int"][1], "int")


def aa_buscar_efforts(aa, mid):
    """{esfuerzo: índice de inteligencia} MEDIDOS de ese id en AA (puede ser {}), con el mismo emparejamiento que aa_buscar."""
    e, clave = aa_entrada(aa, mid)
    if not e:
        return {}
    return {nivel: v[1] for nivel, v in aa["ex_ef" if clave[0] == "ex" else "co_ef"].get(clave[1], {}).items()}


def aa_buscar_extras(aa, mid):
    """{esfuerzo: {"intel", "coding", "agentic", "cost", "tokens", "time", "suplemento", "aproximado"}} de ese id (coding/agentic: índices de AA; costo USD,
    tokens y segundos por tarea: sólo los que se tengan; suplemento: sale de la tabla manual; puede ser {})."""
    e, clave = aa_entrada(aa, mid)
    if not e:
        return {}
    return {nivel: dict(v[2]) for nivel, v in aa["ex_ef" if clave[0] == "ex" else "co_ef"].get(clave[1], {}).items()}


SUPLEMENTO_ARCHIVO = os.path.join("datos", "aa-suplemento.json")


def aa_suplemento_ruta():
    """Dónde está la tabla suplementaria manual: REPARTO_AA_SUPLEMENTO (archivo; "0" la apaga) o datos/aa-suplemento.json junto a bin/ (o a la
    carpeta del enlace). None si no existe."""
    env = os.environ.get("REPARTO_AA_SUPLEMENTO")
    if env == "0":
        return None
    if env:
        return env
    aqui = os.path.dirname(os.path.realpath(__file__))
    for base in (os.path.join(aqui, ".."), aqui):
        r = os.path.normpath(os.path.join(base, SUPLEMENTO_ARCHIVO))
        if os.path.isfile(r):
            return r
    return None


def aa_suplemento():
    """(fecha, fuente, [modelos]) de la tabla suplementaria manual: modelos que la API de AA no trae (o esfuerzos que le faltan). Mismo formato que
    una entrada de la API (name, slug, intelligence y, si se tienen, coding, agentic, cost, time, tokens) más "aproximado": true si la cifra es ~.
    Para ampliarla basta agregar entradas a datos/aa-suplemento.json. Sin archivo o roto: (None, None, [])."""
    ruta = aa_suplemento_ruta()
    if not ruta:
        return None, None, []
    try:
        with open(ruta) as f:
            j = json.load(f)
        ms = [dict(m, _suplemento=True) for m in j["modelos"] if isinstance(m, dict) and aa_puntaje_m(m)]
        return str(j.get("fecha") or "")[:10] or None, str(j.get("fuente") or "") or None, ms
    except Exception:
        return None, None, []


def aa_cargar():
    """El índice de <state>/aa-modelos.json (+ la tabla suplementaria): {"fecha", "exacto", "conjunto", "ex_ef", "co_ef", "suplemento"}, o None
    (sin archivo, roto o sin modelos). Todo en unidades reales de AA: sin calibración. La base es el índice de INTELIGENCIA; por esfuerzo se
    guardan además coding, agentic, costo, tokens y tiempo, los que haya. La API manda: una entrada del suplemento (mismo modelo y mismo
    esfuerzo) sólo se usa si la API no trae esa entrada; si la trae pero le faltan costo/tokens/tiempo, se los completa."""
    ruta = os.environ.get("REPARTO_AA") or os.path.join(state_dir(), "aa-modelos.json")
    if ruta == "0":
        return None
    try:
        with open(ruta) as f:
            j = json.load(f)
        modelos = [m for m in j["modelos"] if isinstance(m, dict)]
    except Exception:
        return None
    fecha_s, fuente_s, supl = aa_suplemento()
    if supl:
        def clave(m):
            return (" ".join(aa_tokens(m.get("name")) or aa_tokens(m.get("slug"))), aa_esfuerzo_info(m)[0])
        api = {}
        for m in modelos:
            if aa_puntaje_m(m):
                api.setdefault(clave(m), m)
        for m in supl:
            k = clave(m)
            if k in api:
                for campo in ("cost", "tokens", "time"):
                    if _num(api[k].get(campo)) is None and _num(m.get(campo)) is not None:
                        api[k][campo] = m[campo]   # completa lo que la API no trae (el puntaje y lo demás es de la API)
            else:
                modelos.append(m)
    exacto, conjunto, ex_ef, co_ef = aa_indice(modelos)
    if not exacto:
        return None
    return {"fecha": str(j.get("fetched") or "")[:10] or None, "exacto": exacto, "conjunto": conjunto, "ex_ef": ex_ef, "co_ef": co_ef,
            "suplemento": {"fecha": fecha_s, "fuente": fuente_s} if supl else None}


def aa_calidad(aa, mid):
    """(puntaje de AA en unidades reales, nombre en AA) de ese id, o None si AA no lo conoce. Es el MEJOR puntaje medido (el de más esfuerzo):
    sólo vale cuando no hay desglose por esfuerzo; con desglose se usa el del esfuerzo que corre (calidad_en_effort). Siempre es el índice de
    inteligencia general."""
    r = aa_buscar(aa, mid)
    if not r:
        return None
    return (_n(max(0.0, r[0])), r[1])


def aa_calidad_efforts(aa, mid):
    """{esfuerzo: índice de inteligencia} de los esfuerzos que AA midió (o que trae la tabla suplementaria) para ese id ({} si ninguno). Nunca baja al subir el esfuerzo (un effort más
    alto no puede valer menos que uno más bajo: si AA los midió en modos distintos, el más bajo se acota)."""
    if not aa:
        return {}
    out = MapaEf((e, _n(max(0.0, p))) for e, p in aa_buscar_efforts(aa, mid).items() if e in EFFORTS_AA)
    tope = None
    for e in reversed(EFFORTS_AA):
        if e in out:
            tope = out[e] = out[e] if tope is None else min(out[e], tope)
    out.rel = aa_pendiente(aa, mid)
    return out


class MapaEf(dict):
    """{esfuerzo: calidad medida} con `rel(medido, objetivo)`: la razón (puntaje en `objetivo` / puntaje en `medido`) promedio de otros modelos, para
    estimar los esfuerzos que faltan (ver calidad_en_effort). Sin `rel`, el mapa sólo interpola."""
    rel = None


def _curva_llena(v):
    """Una curva {esfuerzo: puntaje} con los esfuerzos que caen ENTRE los medidos interpolados (por posición); fuera del rango no se inventa nada."""
    out = dict(v)
    ids = sorted(EFFORTS_AA.index(e) for e in v)
    for i in range(ids[0], ids[-1] + 1):
        e = EFFORTS_AA[i]
        if e not in out:
            a = max(j for j in ids if j < i)
            b = min(j for j in ids if j > i)
            out[e] = v[EFFORTS_AA[a]] + (v[EFFORTS_AA[b]] - v[EFFORTS_AA[a]]) * (i - a) / (b - a)
    return out


def aa_pendiente(aa, mid):
    """Función rel(medido, objetivo) -> razón promedio puntaje[objetivo] / puntaje[medido] entre los modelos de AA con DOS o más esfuerzos medidos
    (distintos de `mid`), en este orden: los de la misma empresa y generación, los de la misma empresa, todos. None si ningún modelo da esa razón.
    Empresa = primer token del nombre; generación = su último token si es una versión (5.5, v4.1)."""
    if not aa:
        return None
    tk = aa_tokens(mid)
    if not tk:
        return None
    propio = " ".join(tk)
    gen_de = lambda t: t[-1] if len(t) > 1 and re.fullmatch(r"v?\d+(?:\.\d+)?", t[-1]) else None
    curvas = []
    for k, ef in aa.get("ex_ef", {}).items():
        if k == propio or len(ef) < 2:
            continue
        t = k.split()
        curvas.append((t[0], gen_de(t), _curva_llena({e: v[1] for e, v in ef.items()})))

    def rel(m, e):
        for filtro in (lambda c: c[0] == tk[0] and gen_de(tk) is not None and c[1] == gen_de(tk), lambda c: c[0] == tk[0], lambda c: True):
            rs = [c[2][e] / c[2][m] for c in curvas if filtro(c) and e in c[2] and m in c[2] and c[2][m] > 0]
            if rs:
                return sum(rs) / len(rs)
        return None
    return rel


def calidad_en_effort(mapa, effort, base):
    """Calidad para un effort: la medida si está; si falta, ESTIMADA (quien la muestre debe decir "estimado" cuando `effort` no está en `mapa`).
    Entre dos medidos, interpolada (por posición en low<medium<high<xhigh<max). Con un solo medido, o fuera del rango medido, se extrapola desde el
    medido más cercano con la pendiente RELATIVA de otros modelos (`mapa.rel`, ver aa_pendiente); nunca por encima del medido para un esfuerzo más
    alto ni por debajo para uno más bajo. Sin `rel` (mapa común), el medido más cercano; sin mapa o effort desconocido, `base` (la mejor)."""
    if not mapa or effort not in EFFORTS_AA:
        return base
    if effort in mapa:
        return mapa[effort]
    i = EFFORTS_AA.index(effort)
    ant = [(EFFORTS_AA.index(e), v) for e, v in mapa.items() if e in EFFORTS_AA and EFFORTS_AA.index(e) < i]
    sig = [(EFFORTS_AA.index(e), v) for e, v in mapa.items() if e in EFFORTS_AA and EFFORTS_AA.index(e) > i]
    if ant and sig:
        (i0, v0), (i1, v1) = max(ant), min(sig)
        return _n(v0 + (v1 - v0) * (i - i0) / (i1 - i0))
    cerca = max(ant) if ant else min(sig) if sig else None
    if cerca is None:
        return base
    rel = getattr(mapa, "rel", None)
    r = rel(EFFORTS_AA[cerca[0]], effort) if rel else None
    if r is None:
        return cerca[1]
    v = cerca[1] * r
    return _n(max(v, cerca[1]) if i > cerca[0] else min(v, cerca[1]))


def cargar_config():
    """La config de siempre más la inteligencia de Artificial Analysis (si hay caché) para las familias de FAMILIAS que el dueño
    no fijó. `origen[clave]` = "usuario" | "artificial-analysis" | "defecto"; lo que no está ahí es "estimada"."""
    cfg = _cargar_config()
    cfg["aa"] = aa = aa_cargar()
    cfg["origen"] = {k: ("usuario" if k in cfg["calidad_usuario"] else "defecto") for k in cfg["calidad"]}
    cfg.setdefault("calidad_effort_usuario", {})
    cfg["calidad_ef"] = {}   # {familia: {esfuerzo: calidad}} de AA (sólo las que no fijó el dueño)
    if aa:
        for base, fam, *_ in FAMILIAS:
            if fam in cfg["calidad_usuario"] or cfg["origen"].get(fam) == "artificial-analysis":
                continue
            r = aa_calidad(aa, base)
            if r:
                cfg["calidad"][fam], cfg["origen"][fam] = r[0], "artificial-analysis"
                cfg["calidad_ef"][fam] = aa_calidad_efforts(aa, base)
    return cfg


def mapa_efforts(cfg, clave, mid=None):
    """{esfuerzo: calidad} de una familia (o de un id, `mid`, para dsh/opencode). Precedencia: el dueño por esfuerzo (modelos.json
    "calidad_effort": {"opus": {"low": 80}}) > Artificial Analysis. Una `calidad` fija del dueño sin mapa por esfuerzo vale para todos
    (mapa vacío); con mapa por esfuerzo del dueño, los esfuerzos que no puso vuelven a esa calidad fija."""
    usr = cfg.get("calidad_effort_usuario", {}).get(clave) or {}
    if clave in cfg.get("calidad_usuario", set()) or (mid and clave == mid and calidad_origen(cfg, mid)[1] == "usuario"):
        base = {e: cfg["calidad"][clave] for e in EFFORTS_AA if usr and isinstance(cfg["calidad"].get(clave), (int, float))}
    elif mid:
        base = aa_calidad_efforts(cfg.get("aa"), mid)
    else:
        base = cfg.get("calidad_ef", {}).get(clave, {})
    out = MapaEf(dict(base, **usr))
    out.rel = getattr(base, "rel", None) if not usr else None   # con valores del dueño por esfuerzo no se mezcla con la pendiente de AA
    return out



def invalido(j):
    """Las claves nuevas (2026-10-24) con un valor que no va -> qué está mal (como la validación de pa)."""
    num = lambda v: isinstance(v, (int, float)) and not isinstance(v, bool) and 0 <= v < 1
    r = j.get("reserva")
    if r is not None and not num(r) and not (isinstance(r, dict) and r and set(r) <= {"5h", "7d"}
                                             and all(num(v) for v in r.values())):
        return "reserva %s (un número de 0 a 1, {\"5h\":…,\"7d\":…} o null)" % json.dumps(r)
    if j.get("perfil") is not None and j["perfil"] not in PERFILES:
        return "perfil %s (equilibrado, ahorro o rendimiento)" % json.dumps(j["perfil"])
    rl = j.get("reserva_lider")
    if rl is not None and not num(rl):
        return "reserva_lider %s (un número de 0 a 1 o null)" % json.dumps(rl)
    e = j.get("excluir")
    if e is not None and not (isinstance(e, list) and all(isinstance(x, str) and x.strip() for x in e)):
        return "excluir %s (una lista de ids o familias)" % json.dumps(e)
    ep = j.get("efforts_permitidos")
    if ep is not None and not (isinstance(ep, dict) and all(isinstance(k, str) and k.strip() and isinstance(v, list) and all(e in EFFORTS_AA for e in v) for k, v in ep.items())):
        return "efforts_permitidos %s (un objeto familia o id → lista de low, medium, high, xhigh, max)" % json.dumps(ep)
    if "permitir_max" in j and not isinstance(j["permitir_max"], bool):
        return "permitir_max %s (true o false)" % json.dumps(j["permitir_max"])
    u = j.get("uso_por_modelo")
    if u is not None and not (isinstance(u, dict) and all(isinstance(k, str) and k.strip() and v in USOS for k, v in u.items())):
        return "uso_por_modelo %s (un objeto modelo → libre, poco_importante o solo_final)" % json.dumps(u)
    for k in ("tipos_poco_importantes", "tipos_finales"):
        t = j.get(k)
        if t is not None and not (isinstance(t, list) and all(isinstance(x, str) and x.strip() for x in t)):
            return "%s %s (una lista de tipos)" % (k, json.dumps(t))
    if j.get("sin_cupo") is not None and j["sin_cupo"] not in SIN_CUPO:
        return "sin_cupo %s (otro, esperar o fallar)" % json.dumps(j["sin_cupo"])
    return None


def familia_de(mid):
    m = (mid or "").lower()
    for f in FAMILIAS_EXCLUIBLES:
        if f in m:
            return f
    return None


def excluido_por(mid, excl, fam=None):
    """La regla de `excluir` que saca a ese id, o None. Regla = familia (opus, flash, gpt-oss…), id exacto
    (también sin el sufijo de effort de agy: agy:claude-opus-5-5 saca a agy:claude-opus-5-5-high) o prefijo
    con * al final (agy:*, ollama:*, gemini-*)."""
    m = (mid or "").lower()
    fam = fam or familia_de(m)
    for p in excl or []:
        if p == fam or p == m or m.startswith(p + "-") or (p.endswith("*") and m.startswith(p[:-1])):
            return p
    return None


def efforts_de(cfg, mid, fam=None):
    """La lista de `efforts_permitidos` de ese modelo (clave = id exacto, si no la familia), o None si no hay regla."""
    ep = cfg.get("efforts_permitidos") or {}
    m = (mid or "").lower()
    base = re.sub(r"-(low|medium|high|xhigh|max)$", "", m)
    for k in (m, base, fam):
        if k and k in ep:
            return ep[k]
    return None


def effort_permitido(cfg, mid, fam, effort, disponibles=EFFORTS_AA):
    """(effort a usar, nota) según `efforts_permitidos`. Si el del tipo no está permitido va el más cercano entre los permitidos
    y disponibles (el siguiente más alto; si no hay, el más alto de los de abajo). (None, nota): lista vacía o ninguno disponible = excluido."""
    perm = efforts_de(cfg, mid, fam)
    if perm is None:
        return effort, None
    ok = [e for e in EFFORTS_AA if e in perm and e in disponibles]
    if not ok:
        return None, "efforts_permitidos deja sin ningún effort a %s" % (fam or mid)
    if effort in ok:
        return effort, None
    i = EFFORTS_AA.index(effort) if effort in EFFORTS_AA else EFFORTS_AA.index("high")
    arriba = [e for e in ok if EFFORTS_AA.index(e) > i]
    nuevo = arriba[0] if arriba else ok[-1]
    return nuevo, "el effort %s del tipo no está permitido en modelos.json (efforts_permitidos): uso %s" % (effort, nuevo)


def uso_de(mid, uso, fam=None):
    """(uso, regla) de `uso_por_modelo` para ese id: la primera regla que coincide. Sin regla: ("libre", None)."""
    for p, v in uso or []:
        if excluido_por(mid, [p], fam):
            return v, p
    return "libre", None


# --- tiempo ------------------------------------------------------------------------------------------
def ahora():
    v = os.environ.get("REPARTO_AHORA")
    if v:
        return parse_iso(v) or datetime.now(timezone.utc)
    return datetime.now(timezone.utc)


def parse_iso(s):
    if not isinstance(s, str) or not s:
        return None
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00")).astimezone(timezone.utc)
    except ValueError:
        return None


def iso(dt):
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ") if dt else None


def humano(horas):
    if horas is None:
        return "?"
    if horas < 1:
        return "%d min" % max(1, round(horas * 60))
    mins = round(horas * 60)
    if horas < 10:
        return "%d h %d min" % (mins // 60, mins % 60) if mins % 60 else "%d h" % (mins // 60)
    if horas < 48:
        return "%d h" % round(horas)
    h = round(horas)
    return "%d d %d h" % (h // 24, h % 24)


# --- cupos -------------------------------------------------------------------------------------------
def ventana(id_, usado, vuelve):
    if usado is not None:
        usado = max(0.0, min(1.0, round(float(usado), 4)))
    return {"id": id_, "usado": usado, "vuelve": vuelve}


def misma_carpeta(a, b):
    try:
        return os.path.realpath(os.path.expanduser(a)) == os.path.realpath(os.path.expanduser(b))
    except Exception:
        return False


def de_la_cuenta(cfgdir, cuenta):
    """Si una sesión de la statusline (su config_dir, vacío = el de siempre) es de esa cuenta."""
    if not cuenta or cuenta.get("defecto"):
        return not cfgdir or misma_carpeta(cfgdir, "~/.claude")
    return bool(cfgdir) and misma_carpeta(cfgdir, cuenta["dir"])


def cupos_claude(estado, now, cuenta=None):
    """Cada ventana sale de la sesión más reciente que traiga ese dato y cuyo reset aún no pasó.
    Dato vencido o ausente: usado null (nunca se inventa). Con varias cuentas, sólo las sesiones de esa cuenta
    (config_dir de la statusline) y su <PA_STATE>/cuentas/<id>/uso.json."""
    pa_state = estado or os.path.expanduser("~/.local/state/pa")
    mejor = {"5h": None, "7d": None}
    claves = {"5h": "five_hour", "7d": "seven_day"}
    ts_now = now.timestamp()

    def ofrecer(wid, ts, pct, reset):
        if not isinstance(pct, (int, float)) or not isinstance(reset, (int, float)) or reset <= ts_now:
            return
        if mejor[wid] is None or ts > mejor[wid][0]:
            mejor[wid] = (ts, pct / 100.0, reset)

    for f in glob.glob(os.path.join(pa_state, "statusline", "*.json")):
        try:
            with open(f) as fh:
                d = json.load(fh)
        except Exception:
            continue
        rl = d.get("rate_limits") if isinstance(d, dict) else None
        if not isinstance(rl, dict) or not de_la_cuenta(d.get("config_dir"), cuenta):
            continue
        ts = d.get("ts") or os.path.getmtime(f)
        for wid, k in claves.items():
            w = rl.get(k)
            if isinstance(w, dict):
                ofrecer(wid, ts, w.get("used_percentage"), w.get("resets_at"))
    hist = os.path.join(pa_state, "statusline", "historial.jsonl")
    try:
        with open(hist) as fh:
            filas = [json.loads(x) for x in fh.read().splitlines()[-200:] if x.strip()]
    except Exception:
        filas = []
    for r in filas:
        if isinstance(r, dict) and de_la_cuenta(r.get("config_dir"), cuenta):
            ofrecer("5h", r.get("ts", 0), r.get("h5"), r.get("h5_reset"))
            ofrecer("7d", r.get("ts", 0), r.get("sem"), r.get("sem_reset"))
    usos = [os.path.join(pa_state, "uso.json")]
    if cuenta and not cuenta.get("defecto"):
        usos = [os.path.join(pa_state, "cuentas", cuenta["id"], "uso.json")]
    elif os.environ.get("HILOS_STATE"):
        usos.append(os.path.join(os.environ["HILOS_STATE"], "uso.json"))
    elif os.path.abspath(pa_state) == os.path.abspath(os.path.expanduser("~/.local/state/pa")):
        usos.append(os.path.expanduser("~/.local/state/hilos/uso.json"))
    else:
        usos.append(os.path.join(pa_state, "hilos", "uso.json"))
    for f in usos:
        try:
            with open(f) as fh:
                d = json.load(fh)
        except Exception:
            continue
        if not isinstance(d, dict):
            continue
        for wid, k in claves.items():
            w = d.get(k)
            if isinstance(w, dict):
                ts = w.get("ts") or d.get("ts") or os.path.getmtime(f)
                ofrecer(wid, ts, w.get("pct"), w.get("resets_at"))
    vent = []
    for wid in ("5h", "7d"):
        m = mejor[wid]
        vent.append(ventana(wid, m[1], iso(datetime.fromtimestamp(m[2], timezone.utc))) if m
                    else ventana(wid, None, None))
    if not cuenta:
        return {"id": "claude", "nombre": "Claude", "ventanas": vent}
    return {"id": cuenta["id"], "nombre": cuenta["nombre"], "proveedor": "claude", "cuenta": cuenta["id"], "ventanas": vent}


def ttl_cache(j):
    """Vida de la caché de /quota: REPARTO_CACHE_S si está seteada; si no 120 s, y 30 s cuando algún grupo
    tiene menos de la mitad de su ventana de 5 h (ahí el cupo se gasta en minutos)."""
    v = os.environ.get("REPARTO_CACHE_S")
    if v:
        return float(v)
    try:
        for g in j["command"]["data"]["groups"]:
            for b in g.get("buckets", []):
                rf = b.get("remaining_fraction")
                if b.get("window") == "5h" and isinstance(rf, (int, float)) and rf < 0.5:
                    return CACHE_CORTA_S
    except Exception:
        pass
    return CACHE_S


def quota_agy(state_dir, now, cuenta=None):
    """JSON de `agy -p /quota` (caché en <state>/quota.json, o quota@<cuenta>.json con el entorno de esa cuenta;
    ver ttl_cache). None si no se pudo."""
    cid = (cuenta or {}).get("id")
    cache = os.path.join(state_dir, "quota%s.json" % suf(cid))
    try:
        with open(cache) as f:
            c = json.load(f)
        if time.time() - c["leido"] <= ttl_cache(c["json"]) and c.get("json"):
            return c["json"]
    except Exception:
        pass
    try:
        r = subprocess.run(["agy", "-p", "/quota", "--output-format", "json"], capture_output=True,
                           text=True, timeout=float(os.environ.get("REPARTO_AGY_S", "40")),
                           stdin=subprocess.DEVNULL, cwd=os.environ.get("TMPDIR", "/tmp"), env=env_cuenta(cuenta))
        j = json.loads(r.stdout)
        if not j.get("command", {}).get("data", {}).get("groups"):
            return None
    except Exception:
        return None
    try:
        os.makedirs(state_dir, exist_ok=True)
        tmp = cache + ".%d" % os.getpid()
        with open(tmp, "w") as f:
            json.dump({"leido": time.time(), "json": j}, f)
        os.replace(tmp, cache)
    except OSError:
        pass
    return j


def id_grupo(nombre):
    n = (nombre or "").lower()
    if "argon" in n:
        return "gemini-4-argon"
    if "claude" in n or "gpt" in n:
        return "claude-gpt"
    return "gemini"


def cupos_google(cfg, state_dir, now, cuenta=None):
    j = quota_agy(state_dir, now, cuenta)
    por_id = {}
    if j:
        for g in j.get("command", {}).get("data", {}).get("groups", []):
            gid = id_grupo(g.get("name"))
            vs = {}
            for b in g.get("buckets", []):
                w = {"weekly": "7d", "5h": "5h"}.get(b.get("window"))
                rf = b.get("remaining_fraction")
                if w and isinstance(rf, (int, float)):
                    vs[w] = ventana(w, 1 - rf, b.get("reset_time"))
            por_id[gid] = vs
    grupos = []
    for gid, nombre, wids, base_modelos in GRUPOS_GOOGLE:
        modelos = []
        for b in base_modelos:
            efs = ("medium",) if "gpt-oss" in b else EFFORTS_AGY
            modelos += ["%s-%s" % (b, e) for e in efs]
        vs = por_id.get(gid, {})
        g = {"id": gid, "nombre": nombre, "modelos": modelos,
             "ventanas": [vs.get(w) or ventana(w, None, None) for w in wids]}
        h = cfg["grupos_hasta"].get(gid)
        if h:
            g["hasta"] = h
        grupos.append(g)
    if not cuenta:
        return {"id": "google", "nombre": "Google AI Pro", "grupos": grupos}
    return {"id": cuenta["id"], "nombre": cuenta["nombre"], "proveedor": "google", "cuenta": cuenta["id"], "grupos": grupos}


def codex_home():
    return os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex")


def agy_disponible():
    """agy en el PATH. Sin él no hay suscripción de Google que ofrecer (ni /quota que leer). Con cupos fijos
    (REPARTO_CUPOS_FIJOS, tests) manda el archivo; REPARTO_AGY=0 lo apaga."""
    if os.environ.get("REPARTO_AGY") == "0":
        return False
    if os.environ.get("REPARTO_CUPOS_FIJOS"):
        return True
    import shutil
    return bool(shutil.which("agy"))


def codex_disponible():
    """codex en el PATH y con credenciales (`codex login` deja CODEX_HOME/auth.json). Sin esto no hay suscripción
    de ChatGPT que mirar: reparto no la lista ni la ofrece."""
    if os.environ.get("REPARTO_CODEX") == "0":
        return False
    import shutil
    return bool(shutil.which("codex")) and os.path.isfile(os.path.join(codex_home(), "auth.json"))


# --- dsh (DeepSeek Harness) --------------------------------------------------------------------------
def dsh_bin():
    """El binario dsh: HILOS_DSH, el PATH, ~/.local/bin, el prefijo global de npm. None si no está (igual que pa y correr.mjs)."""
    h = os.environ.get("HILOS_DSH")
    if h:
        return h if os.access(h, os.X_OK) else None
    import shutil
    c = shutil.which("dsh")
    if c:
        return c
    home = os.path.expanduser("~")
    dirs = [os.path.join(home, ".local", "bin")]
    if os.environ.get("npm_config_prefix"):
        dirs.append(os.path.join(os.environ["npm_config_prefix"], "bin"))
    dirs += [os.path.join(home, ".npm-global", "bin"), "/usr/local/bin"]
    return next((os.path.join(d, "dsh") for d in dirs if os.access(os.path.join(d, "dsh"), os.X_OK)), None)


def dsh_clave(nombre):
    """La key (OPENCODE_API_KEY / DEEPSEEK_API_KEY): el entorno, o el claves.env de Trama (NOMBRE=valor, sin source). Nunca se imprime."""
    if nombre not in ("OPENCODE_API_KEY", "DEEPSEEK_API_KEY"):
        return None
    if os.environ.get(nombre):
        return os.environ[nombre]
    xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    f = os.environ.get("TRAMA_CLAVES") or os.path.join(xdg, "trama", "claves.env")
    v = None
    try:
        with open(f, errors="replace") as fh:
            for ln in fh:
                m = re.match(r"^\s*(?:export\s+)?%s\s*=\s*(.*?)\s*$" % nombre, ln.rstrip("\r\n"))
                if m:
                    v = m.group(1)
                    q = re.match(r"^(['\"])(.*)\1$", v)
                    if q:
                        v = q.group(2)
    except OSError:
        return None
    return v if v and re.match(r"^[A-Za-z0-9._~+/=:-]+$", v) else None


def dsh_ollama_url():
    u = os.environ.get("OLLAMA_HOST") or "http://localhost:11434"
    if not u.startswith("http"):
        u = "http://" + u
    return u.rstrip("/")


def dsh_ollama_modelos(now):
    """Los modelos que Ollama tiene bajados ([] si no responde). Se guardan DSH_CACHE_S (60) s: pa llama a reparto en cada corrida."""
    url = dsh_ollama_url()
    cache = os.path.join(state_dir(), "dsh-ollama.json")
    ttl = float(os.environ.get("REPARTO_DSH_CACHE_S", 60))
    try:
        with open(cache) as f:
            c = json.load(f)
        if c.get("url") == url and now.timestamp() - c.get("t", 0) < ttl:
            return list(c.get("modelos") or [])
    except Exception:
        pass
    try:
        import urllib.request
        with urllib.request.urlopen(url + "/api/tags", timeout=float(os.environ.get("REPARTO_DSH_CHEQUEO_S", 2))) as r:
            modelos = [m.get("name") or m.get("model") for m in json.load(r).get("models", []) if isinstance(m, dict)]
        modelos = [m for m in modelos if m]
    except Exception:
        modelos = []
    try:
        os.makedirs(os.path.dirname(cache), exist_ok=True)
        tmp = "%s.%d" % (cache, os.getpid())
        with open(tmp, "w") as f:
            json.dump({"url": url, "t": now.timestamp(), "modelos": modelos}, f)
        os.replace(tmp, cache)
    except OSError:
        pass
    return modelos


def dsh_estado(now):
    """{ollama: [modelos], opencode: bool, deepseek: bool}: qué de dsh se puede ofrecer. Todo vacío sin dsh instalado."""
    vacio = {"ollama": [], "opencode": False, "deepseek": False}
    if os.environ.get("REPARTO_DSH") == "0" or os.environ.get("REPARTO_SIN_DSH") == "1":
        return vacio
    fijo = os.environ.get("REPARTO_DSH_FIJO")
    if fijo:
        try:
            j = json.loads(fijo)
            return {"ollama": list(j.get("ollama") or []), "opencode": bool(j.get("opencode")), "deepseek": bool(j.get("deepseek"))}
        except Exception:
            return vacio
    if not dsh_bin():
        return vacio
    return {"ollama": dsh_ollama_modelos(now), "opencode": bool(dsh_clave("OPENCODE_API_KEY")),
            "deepseek": bool(dsh_clave("DEEPSEEK_API_KEY"))}


PALABRAS_ALTAS = ("ultra", "super", "pro", "max")
PALABRAS_BAJAS = ("flash", "lightning", "mini", "nano")


def calidad_estimada(mid):
    """Inteligencia (en unidades de AA) por defecto de un modelo sin entrada en `calidad` (los que aparecen solos en `opencode models`): base 50,
    +10 con ultra/super/pro/max en el nombre, -10 con flash/lightning/mini/nano (si trae de las dos, se compensan)."""
    nombre = (mid or "").lower().split("/")[-1]
    palabras = re.split(r"[^a-z0-9]+", nombre)
    q = 50
    if any(p in PALABRAS_ALTAS for p in palabras):
        q += 10
    if any(p in PALABRAS_BAJAS for p in palabras):
        q -= 10
    return vieja_a_aa(q)   # la regla es de la escala vieja; sale en unidades de AA


def calidad_origen(cfg, mid, patrones=True):
    """(calidad, origen) de un modelo por su id: "usuario" (modelos.json: id exacto o, con `patrones`, un patrón con *) > "artificial-analysis"
    (su nombre está en la caché de AA) > "defecto" (exacto o patrón de los defaults) > ("estimada": la estimación por el nombre)."""
    q, usr = cfg["calidad"], cfg.get("calidad_usuario", set())
    if mid in usr and isinstance(q.get(mid), (int, float)):
        return q[mid], "usuario"
    pats = [k for k in q if patrones and k.startswith(("dsh:", "opencode:")) and "*" in k and isinstance(q[k], (int, float))]
    for k in sorted(pats, key=len, reverse=True):   # el más específico (más largo) primero
        if k in usr and fnmatch.fnmatchcase(mid, k):
            return q[k], "usuario"
    r = aa_calidad(cfg.get("aa"), mid)
    if r:
        return r[0], "artificial-analysis"
    if isinstance(q.get(mid), (int, float)):
        return q[mid], "defecto"
    for k in sorted(pats, key=len, reverse=True):
        if fnmatch.fnmatchcase(mid, k):
            return q[k], "defecto"
    return calidad_estimada(mid), "estimada"


def dsh_calidad_info(cfg, mid):
    """(calidad, estimada) de un modelo de dsh/opencode; el origen de la cifra está en calidad_origen."""
    q, o = calidad_origen(cfg, mid)
    return q, o == "estimada"


def dsh_calidad(cfg, mid):
    return dsh_calidad_info(cfg, mid)[0]


def opencode_bin():
    """El binario opencode: HILOS_OPENCODE, el PATH, ~/.opencode/bin, ~/.local/bin, el prefijo global de npm. None si no está (igual que pa y correr.mjs)."""
    h = os.environ.get("HILOS_OPENCODE")
    if h:
        return h if os.access(h, os.X_OK) else None
    import shutil
    c = shutil.which("opencode")
    if c:
        return c
    home = os.path.expanduser("~")
    dirs = [os.path.join(home, ".opencode", "bin"), os.path.join(home, ".local", "bin")]
    if os.environ.get("npm_config_prefix"):
        dirs.append(os.path.join(os.environ["npm_config_prefix"], "bin"))
    dirs += [os.path.join(home, ".npm-global", "bin"), "/usr/local/bin"]
    return next((os.path.join(d, "opencode") for d in dirs if os.access(os.path.join(d, "opencode"), os.X_OK)), None)


def opencode_listado(now):
    """{"gratis": [...], "go": [...] | None}: lo que lista `opencode models`. gratis: `big-pickle` y los `*-free` de `opencode/` (sin el proveedor); go: los de
    `opencode-go/` (sin el proveedor; None si no se sabe, p. ej. una caché de antes de Go). Todo vacío sin opencode. Se guarda 1 h (REPARTO_OPENCODE_CACHE_S)."""
    vacio = {"gratis": [], "go": None}
    if os.environ.get("REPARTO_OPENCODE") == "0" or os.environ.get("REPARTO_SIN_DSH") == "1":
        return vacio
    fijo = os.environ.get("REPARTO_OPENCODE_FIJO")
    if fijo:
        try:
            lista = [m for m in json.loads(fijo) if isinstance(m, str)]
            go = [m.split("/", 1)[1] for m in lista if m.startswith("opencode-go/")]
            return {"gratis": [m.split("/", 1)[1] if m.startswith("opencode/") else m for m in lista if not m.startswith("opencode-go/")], "go": go or None}
        except Exception:
            return vacio
    exe = opencode_bin()
    if not exe:
        return vacio
    cache = os.path.join(state_dir(), "opencode-modelos.json")
    ttl = float(os.environ.get("REPARTO_OPENCODE_CACHE_S", 3600))
    try:
        with open(cache) as f:
            c = json.load(f)
        if c.get("exe") == exe and now.timestamp() - c.get("t", 0) < ttl:
            return {"gratis": list(c.get("modelos") or []), "go": list(c["go"]) if isinstance(c.get("go"), list) else None}
    except Exception:
        pass
    modelos = []
    go = []
    try:
        import subprocess
        r = subprocess.run([exe, "models"], capture_output=True, text=True, timeout=float(os.environ.get("REPARTO_OPENCODE_CHEQUEO_S", 8)), stdin=subprocess.DEVNULL)
        for ln in re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", r.stdout).splitlines():
            m = re.match(r"^opencode/(big-pickle|\S*-free)$", ln.strip())
            if m and m.group(1) not in modelos:
                modelos.append(m.group(1))
            g = re.match(r"^opencode-go/(\S+)$", ln.strip())
            if g and g.group(1) not in go:
                go.append(g.group(1))
    except Exception:
        pass
    modelos = modelos or list(OC_GRATIS_CONOCIDOS)   # opencode no contestó a tiempo: los que se conocen (si fallan, un 429 los agota)
    try:
        os.makedirs(os.path.dirname(cache), exist_ok=True)
        tmp = "%s.%d" % (cache, os.getpid())
        with open(tmp, "w") as f:
            json.dump({"exe": exe, "t": now.timestamp(), "modelos": modelos, "go": go}, f)
        os.replace(tmp, cache)
    except OSError:
        pass
    return {"gratis": modelos, "go": go or None}


def opencode_gratis(now):
    """Los modelos gratis de opencode (`big-pickle` y los `*-free` de `opencode/`, sin el proveedor). [] sin opencode."""
    return opencode_listado(now)["gratis"]


def go_tabla():
    """La tabla de topes de OpenCode Go (motor/opencode/go-topes.json, junto a motor/bin; REPARTO_GO_TABLA la cambia): {"fuente", "fecha", "modelos": [...]}
    o None si no está o no sirve (entonces Go no ofrece nada: no se inventa)."""
    ruta = os.environ.get("REPARTO_GO_TABLA") or os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "opencode", "go-topes.json")
    try:
        with open(ruta) as f:
            t = json.load(f)
        ms = [m for m in t["modelos"] if isinstance(m, dict) and isinstance(m.get("id"), str) and m["id"]]
        return {"fuente": t.get("fuente"), "fecha": t.get("fecha"), "modelos": ms} if t.get("version") == 1 and ms else None
    except Exception:
        return None


def slug_go(s):
    """`opencode:opencode-go/Kimi-K3.1-Pro`, `kimi_k3-1-pro` -> `kimik31pro`: para emparejar la tabla con lo que lista opencode."""
    return re.sub(r"[^a-z0-9]", "", re.sub(r"^(?:opencode:)?(?:opencode-go/)?", "", (s or "").lower()))


def go_modelos(cfg, now):
    """[(id, entrada de la tabla)] de los modelos de Go que se ofrecen: con plan go / go-plus, los de la tabla (y, si `opencode models` ya listó modelos
    de `opencode-go`, sólo los que aparecen, con el id que listó). Sin plan Go, sin opencode o sin tabla: []."""
    if cfg.get("opencode_plan") not in ("go", "go-plus"):
        return []
    if os.environ.get("REPARTO_OPENCODE") == "0" or os.environ.get("REPARTO_SIN_DSH") == "1":
        return []
    if not os.environ.get("REPARTO_OPENCODE_FIJO") and not opencode_bin():
        return []
    tabla = go_tabla()
    if not tabla:
        return []
    listados = opencode_listado(now)["go"]
    out = []
    for m in tabla["modelos"]:
        if listados:
            real = next((l for l in listados if slug_go(l) == slug_go(m["id"])), None)
            if real:
                out.append((real, m))
        else:
            out.append((m["id"], m))
    return out


def go_topes(cfg, mid):
    """Los topes del plan elegido para un modelo de Go (por su id): {"pedidos_5h", "usd_mes"} o None."""
    plan = cfg.get("opencode_plan")
    t = go_tabla() if plan in ("go", "go-plus") else None
    for m in (t or {}).get("modelos", []):
        if slug_go(m["id"]) == slug_go(mid):
            return m.get(plan)
    return None


def dsh_ofertas(cfg, now):
    """[(id, nombre, proveedor, gratis)] de lo que dsh y opencode pueden correr ahora."""
    st = dsh_estado(now)
    out = []
    for m in opencode_gratis(now):
        out.append(("opencode:opencode/%s" % m, "%s (OpenCode, gratis)" % m, "opencode-prog", True))
    # OpenCode Go (sólo con plan go / go-plus): cupo propio por modelo, costo marginal ~0.
    for real, m in go_modelos(cfg, now):
        out.append((OC_GO_PREFIJO + real, "%s (OpenCode Go)" % (m.get("nombre") or real), "opencode-go", False))
    for m in st["ollama"]:
        out.append(("dsh:ollama/%s" % m, "%s (Ollama, dsh)" % m, "ollama", True))
    # Los gratis de OpenCode por dsh: OpenCode los rechaza (429) fuera de su programa; sólo con REPARTO_DSH_OPENCODE=1.
    if st["opencode"] and os.environ.get("REPARTO_DSH_OPENCODE") == "1":
        ids = list(DSH_OPENCODE_GRATIS)
        for k in cfg["calidad"]:   # un modelo gratis que el dueño agregó a `calidad`
            m = re.match(r"^dsh:opencode/([^*]+-free)$", k)
            if m and m.group(1) not in ids:
                ids.append(m.group(1))
        for m in ids:
            out.append(("dsh:opencode/%s" % m, "%s (OpenCode, gratis)" % m, "opencode", True))
    if st["deepseek"]:
        ids = list(DSH_DEEPSEEK)
        for k in cfg["calidad"]:
            m = re.match(r"^dsh:deepseek/([^*]+)$", k)
            if m and m.group(1) not in ids:
                ids.append(m.group(1))
        for m in ids:
            out.append(("dsh:deepseek/%s" % m, "%s (DeepSeek, de pago)" % m, "deepseek", False))
    return out


def claude_instalado():
    """El binario claude. REPARTO_CLAUDE=0 lo apaga. Con cupos fijos (tests) manda el archivo."""
    if os.environ.get("REPARTO_CLAUDE") == "0":
        return False
    if os.environ.get("REPARTO_CUPOS_FIJOS"):
        return True
    import shutil
    return bool(shutil.which("claude")) or any(os.access(os.path.expanduser(f), os.X_OK)
                                              for f in ("~/.local/bin/claude", "~/.claude/local/claude"))


def rate_limits_codex(now):
    """Las ventanas de ChatGPT del último evento token_count de las sesiones de codex (CODEX_HOME/sessions/
    AAAA/MM/DD/rollout-*.jsonl, las escribe codex en cada corrida, también `codex exec`). No gasta nada.
    -> {"5h": ventana, "7d": ventana}; una ventana cuyo reset ya pasó no cuenta (sin dato, como el Claude)."""
    archivos = glob.glob(os.path.join(codex_home(), "sessions", "*", "*", "*", "rollout-*.jsonl"))
    try:
        archivos.sort(key=os.path.getmtime, reverse=True)
    except OSError:
        pass
    for f in archivos[:8]:
        try:
            with open(f, errors="replace") as fh:
                filas = fh.read().splitlines()[-400:]
        except OSError:
            continue
        for linea in reversed(filas):
            if "rate_limits" not in linea:
                continue
            try:
                ev = json.loads(linea)
            except ValueError:
                continue
            pl = ev.get("payload") if isinstance(ev.get("payload"), dict) else ev
            rl = pl.get("rate_limits") if isinstance(pl, dict) else None
            if not isinstance(rl, dict):
                continue
            t_ev = parse_iso(ev.get("timestamp")) or datetime.fromtimestamp(os.path.getmtime(f), timezone.utc)
            out = {}
            for k in ("primary", "secondary"):
                w = rl.get(k)
                if not isinstance(w, dict) or not isinstance(w.get("used_percent"), (int, float)):
                    continue
                mins = w.get("window_minutes")
                wid = "5h" if isinstance(mins, (int, float)) and mins <= 720 else ("7d" if mins else
                                                                                    ("5h" if k == "primary" else "7d"))
                ra = w.get("resets_at")
                if isinstance(ra, (int, float)):
                    vuelve = datetime.fromtimestamp(ra, timezone.utc)
                elif isinstance(ra, str):
                    vuelve = parse_iso(ra)
                elif isinstance(w.get("resets_in_seconds"), (int, float)):
                    vuelve = t_ev + timedelta(seconds=w["resets_in_seconds"])
                else:
                    vuelve = None
                if vuelve is not None and vuelve <= now:
                    continue
                out[wid] = ventana(wid, w["used_percent"] / 100.0, iso(vuelve))
            if out:
                return out
    return {}


def cupos_openai(cfg, now):
    vs = rate_limits_codex(now)
    grupos = []
    for gid, nombre, wids, bases in GRUPOS_OPENAI:
        modelos = ["%s-%s" % (b, e) for b in bases for e in EFFORTS_CODEX]
        g = {"id": gid, "nombre": nombre, "modelos": modelos,
             "ventanas": [vs.get(w) or ventana(w, None, None) for w in wids]}
        h = cfg["grupos_hasta"].get(gid)
        if h:
            g["hasta"] = h
        grupos.append(g)
    return {"id": "openai", "nombre": "ChatGPT", "grupos": grupos}


def state_dir():
    """Dónde viven la caché de /quota y los grupos agotados. Un solo lugar para `pa` y para quien llame a
    reparto a mano (antes cada uno tenía su caché y podían ver cupos de hace 5 minutos distintos)."""
    if os.environ.get("REPARTO_STATE"):
        return os.environ["REPARTO_STATE"]
    base = os.environ.get("PA_STATE") or os.path.expanduser("~/.local/state/pa")
    return os.path.join(base, "reparto")


def ventana_asignacion():
    try:
        return float(os.environ.get("REPARTO_ASIGNACION_S", ASIGNACION_S))
    except ValueError:
        return ASIGNACION_S


def carga_por_grupo(now):
    """{grupo: workers} de los workers de pa vivos (pid vivo en <PA_STATE>/*/<id>.pid, modelo del .hilo) más los
    repartos de los últimos ASIGNACION_S s (aún sin .hilo). REPARTO_CARGA_FIJA='{"gemini-4-argon": 3}' lo fija (tests)."""
    fija = os.environ.get("REPARTO_CARGA_FIJA")
    if fija:
        try:
            return {k: int(v) for k, v in json.loads(fija).items()}
        except Exception:
            return {}
    out = {}
    base = os.environ.get("PA_STATE") or os.path.expanduser("~/.local/state/pa")
    vistos = set()   # (slug, id): una corrida --async tiene .pid y .running, que no cuente doble

    def sumar(m, cu):
        g = grupo_de_modelo(m) if m else None
        if g:
            g += suf(cu)
            out[g] = out.get(g, 0) + 1

    for pidf in glob.glob(os.path.join(base, "*", "*.pid")):
        try:
            pid = int(open(pidf).read().strip())
            os.kill(pid, 0)
            m = cu = None
            for ln in open(pidf[:-4] + ".hilo", errors="replace"):
                if ln.startswith("modelo="):
                    m = ln[7:].strip()
                elif ln.startswith("cuenta="):
                    cu = ln[7:].strip()
        except Exception:
            continue
        vistos.add((os.path.basename(os.path.dirname(pidf)), os.path.basename(pidf)[:-4]))
        sumar(m, cu)
    # Las de primer plano no dejan .pid (sólo --async lo escribe): su señal de vida es el `<slug>.running`
    # (pid del worker, o el de pa mientras arranca) que pa borra al terminar y que un pa matado con -9 deja colgado,
    # de ahí el kill -0.
    for runf in glob.glob(os.path.join(base, "*.running")):
        try:
            c = {}
            for ln in open(runf, errors="replace"):
                k, _, v = ln.rstrip("\n").partition("=")
                c.setdefault(k, v)
            pid = int(c.get("pid") or c.get("pa_pid") or "")
            os.kill(pid, 0)
        except Exception:
            continue
        if (c.get("proyecto"), c.get("id")) in vistos:
            continue
        sumar(c.get("modelo"), c.get("cuenta"))
    try:
        with open(os.path.join(state_dir(), "asignaciones.json")) as f:
            for a in json.load(f):
                if now.timestamp() - a.get("t", 0) < ventana_asignacion() and a.get("grupo"):
                    out[a["grupo"]] = out.get(a["grupo"], 0) + 1
    except Exception:
        pass
    return out


def registrar_asignacion(grupo, now):
    """Anota (REPARTO_RESERVAR=1, lo pone pa al elegir de verdad) a qué grupo fue este reparto, para que los que
    se lanzan en el mismo segundo no se amontonen antes de que el worker exista."""
    d = state_dir()
    f = os.path.join(d, "asignaciones.json")
    try:
        os.makedirs(d, exist_ok=True)
        with bloqueo(f):
            try:
                with open(f) as fh:
                    lst = [a for a in json.load(fh) if now.timestamp() - a.get("t", 0) < ventana_asignacion()]
            except Exception:
                lst = []
            lst.append({"grupo": grupo, "t": now.timestamp()})
            tmp = "%s.%d" % (f, os.getpid())
            with open(tmp, "w") as fh:
                json.dump(lst, fh)
            os.replace(tmp, f)
    except Exception:
        pass


def leer_agotados(state, now):
    """{grupo: ISO de cuándo vuelve} de los que siguen agotados (los vencidos no cuentan)."""
    try:
        with open(os.path.join(state, "agotado.json")) as f:
            d = json.load(f)
    except Exception:
        return {}
    out = {}
    for gid, v in (d.items() if isinstance(d, dict) else []):
        dt = parse_iso(v.get("hasta") if isinstance(v, dict) else None)
        if dt and dt > now:
            out[gid] = iso(dt)
    return out


def grabar_agotados(state, d):
    os.makedirs(state, exist_ok=True)
    f = os.path.join(state, "agotado.json")
    tmp = f + ".%d" % os.getpid()
    with open(tmp, "w") as fh:
        json.dump({k: {"hasta": v} for k, v in d.items()}, fh)
    os.replace(tmp, f)


def aplicar_agotados(d, state, now):
    """Un grupo marcado agotado (agy devolvió 429, o el Claude oficial dijo límite) cuenta como lleno hasta su
    `vuelve`, diga lo que diga /quota o la statusline."""
    ag = leer_agotados(state, now)
    if not ag:
        return d
    for s in d.get("suscripciones", []):
        sf = suf(cuenta_de(s))
        if prov_de(s) == "claude" and CLAUDE_OFICIAL + sf in ag:
            hasta = ag[CLAUDE_OFICIAL + sf]
            s["agotado"] = hasta
            s["ventanas"] = [ventana(w["id"], 1.0, hasta) for w in (s.get("ventanas") or
                                                                   [ventana("5h", None, None), ventana("7d", None, None)])]
        for g in s.get("grupos", []) or []:
            if g.get("id", "") + sf in ag:
                hasta = ag[g["id"] + sf]
                g["agotado"] = hasta
                vs = g.get("ventanas") or [ventana("5h", None, None)]
                g["ventanas"] = [ventana(w["id"], 1.0, hasta) for w in vs]
    return d


CLAUDE_OFICIAL = "claude-oficial"


def grupo_de_modelo(mid):
    """Id de grupo de agy, de codex o de dsh de un modelo ('agy:claude-sonnet-5-5-medium', 'gemini-3.8-flash-low',
    'codex:gpt-6-luna-low', 'dsh:opencode/big-pickle', 'opencode:opencode/beam-free') o de un grupo ('claude-gpt', 'codex', 'dsh-opencode', 'opencode-free'). None si no es de ésos."""
    m = (mid or "").lower()
    if m.startswith(OC_GO_PREFIJO):   # OpenCode Go: el cupo es por modelo, el grupo es el modelo (no `opencode-free`)
        return m
    if m == "opencode-free" or m.startswith("opencode:"):
        return "opencode-free"
    for prov, gid in DSH_GRUPOS.items():
        if prov != "opencode-prog" and (m == gid or m.startswith("dsh:%s/" % prov)):
            return gid
    if m.startswith("codex:gpt-6-sol"):   # alias que pa acepta (CODEX_MODELOS): mismo cupo de ChatGPT que los demás codex
        return "codex"
    for gid, _n, _w, bases in GRUPOS_GOOGLE + GRUPOS_OPENAI:
        if m == gid or any(m == b or m.startswith(b + "-") for b in bases):
            return gid
    if m == CLAUDE_OFICIAL or m.startswith("claude-"):
        return CLAUDE_OFICIAL
    return None


def agotar(mid, hasta_arg, cfg, now, cuenta=None):
    gid = grupo_de_modelo(mid)
    if not gid:
        err("%s no es un modelo de agy, de codex, de dsh ni del Claude oficial, ni un grupo: no hay cupo que marcar" % mid)
        return 1
    state = state_dir()
    hasta = parse_iso(hasta_arg) if hasta_arg else None
    if hasta_arg and not hasta:
        err("--hasta quiere una fecha ISO (2026-10-23T15:00:00Z)")
        return 2
    if not hasta and gid.startswith(OC_GO_PREFIJO):
        hasta = now + timedelta(hours=VENCE_GO_H)   # un modelo de Go: su ventana de 5 h
    if not hasta:
        # cuándo vuelve el grupo según los mismos cupos que usa el reparto: su ventana de 5 h (o la semanal si no tiene)
        try:
            cand = {}
            for sus in leer_cupos(cfg, now).get("suscripciones", []):
                if suf(cuenta_de(sus)) != suf(cuenta):
                    continue
                if gid == CLAUDE_OFICIAL and prov_de(sus) == "claude":
                    # la ventana más usada es la que se acabó; sin dato de uso, la 5 h
                    vs = sorted((v for v in sus.get("ventanas", []) if (parse_iso(v.get("vuelve")) or now) > now),
                                key=lambda v: -(v.get("usado") or 0))
                    if vs:
                        cand["5h"] = parse_iso(vs[0]["vuelve"])
                for g in sus.get("grupos", []) or []:
                    if g.get("id") == gid:
                        for v in g.get("ventanas", []):
                            dt = parse_iso(v.get("vuelve"))
                            if dt and dt > now:
                                cand[v.get("id")] = dt
            hasta = cand.get("5h") or cand.get("7d")
        except Exception:
            hasta = None
    if not hasta:
        hasta = now + timedelta(hours=1)
    gid += suf(cuenta)
    try:
        os.makedirs(state, exist_ok=True)
        with bloqueo(os.path.join(state, "agotado.json")):   # leer-modificar-grabar sin que otro agotar se pise
            ag = leer_agotados(state, now)
            ag[gid] = iso(hasta)
            grabar_agotados(state, ag)
    except OSError as e:
        err("no pude guardar la marca: %s" % e)
        return 1
    print("%s agotado hasta %s" % (gid, iso(hasta)))
    return 0


def leer_cupos(cfg, now):
    state = state_dir()
    fijos = os.environ.get("REPARTO_CUPOS_FIJOS")
    if fijos:
        with open(fijos) as f:
            d = json.load(f)
        d.setdefault("version", VERSION)
        return aplicar_agotados(d, state, now)
    cs = lista_cuentas()
    if all(c["defecto"] for c in cs) and len(cs) == 2:   # una cuenta por proveedor: la forma de siempre
        subs = [cupos_claude(os.environ.get("PA_STATE"), now)]
        if agy_disponible():
            subs.append(cupos_google(cfg, state, now))
        if codex_disponible():
            subs.append(cupos_openai(cfg, now))
        nom = {c["id"]: c["nombre"] for c in cs}
        for x in subs:
            x["nombre"] = nom.get(x["id"], x["nombre"])
    else:
        subs = []
        for c in cs:
            if c["proveedor"] == "claude":
                subs.append(cupos_claude(os.environ.get("PA_STATE"), now, c))
            elif c["proveedor"] == "google" and agy_disponible():
                subs.append(cupos_google(cfg, state, now, c))
            elif c["proveedor"] == "chatgpt" and c["defecto"] and codex_disponible():
                subs.append(cupos_openai(cfg, now))
            else:   # ChatGPT sin cupo que leer: se lista sin dato y no se reparte
                nota = ("codex no está instalado o no tiene login (codex login): no se reparte" if c["proveedor"] == "chatgpt" and c["defecto"]
                        else "el cupo de codex sólo se lee de la cuenta de siempre: esta no se reparte (sí sirve con pa --cuenta %s)" % c["id"]
                        if c["proveedor"] == "chatgpt" else "agy no está instalado: no se reparte" if c["proveedor"] == "google"
                        else "proveedor sin lectura de cupo: no se reparte")
                subs.append({"id": c["id"], "nombre": c["nombre"], "proveedor": c["proveedor"], "cuenta": c["id"],
                             "ventanas": [ventana("5h", None, None), ventana("7d", None, None)],
                             "nota": nota})
    return aplicar_agotados({"version": VERSION, "leido": iso(now), "suscripciones": subs}, state, now)


# --- reparto -----------------------------------------------------------------------------------------
def hasta_fin(hasta):
    """'2026-11-02' -> el fin de ese día (hora local de la máquina), en UTC. None si no hay/inválida."""
    if not hasta:
        return None
    try:
        d = datetime.strptime(hasta, "%Y-%m-%d") + timedelta(days=1)
    except ValueError:
        return None
    return d.astimezone().astimezone(timezone.utc)   # medianoche local siguiente


def hasta_de(cfg, gid, g):
    """La fecha `hasta` de un grupo: lo que pisa modelos.json, si no la que trae el cupo, si no el default."""
    if gid in cfg["hasta_pisado"]:
        return cfg["hasta_pisado"][gid]
    return (g or {}).get("hasta") or cfg["grupos_hasta"].get(gid)


def horas_hasta(vuelve, now):
    dt = parse_iso(vuelve)
    return max(0.0, (dt - now).total_seconds() / 3600.0) if dt else None


def urgencia_ventana(v, now, tope_h=None):
    """Cuánto cupo libre se pierde pronto: libre × (horizonte / horas hasta el reset), tope 1.
    Sin dato de uso: None. Con `tope_h` (una fecha `hasta`) el reset efectivo no pasa de ahí."""
    if v.get("usado") is None:
        return None
    libre = 1 - v["usado"]
    h = horas_hasta(v.get("vuelve"), now)
    if h is None:
        h = 2.5 if v["id"] == "5h" else 84.0
    if tope_h is not None:
        h = min(h, tope_h)
    return libre * min(1.0, HORIZONTE_H / max(h, 1.0))


# --- plan (pistas de corta vida del dueño) y ritmo ----------------------------------------------------
def dia_local(now):
    return now.astimezone().date()


def ruta_plan():
    return os.path.join(state_dir(), "plan.json")


def plan_leer(now):
    """El plan vigente: {"ausente": [AAAA-MM-DD..], "hoy": None|"gastar"|"ahorrar", "actualizado": ISO|None}. Lo vencido no cuenta:
    un día ausente anterior a hoy, o un gastar/ahorrar-hoy de otro día. Sin archivo o roto: plan vacío."""
    hoy = dia_local(now).isoformat()
    out = {"ausente": [], "hoy": None, "actualizado": None}
    try:
        with open(ruta_plan()) as f:
            d = json.load(f)
    except Exception:
        return out
    if not isinstance(d, dict):
        return out
    fechas = d.get("ausente")
    for x in fechas if isinstance(fechas, list) else []:
        if isinstance(x, str) and re.fullmatch(r"\d{4}-\d{2}-\d{2}", x) and x >= hoy and x not in out["ausente"]:
            out["ausente"].append(x)
    out["ausente"].sort()
    h = d.get("hoy")
    if isinstance(h, dict) and h.get("fecha") == hoy and h.get("modo") in ("gastar", "ahorrar"):
        out["hoy"] = h["modo"]
    out["actualizado"] = d.get("actualizado") if isinstance(d.get("actualizado"), str) else None
    return out


def plan_grabar(plan, now):
    f = ruta_plan()
    if not plan["ausente"] and not plan["hoy"]:
        try:
            os.remove(f)
        except FileNotFoundError:
            pass
        return
    os.makedirs(os.path.dirname(f), exist_ok=True)
    d = {"version": 1, "actualizado": iso(now), "ausente": sorted(plan["ausente"])}
    if plan["hoy"]:
        d["hoy"] = {"fecha": dia_local(now).isoformat(), "modo": plan["hoy"]}
    tmp = f + ".%d" % os.getpid()
    with open(tmp, "w") as fh:
        json.dump(d, fh, ensure_ascii=False)
    os.replace(tmp, f)


def plan_de(cfg, now):
    if "plan" not in cfg:
        cfg["plan"] = plan_leer(now)
    return cfg["plan"]


def fechas_de(texto, now):
    """'2026-10-27,hoy,manana,2026-10-29..2026-10-31' -> lista de fechas ISO. Lanza ValueError con qué está mal."""
    hoy = dia_local(now)
    out = []
    for tok in [x.strip().lower() for x in texto.split(",") if x.strip()]:
        tok = tok.replace("mañana", "manana").replace("pasado manana", "pasado")
        if tok == "hoy":
            out.append(hoy)
        elif tok == "manana":
            out.append(hoy + timedelta(days=1))
        elif tok == "pasado":
            out.append(hoy + timedelta(days=2))
        else:
            a, _, z = tok.partition("..")
            try:
                d0 = datetime.strptime(a, "%Y-%m-%d").date()
                d1 = datetime.strptime(z, "%Y-%m-%d").date() if z else d0
            except ValueError:
                raise ValueError("fecha %r (quiero AAAA-MM-DD, hoy, manana, pasado o A..B)" % tok)
            if d1 < d0 or (d1 - d0).days > PLAN_MAX_DIAS:
                raise ValueError("rango %r" % tok)
            out.extend(d0 + timedelta(days=i) for i in range((d1 - d0).days + 1))
    if not out:
        raise ValueError("falta la fecha")
    for d in out:
        if d < hoy:
            raise ValueError("%s ya pasó" % d.isoformat())
        if (d - hoy).days > PLAN_MAX_DIAS:
            raise ValueError("%s está a más de %d días" % (d.isoformat(), PLAN_MAX_DIAS))
    return sorted({d.isoformat() for d in out})


def horas_activas(desde, hasta, ausentes):
    """Horas entre dos instantes que caen en días de trabajo (los de `ausentes`, fechas ISO locales, no cuentan)."""
    cur = desde.astimezone().replace(tzinfo=None)
    fin = hasta.astimezone().replace(tzinfo=None)
    total = 0.0
    while cur < fin:
        sig = min(datetime.combine(cur.date() + timedelta(days=1), datetime.min.time()), fin)
        if cur.date().isoformat() not in ausentes:
            total += (sig - cur).total_seconds() / 3600.0
        cur = sig
    return total


def ritmo_ventana(v, now, plan, reserva=0.0):
    """El ritmo de una ventana semanal (ver la fórmula arriba) o None sin dato. {usado, usado_w, esperado, ratio, h, h_activas, nivel}."""
    if v.get("id") != "7d" or v.get("usado") is None:
        return None
    fin = parse_iso(v.get("vuelve"))
    if fin is None:
        return None
    ini = fin - timedelta(hours=168)
    ausentes = set(plan["ausente"])
    h = max(0.0, (fin - now).total_seconds() / 3600.0)
    tot = horas_activas(ini, fin, ausentes)
    if tot <= 0:   # todos los días ausentes: el plan no puede repartir nada, vale el tiempo corrido
        ausentes, tot = set(), 168.0
    pasado = horas_activas(ini, min(max(now, ini), fin), ausentes)
    esperado = max(RITMO_MIN_ESPERADO, min(1.0, pasado / tot))
    usado_w = min(1.0, v["usado"] / (1 - reserva)) if reserva else v["usado"]
    ratio = usado_w / esperado
    if plan.get("hoy") == "gastar":
        ratio = min(ratio, RATIO_GASTAR_HOY)
    elif plan.get("hoy") == "ahorrar":
        ratio = max(ratio, RATIO_AHORRAR_HOY)
    ha = horas_activas(now, fin, ausentes)
    nivel = "encima" if ratio > 1.1 else "debajo" if ratio < 0.9 else "al-ritmo"
    return {"usado": round(v["usado"], 4), "usado_w": round(usado_w, 4), "esperado": round(esperado, 4), "ratio": round(ratio, 3),
            "h": round(h, 2), "h_activas": round(ha, 2), "nivel": nivel, "forzado": plan.get("hoy")}


def puntos_ritmo(rt, urg7, peso_ritmo, peso_bono, mult):
    """(puntos, s_ritmo): lo que el ritmo suma o resta al puntaje (fórmula arriba)."""
    r = rt["ratio"]
    if r > 1:
        return -peso_ritmo * mult * min(r - 1, TOPE_EXCESO), 0.0
    e = rt["esperado"]
    presion = (1 - r * e) / max(1 - e, 0.02)   # cuántas veces el ritmo medio hay que gastar lo que queda para terminar la semana en ~100 %
    atras = max(0.0, min(1.0, presion - 1.0))
    cerca = max(0.25, min(1.0, (96 - rt["h_activas"]) / 72.0))
    s = atras * cerca
    return peso_bono * max(0.0, s - urg7), s


def reserva_lider_de(cfg):
    """Fracción de la semana de Claude que queda para el líder: modelos.json `reserva_lider` o la del perfil."""
    r = cfg.get("reserva_lider")
    return r if r is not None else PERFILES[cfg["perfil"]]["reserva_lider"]


def minimo_relajado(cfg, tipo, minimo, minimo_fam, e_tipo):
    """Perfil ahorro: el mínimo de codigo-acotado/lectura/mecanico una banda más abajo. (mínimo, ¿bajó?)"""
    if not PERFILES[cfg["perfil"]]["relaja"] or tipo not in RELAJA_AHORRO:
        return minimo, False
    n = RELAJA_AHORRO[tipo]
    q = calidad_en_effort(mapa_efforts(cfg, n), e_tipo, cfg["calidad"][n]) if isinstance(n, str) and n in cfg["calidad"] else vieja_a_aa(n)
    return (q, True) if q < minimo else (minimo, False)


def efectivo(base, cfg_effort, e_tipo):
    return e_tipo if e_tipo in cfg_effort else cfg_effort[-1]


def armar_candidatos(tipo, cfg, cupos, now, effort=None):
    # Una vuelta por cuenta: cada cuenta es una suscripción aparte (sin cuentas agregadas, una de cada proveedor)
    subs = cupos.get("suscripciones", [])
    claudes = [s for s in subs if prov_de(s) == "claude"] or [{"id": "claude"}]
    googles = [s for s in subs if prov_de(s) == "google"] or [{"id": "google"}]
    if not agy_disponible():
        googles = []   # sin agy instalado ningún modelo de Google es candidato
    # ChatGPT/Codex sólo es candidato si la suscripción está en los cupos (codex instalado y logueado)
    openais = [s for s in subs if s.get("id") == "openai"]

    ofertas_dsh = dsh_ofertas(cfg, now)
    if ofertas_dsh and not claude_instalado():
        claudes = []   # sin claude en la máquina el Claude oficial no es un candidato (la persona usa sólo dsh)

    carga = carga_por_grupo(now)
    e_tipo = effort or cfg["effort_por_tipo"].get(tipo, "high")
    if e_tipo == "max":   # reparto nunca elige max por su cuenta (eso es de -m/--effort, con permitir_max o --ok-dueno)
        e_tipo = "xhigh"
    minimo_fam = cfg["minimo_por_tipo"].get(tipo, "sonnet")
    minimo = cfg["calidad"].get(minimo_fam, minimo_fam if isinstance(minimo_fam, (int, float)) else vieja_a_aa(70))
    if isinstance(minimo_fam, str) and minimo_fam in cfg["calidad"]:
        # El mínimo se mide al mismo effort que el tipo: si no, Sonnet en medium (bajo su mejor puntaje) no llega a
        # "la calidad de Sonnet" y codigo-acotado terminaba en Opus.
        minimo = calidad_en_effort(mapa_efforts(cfg, minimo_fam), e_tipo, minimo)
    minimo, cfg["_relajado"] = minimo_relajado(cfg, tipo, minimo, minimo_fam, e_tipo)
    out = []
    reserva = cfg["reserva"]
    perfil = PERFILES[cfg["perfil"]]
    plan = plan_de(cfg, now)
    res_lider = reserva_lider_de(cfg)
    sin_ritmo = cfg.get("_sin_ritmo")   # la contrafactual de elegir(): ni ritmo ni perfil

    def reserva_de(w):   # None = no se guarda nada en esa ventana
        r = reserva.get(w) if isinstance(reserva, dict) else reserva
        if w == "7d" and res_lider:   # reserva_lider es la misma reserva, para la ventana semanal: gana la mayor
            return max(r or 0.0, res_lider)
        return r

    def claude_de_google_ok(google):
        # Sin dato de uso (libres vacío: /quota no contestó) devuelve True a propósito: igual que los candidatos, un
        # grupo sin dato "no se descarta" y se prueba; el 429 de agy lo marca agotado y reparto reasigna.
        agy_claude = {g.get("id"): g for g in google.get("grupos", []) or []}.get("claude-gpt")
        if not agy_claude or agy_claude.get("agotado"):
            return False
        hf = hasta_fin(hasta_de(cfg, "claude-gpt", agy_claude))
        vigente = hf is None or now < hf
        libres = [1 - w["usado"] for w in agy_claude.get("ventanas", []) if w.get("usado") is not None]
        ok = vigente and (not libres or min(libres) >= cfg["llena"])
        w5 = next((w for w in agy_claude.get("ventanas", []) if w.get("id") == "5h" and w.get("usado") is not None), None)
        if w5 is not None and 1 - w5["usado"] < cfg["agy_min_libre_5h"] and \
                any(fnmatch.fnmatchcase(tipo, p) for p in cfg["agy_min_libre_tipos"]):
            ok = False   # para este tipo ese grupo no es candidato: la 5h de Claude sí cuenta
        return ok

    agy_claude_ok = any(claude_de_google_ok(g) for g in googles)

    def hacer(c, cuenta_s):
        base, fam, nombre, sus, gid, agy_base, efs = c
        claude = cuenta_s
        grupos = {g.get("id"): g for g in cuenta_s.get("grupos", []) or []}
        # transición: la forma vieja `modelos` (sin grupos) no se usa para decidir; sin grupo = sin dato
        cl_vent = {w["id"]: w for w in cuenta_s.get("ventanas", []) or []}
        cuenta = cuenta_de(cuenta_s)
        if suf(cuenta):
            nombre = "%s · %s" % (nombre, cuenta_s.get("nombre") or cuenta)
        calidad_mejor = cfg["calidad"].get(fam, 0)
        mapa_ef = mapa_efforts(cfg, fam)
        nota_effort = None
        if efs is None:   # Claude oficial: el effort va aparte
            e_perm, nota_effort = effort_permitido(cfg, base, fam, e_tipo)
            modelo, effort = base, e_perm or e_tipo
            e_cal = effort
        else:
            e = efectivo(base, efs, e_tipo)
            e_perm, nota_effort = effort_permitido(cfg, base, fam, e, [x for x in efs if x in EFFORTS_AA])
            e = e_perm or e
            modelo, effort = "%s-%s" % (base, e), None
            e_cal = e
        calidad = calidad_en_effort(mapa_ef, e_cal, calidad_mejor)
        cand = {"modelo": modelo, "effort": effort, "nombre": nombre, "familia": fam, "calidad": calidad,
                "calidad_mejor": calidad_mejor, "calidad_por_effort": mapa_ef, "effort_calidad": e_cal if mapa_ef else None,
                "efforts_posibles": [x for x in EFFORTS_AA if efs is None or x in efs] if mapa_ef else [],
                "cupo_libre": None, "vuelve": None, "puntaje": None, "descartado_por": None,
                "aviso": None, "grupo": gid or "claude-oficial", "cuenta": cuenta, "proveedor": sus,
                "estimada": fam not in cfg["calidad"], "origen": cfg["origen"].get(fam, "estimada"), "nota_effort": nota_effort}
        if e_perm is None and nota_effort:
            cand["descartado_por"] = "excluido en modelos.json (%s)" % nota_effort
            cand["duro"] = True
        cand["clave"] = cand["grupo"] + suf(cuenta)
        if sus == "claude":
            vents = [cl_vent[w] for w in ("5h", "7d") if w in cl_vent] or \
                    [ventana("5h", None, None), ventana("7d", None, None)]
            tope_h = None
        else:
            g = grupos.get(gid)
            vents = list((g or {}).get("ventanas", []))
            hasta = hasta_de(cfg, gid, g)
            hf = hasta_fin(hasta)
            tope_h = None
            if hf is not None:
                if now >= hf:
                    cand["descartado_por"] = "vencido: el grupo \"%s\" era hasta el %s" % (
                        (g or {}).get("nombre", gid), hasta)
                    cand["duro"] = True
                else:
                    tope_h = (hf - now).total_seconds() / 3600.0
            if not vents:
                vents = [ventana("7d", None, None)]
        # Reglas de calidad / tipo
        if calidad < minimo:
            cand["descartado_por"] = "calidad %s menor que la %s que pide %s" % (fn(calidad), fn(minimo), tipo)
            cand["duro"] = True
        elif fam in cfg["solo_en"] and tipo not in cfg["solo_en"][fam]:
            cand["descartado_por"] = "%s sólo sirve para %s" % (nombre, " y ".join(cfg["solo_en"][fam]))
            cand["duro"] = True
        u, regla = uso_de(modelo, cfg["uso_por_modelo"], fam)
        if not cand.get("duro") and u == "poco_importante" and tipo not in cfg["tipos_poco_importantes"]:
            cand["descartado_por"] = "%s sólo sirve para tareas poco importantes (%s); %s no lo es (modelos.json uso_por_modelo: %s)" % (
                nombre, " y ".join(cfg["tipos_poco_importantes"]), tipo, regla)
            cand["duro"] = True
        elif not cand.get("duro") and u == "solo_final" and tipo not in cfg["tipos_finales"]:
            cand["descartado_por"] = "%s sólo sirve para tareas finales (%s) porque su cupo se gasta muy rápido; %s no lo es (modelos.json uso_por_modelo: %s)" % (
                nombre, " y ".join(cfg["tipos_finales"]), tipo, regla)
            cand["duro"] = True
        x = excluido_por(modelo, cfg["excluir"], fam)
        if x and not cand.get("duro"):
            cand["descartado_por"] = "excluido en modelos.json (excluir: %s)" % x
            cand["duro"] = True
        # Los cupos de agy son chicos: con poco libre en la ventana de 5 h no se arranca una tarea de código
        if sus == "google" and not cand["descartado_por"] and not (grupos.get(gid) or {}).get("agotado") and \
                any(fnmatch.fnmatchcase(tipo, p) for p in cfg["agy_min_libre_tipos"]):
            w5 = next((w for w in vents if w["id"] == "5h" and w.get("usado") is not None), None)
            if w5 is not None and 1 - w5["usado"] < cfg["agy_min_libre_5h"]:
                cand["descartado_por"] = (
                    "poco cupo en agy: al grupo \"%s\" le queda %d %% de la ventana de 5 h (para %s hace falta %d %% o más)%s" % (
                        (grupos.get(gid) or {}).get("nombre", gid), round((1 - w5["usado"]) * 100), tipo,
                        round(cfg["agy_min_libre_5h"] * 100),
                        ", vuelve en %s" % humano(horas_hasta(w5.get("vuelve"), now)) if w5.get("vuelve") else ""))
                cand["duro"] = True
        # Cupo
        conocidas = [w for w in vents if w.get("usado") is not None]
        cand["ventanas"] = [{"id": w["id"], "libre": round(1 - w["usado"], 4), "vuelve": w.get("vuelve")} for w in conocidas]
        if conocidas:
            lib = min(conocidas, key=lambda w: (1 - w["usado"], w.get("vuelve") or ""))
            cand["cupo_libre"] = round(1 - lib["usado"], 4)
            cand["vuelve"] = lib.get("vuelve")
        else:
            cand["aviso"] = "sin dato del cupo (no se descarta, pero no se sabe si queda)"
        if len(conocidas) < len(vents) and conocidas:
            cand["aviso"] = "falta el dato de una ventana (%s)" % ", ".join(
                w["id"] for w in vents if w.get("usado") is None)
        if not cand["descartado_por"]:
            for w in conocidas:
                libre = 1 - w["usado"]
                if sus == "claude" and claude.get("agotado"):
                    cand["descartado_por"] = "Claude dijo que se acabó el cupo (límite), vuelve en %s" % (
                        humano(horas_hasta(w.get("vuelve"), now)))
                    break
                if sus == "claude" and reserva_de(w["id"]) is not None and libre <= reserva_de(w["id"]):
                    lider = w["id"] == "7d" and res_lider and res_lider >= (reserva_de("7d") or 0)
                    cand["descartado_por"] = ("reserva del líder: a Claude %s le queda %d %% y se guarda el %d %% para la conversación (reserva_lider)" if lider
                                              else "reserva comprometida: Claude %s al %d %% (modelos.json guarda el %d %%)") % (
                        (nombre_ventana(w["id"]), round(libre * 100), round(reserva_de(w["id"]) * 100)) if lider else
                        (nombre_ventana(w["id"]), round(w["usado"] * 100), round(reserva_de(w["id"]) * 100)))
                    break
                if libre < cfg["llena"] and sus != "claude" and (grupos.get(gid) or {}).get("agotado"):
                    cand["descartado_por"] = "ventana %s llena: %s dijo que se acabó el cupo, vuelve en %s" % (
                        w["id"], "codex" if sus == "openai" else "agy (429)", humano(horas_hasta(w.get("vuelve"), now)))
                    break
                if libre < cfg["llena"]:
                    cand["descartado_por"] = "ventana %s llena (%d %% usado)%s" % (
                        w["id"], round(w["usado"] * 100),
                        ", vuelve en %s" % humano(horas_hasta(w.get("vuelve"), now)) if w.get("vuelve") else "")
                    break
        # Puntaje
        q = float(calidad)
        util = PTS_POR_AA * (q if q <= minimo + MARGEN else minimo + MARGEN - (q - minimo - MARGEN) * PESO_SOBRA)
        us = []
        rt = urg7 = None
        for w in vents:
            # el claude oficial no gasta su 5h por urgencia si Claude por Google está disponible: esa
            # ventana es la de las sesiones de la persona
            if sus == "claude" and w["id"] == "5h" and agy_claude_ok:
                continue
            tope_w = tope_h
            if w["id"] == "7d" and not sin_ritmo:
                rt = ritmo_ventana(w, now, plan, (res_lider or 0.0) if sus == "claude" else 0.0)
                if rt and rt["h_activas"] < rt["h"]:   # días ausentes hasta el reinicio: el cupo se pierde antes
                    tope_w = rt["h_activas"] if tope_h is None else min(tope_h, rt["h_activas"])
            u = urgencia_ventana(w, now, tope_w)
            if u is not None:
                us.append(u)
                if w["id"] == "7d":
                    urg7 = u
        urg = min(us) if us else 0.0
        cand["urgencia"] = round(urg, 3)
        cand["carga"] = carga.get(cand["clave"], 0)
        mult_costo = 1.0 if sin_ritmo else perfil["costo"]
        pts = round(util + cfg["peso_urgencia"] * urg - mult_costo * cfg["peso_costo"] * cfg["costo"].get(fam, 0.3)
                    - cfg["peso_carga"] * cand["carga"], 2)
        if rt:
            p_r, s_r = puntos_ritmo(rt, urg7 or 0.0, cfg["peso_ritmo"], cfg["peso_bono_ritmo"], perfil["ritmo"])
            pts += p_r
            if sus == "claude" and perfil["sesgo"]:
                p_r -= perfil["sesgo"] * (1 - max(s_r, urg7 or 0.0))
                pts -= perfil["sesgo"] * (1 - max(s_r, urg7 or 0.0))
            cand["ritmo"], cand["ritmo_pts"] = rt, round(p_r, 2)
        elif sus == "claude" and perfil["sesgo"] and not sin_ritmo:
            pts -= perfil["sesgo"]   # sin dato semanal no hay atraso que lo levante
            cand["ritmo_pts"] = -perfil["sesgo"]
        cand["puntaje"] = round(pts, 2)
        out.append(cand)
    for c in FAMILIAS:
        for cs in (claudes if c[3] == "claude" else openais if c[3] == "openai" else googles):
            hacer(c, cs)
    # Locales de modelos.json: cupo infinito, costo cero, calidad según modelos.json (default 35)
    for loc in cfg["locales"]:
        calidad, origen = calidad_origen(cfg, loc["id"], patrones=False)
        if origen == "estimada":
            calidad = vieja_a_aa(35)   # un local sin dato vale 35 de la escala vieja (unidades de AA), no la cuenta por el nombre
        cand = {"estimada": origen == "estimada", "origen": origen, "modelo": loc["id"], "effort": None, "nombre": loc.get("nombre", loc["id"]), "familia": "local",
                "calidad": calidad, "cupo_libre": 1.0, "vuelve": None, "puntaje": None, "descartado_por": None,
                "aviso": None, "grupo": "local", "urgencia": 0.0, "cuenta": None, "proveedor": "local", "clave": "local"}
        if calidad < minimo:
            cand["descartado_por"] = "calidad %s menor que la %s que pide %s" % (fn(calidad), fn(minimo), tipo)
            cand["duro"] = True
        elif excluido_por(loc["id"], cfg["excluir"], "local"):
            cand["descartado_por"] = "excluido en modelos.json (excluir: %s)" % excluido_por(loc["id"], cfg["excluir"], "local")
            cand["duro"] = True
        q = float(calidad)
        util = PTS_POR_AA * (q if q <= minimo + MARGEN else minimo + MARGEN - (q - minimo - MARGEN) * PESO_SOBRA)
        cand["puntaje"] = round(util + 0.5 * cfg["peso_urgencia"], 2)   # ocioso y gratis: medio punto de urgencia
        out.append(cand)
    # dsh: Ollama y los gratis de OpenCode no gastan cupo (costo cero, como los locales); DeepSeek se paga y sólo entra con su key.
    # Un grupo marcado agotado (`reparto --agotar dsh:opencode/x`: pa vio un 429) no es candidato hasta que vuelve.
    agot = leer_agotados(state_dir(), now) if ofertas_dsh else {}
    for mid, nombre, prov, gratis in ofertas_dsh:
        calidad, origen = calidad_origen(cfg, mid)
        estimada = origen == "estimada"
        es_go = prov == "opencode-go"
        gid = mid.lower() if es_go else DSH_GRUPOS[prov]   # Go: cada modelo es su grupo
        mapa_ef = mapa_efforts(cfg, mid, mid) if origen == "artificial-analysis" else {}
        calidad_mejor = calidad
        nota_effort = e_dsh = None
        if mapa_ef:   # nunca se ordena por el mejor esfuerzo: va el puntaje del esfuerzo que correrá (el del tipo o el permitido más cercano)
            e_dsh, nota_effort = effort_permitido(cfg, mid, "dsh", e_tipo, [e for e in EFFORTS_AA if e in mapa_ef])
            calidad = calidad_en_effort(mapa_ef, e_dsh or e_tipo, calidad)
        cand = {"calidad_mejor": calidad_mejor, "nota_effort": nota_effort, "calidad_por_effort": mapa_ef, "effort_calidad": (e_dsh or e_tipo) if mapa_ef else None, "estimada": estimada, "origen": origen, "modelo": mid, "effort": None, "nombre": nombre, "familia": "dsh", "calidad": calidad,
                "cupo_libre": 1.0 if gratis else None, "vuelve": None, "puntaje": None, "descartado_por": None,
                "aviso": None if gratis or es_go else "se paga con tu key de DeepSeek (no se sabe el precio)", "grupo": gid, "urgencia": 0.0,
                "cuenta": None, "proveedor": "dsh", "clave": gid, "gratis": gratis, **({"plan_go": cfg["opencode_plan"]} if es_go else {})}
        x = excluido_por(mid, cfg["excluir"], "opencode" if mid.startswith("opencode:") else "dsh")
        if mapa_ef and e_dsh is None:
            cand["descartado_por"] = "excluido en modelos.json (%s)" % nota_effort
            cand["duro"] = True
        elif calidad < minimo:
            cand["descartado_por"] = "calidad %s menor que la %s que pide %s" % (fn(calidad), fn(minimo), tipo)
            cand["duro"] = cand["duro_calidad"] = True
        elif x:
            cand["descartado_por"] = "excluido en modelos.json (excluir: %s)" % x
            cand["duro"] = True
        elif gid in agot:
            cand["descartado_por"] = "dijo sin cupo (429): vuelve %s" % agot[gid]
            cand["vuelve"] = agot[gid]
        q = float(calidad)
        util = PTS_POR_AA * (q if q <= minimo + MARGEN else minimo + MARGEN - (q - minimo - MARGEN) * PESO_SOBRA)
        cand["carga"] = carga.get(gid, 0)
        # Go: costo marginal ~0 con cupo (plan fijo), como Claude con suscripción pero sin gastar la semana de nadie; DeepSeek por API se paga.
        costo = -cfg["peso_costo"] * (cfg["costo"].get("opencode-go", COSTO_GO) if es_go else cfg["costo"].get("dsh-pago", COSTO_DSH_PAGO))
        cand["puntaje"] = round(util + (0.5 * cfg["peso_urgencia"] if gratis else costo)
                                - cfg["peso_carga"] * cand["carga"], 2)
        out.append(cand)
    return out, minimo, minimo_fam


def elegir(tipo, cfg, cupos, now, mismo_proveedor=None, solo_cuenta=None, _contra=False):
    tipo = (tipo or "").lower().replace("ñ", "n")
    avisos = []
    if tipo not in cfg["minimo_por_tipo"]:
        avisos.append("tipo \"%s\" desconocido: pido calidad de Sonnet" % tipo)
    if cfg["reparto"] == "fijo":
        w = cfg["workers"].get(tipo) or cfg["workers"].get("default") or {"modelo": "claude-sonnet-5-5", "effort": "high"}
        ef = w.get("effort")
        if ef == "max" and "haiku" not in str(w.get("modelo", "")).lower():
            ef = "xhigh"   # reparto nunca elige max (opus/sonnet max piden --ok-dueno o permitir_max, y van con -m)
        return {"version": VERSION, "modelo": w.get("modelo", "claude-sonnet-5-5"), "effort": ef, "cuenta": None,
                "motivo": "El reparto está en \"fijo\" en modelos.json: uso el modelo que ese archivo asigna al tipo %s." % tipo,
                "candidatos": [], "avisos": avisos + avisos_de_uso(cupos, now), "tipo": tipo,
                "todo_lleno": False, "sin_cupo": cfg["sin_cupo"], "vuelve_antes": None}
    cands, minimo, minimo_fam = armar_candidatos(tipo, cfg, cupos, now)
    relajado = False
    if not any(not c.get("duro") for c in cands):
        # Nada llega a la calidad que pide el tipo (típico: una máquina sin Claude, Gemini ni Codex, sólo con dsh). Mejor un modelo
        # gratis que nada: los de dsh que sólo quedaron afuera por calidad vuelven a entrar, y gana el de mejor puntaje.
        for c in cands:
            if c.get("duro_calidad"):
                c["descartado_por"] = None
                c.pop("duro", None)
                c["relajado"] = True
                relajado = True
    if solo_cuenta:
        # pa --cuenta C sin -m: sólo los modelos de esa cuenta (con todo lleno, el más barato de ella)
        cands = [c for c in cands if c.get("cuenta") == solo_cuenta]
    vivos = [c for c in cands if not c["descartado_por"]]
    todo_lleno = False
    banda = None
    if vivos and mismo_proveedor:
        # relanzamiento por falta de cupo: otra cuenta del mismo proveedor antes que cambiar de proveedor
        mp = [c for c in vivos if c.get("proveedor") == ("openai" if mismo_proveedor == "chatgpt" else mismo_proveedor)]
        if mp:
            vivos = mp
    if vivos:
        pool = vivos
        pref = next((v for p, v in cfg["preferido_por_tipo"].items() if fnmatch.fnmatchcase(tipo, p)), None)
        if cfg.get("_relajado"):
            pref = None   # perfil ahorro con el mínimo bajado: no se encierra al tipo en la banda de arriba; decide el puntaje
        if pref in cfg["calidad"]:
            e_pref = cfg["effort_por_tipo"].get(tipo, "high")
            q0 = calidad_en_effort(mapa_efforts(cfg, pref), "xhigh" if e_pref == "max" else e_pref, cfg["calidad"][pref])
            en = [c for c in vivos if q0 <= c["calidad"] <= q0 + MARGEN]
            if en and len(en) < len(vivos):
                pool, banda = en, pref
    else:
        # Ninguno tiene cupo: el MÁS BARATO entre los que sirven para el tipo (los de calidad, vigencia o
        # excluidos no cuentan), con el que vuelve antes de desempate. Lo que haga pa con eso es `sin_cupo`.
        pool = [c for c in cands if not c.get("duro")]
        todo_lleno = True
    avisos += avisos_de_uso(cupos, now)
    extra = {"todo_lleno": todo_lleno, "sin_cupo": cfg["sin_cupo"], "vuelve_antes": None}
    if not pool:
        return dict({"version": VERSION, "modelo": None, "effort": None,
                     "motivo": "Ningún modelo sirve para el tipo %s con la configuración actual." % tipo,
                     "candidatos": [limpio(c) for c in cands], "avisos": avisos, "tipo": tipo}, **extra)
    if todo_lleno:
        gana = min(pool, key=lambda c: (cfg["costo"].get(c["familia"], 0.3) if c["familia"] != "local" else 0.0,
                                        horas_hasta(c["vuelve"], now) if c["vuelve"] else 1e9, -c["calidad"]))
        vs = [parse_iso(c["vuelve"]) for c in pool if parse_iso(c.get("vuelve"))]
        extra["vuelve_antes"] = iso(min(vs)) if vs else None
    else:
        gana = max(pool, key=lambda c: (c["puntaje"], c["calidad"]))
        # el mismo modelo en varias cuentas: la que tiene más cupo libre (sin dato cuenta como el menos libre;
        # empate: la de siempre)
        gana = max([c for c in pool if c["modelo"] == gana["modelo"]],
                   key=lambda c: (c["cupo_libre"] if c["cupo_libre"] is not None else -1.0, not suf(c.get("cuenta")),
                                  c["puntaje"]))
    motivo = motivo_de(gana, pool, tipo, minimo, minimo_fam, todo_lleno, now, cands)
    if gana.get("nota_effort"):
        motivo += " Effort %s: %s (calidad %s)." % (gana.get("effort") or gana["modelo"].rsplit("-", 1)[-1], gana["nota_effort"], fn(gana["calidad"]))
    if relajado and gana.get("relajado"):
        motivo += " Ningún modelo llega a la calidad %s que pide %s: uso el mejor que hay (calidad %s, ajustable con \"calidad\" en modelos.json)." % (fn(minimo), tipo, fn(gana["calidad"]))
    if banda:
        motivo += " Para %s se prefiere la calidad de %s: los modelos más caros o menos parejos sólo entran si no queda cupo de esa banda." % (tipo, banda)
    ritmo_info = resumen_ritmo(cfg, cupos, now) if not _contra else []
    if not _contra and not todo_lleno:
        motivo += cambio_por_ritmo(tipo, cfg, cupos, now, gana, cands, mismo_proveedor, solo_cuenta)
    if os.environ.get("REPARTO_RESERVAR") == "1" and not _contra:
        registrar_asignacion(gana.get("clave", gana["grupo"]), now)
    for c in cands:
        if c.get("aviso") and not c["descartado_por"]:
            avisos.append("%s: %s" % (c["modelo"], c["aviso"]))
    r = {"version": VERSION, "modelo": gana["modelo"], "effort": gana["effort"], "cuenta": gana.get("cuenta"), "motivo": motivo,
         "candidatos": [limpio(c) for c in sorted(cands, key=lambda c: (c["descartado_por"] is not None, -(c["puntaje"] or 0)))],
         "avisos": avisos, "tipo": tipo, "perfil": cfg["perfil"], "ritmo": ritmo_info}
    r.update(extra)
    return r


def resumen_ritmo(cfg, cupos, now):
    """El ritmo de cada ventana semanal con dato, por suscripción o grupo (para --tipo --json, --plan ver y la app)."""
    plan = plan_de(cfg, now)
    res = reserva_lider_de(cfg)
    out = []
    for s in cupos.get("suscripciones", []):
        filas = [(s.get("nombre", s.get("id")), None, s.get("ventanas", []))] if prov_de(s) != "google" else \
                [(s.get("nombre", s.get("id")), g.get("id"), g.get("ventanas", [])) for g in s.get("grupos", []) or []]
        for nombre, gid, vs in filas:
            for w in vs:
                r = res if prov_de(s) == "claude" else 0.0
                rt = ritmo_ventana(w, now, plan, r)
                if rt:
                    out.append(dict(rt, suscripcion=s.get("id"), cuenta=s.get("cuenta"), proveedor=prov_de(s), nombre=nombre, grupo=gid,
                                    ventana="7d", reserva_lider=r or None))
    return out


def veces(x):
    return ("%.1f" % x).replace(".", ",") + "×"


def cambio_por_ritmo(tipo, cfg, cupos, now, gana, cands, mismo_proveedor, solo_cuenta):
    """Si sin ritmo, plan ni perfil el reparto habría elegido otro modelo: una frase que lo dice ("Claude va 1,4× por encima del ritmo
    semanal: uso GLM gratis en lugar de Claude Sonnet 5.5."). Vacío si no cambió nada."""
    plan = plan_de(cfg, now)
    if cfg["perfil"] == "equilibrado" and not plan["ausente"] and not plan["hoy"] and not any(c.get("ritmo_pts") for c in cands):
        return ""
    base = dict(cfg, perfil="equilibrado", _sin_ritmo=True, plan={"ausente": [], "hoy": None, "actualizado": None})
    r0 = elegir(tipo, base, cupos, now, mismo_proveedor, solo_cuenta, _contra=True)
    if not r0.get("modelo") or (r0["modelo"], r0.get("cuenta")) == (gana["modelo"], gana.get("cuenta")):
        return ""
    antes = next((c for c in r0["candidatos"] if c["modelo"] == r0["modelo"] and c.get("cuenta") == r0.get("cuenta")), {})
    causas = []
    rtc = next((c["ritmo"] for c in cands if c.get("proveedor") == "claude" and c.get("ritmo") and not c.get("descartado_por")), None) or \
        next((c["ritmo"] for c in cands if c.get("proveedor") == "claude" and c.get("ritmo")), None)
    if plan["hoy"]:
        causas.append("el plan dice %s hoy" % ("gastar" if plan["hoy"] == "gastar" else "ahorrar"))
    elif rtc and rtc["ratio"] > 1.1:
        causas.append("Claude va %s por encima del ritmo semanal" % veces(rtc["ratio"]))
    elif rtc and rtc["ratio"] < 0.9:
        causas.append("Claude va %s del ritmo semanal (sobra cupo antes del reinicio)" % veces(rtc["ratio"]))
    if plan["ausente"] and rtc and rtc["h_activas"] < rtc["h"]:
        causas.append("hay días ausentes antes del reinicio (quedan %s de trabajo)" % humano(rtc["h_activas"]))
    if cfg["perfil"] != "equilibrado":
        causas.append("perfil %s" % cfg["perfil"])
    if not causas:
        causas.append("el ritmo semanal")
    gratis = " gratis" if (gana.get("gratis") or gana.get("proveedor") == "local") and "gratis" not in gana["nombre"] else ""
    txt = ", ".join(causas)
    return " %s: uso %s%s en lugar de %s." % (txt[0].upper() + txt[1:], gana["nombre"], gratis, antes.get("nombre", r0["modelo"]))


def nombre_ventana(wid):
    return {"5h": "de 5 h", "7d": "semanal"}.get(wid, wid)


def avisos_de_uso(cupos, now):
    """Cada ventana por encima de AVISO_USO, con su suscripción: "Claude semanal al 91 %, vuelve en 22 h"."""
    out = []
    for s in cupos.get("suscripciones", []):
        filas = [(s.get("nombre", s.get("id")), s.get("ventanas", []))] if prov_de(s) != "google" else \
                [(g.get("nombre", g.get("id")), g.get("ventanas", [])) for g in s.get("grupos", []) or []]
        for nombre, vs in filas:
            for w in vs:
                if w.get("usado") is not None and w["usado"] >= AVISO_USO:
                    h = horas_hasta(w.get("vuelve"), now)
                    out.append("%s %s al %s%s" % (nombre, nombre_ventana(w["id"]), pct(w["usado"]),
                                                  ", vuelve en %s" % humano(h) if h is not None else ""))
    return out


def limpio(c):
    return {k: c[k] for k in ("modelo", "effort", "nombre", "calidad", "cupo_libre", "vuelve", "puntaje",
                              "descartado_por", "aviso", "grupo", "carga", "cuenta", "estimada", "ritmo", "ritmo_pts", "calidad_mejor", "calidad_por_effort", "effort_calidad") if k in c}


def pct(f):
    return "%d %%" % round(f * 100)


def motivo_de(gana, pool, tipo, minimo, minimo_fam, todo_lleno, now, cands):
    pide = "%s pide calidad %s o más" % (tipo, fn(minimo))
    if todo_lleno:
        return ("Todos los cupos que sirven para %s están llenos o en reserva; el más barato que alcanza la calidad "
                "(%s pide %s) es %s, que %s. Va a toparse con el límite." % (
                    tipo, tipo, fn(minimo), gana["nombre"],
                    "vuelve en %s" % humano(horas_hasta(gana["vuelve"], now)) if gana["vuelve"] else "no dice cuándo vuelve"))
    partes = ["%s alcanza para %s (calidad %s; %s)" % (gana["nombre"], tipo, fn(gana["calidad"]), pide)]
    if gana.get("proveedor") == "dsh":
        partes.append("Es gratis y no gasta ningún cupo" if gana.get("gratis") else "Va por tu plan %s de OpenCode (cupo propio por modelo, costo marginal ~0)" % ("Go Plus" if gana["plan_go"] == "go-plus" else "Go") if gana.get("plan_go") else "Se paga con tu key de DeepSeek")
    elif gana["cupo_libre"] is not None:
        h = horas_hasta(gana["vuelve"], now)
        partes.append("Le queda %s libre y vuelve en %s" % (pct(gana["cupo_libre"]), humano(h)))
    else:
        partes.append("No hay dato de su cupo, así que no se lo puede descartar")
    otros = [c for c in pool if c is not gana]
    if otros:
        sig = max(otros, key=lambda c: (c["puntaje"], c["calidad"]))
        partes.append("Le gana a %s (%.1f contra %.1f puntos)" % (sig["nombre"], gana["puntaje"], sig["puntaje"]))
    if gana["grupo"] == "claude-gpt" and gana["familia"] in ("opus", "sonnet"):
        partes.append("El Claude de Google se gasta antes que la ventana de 5 h del Claude oficial")
    return ". ".join(partes) + "."


# --- explicación en castellano llano -----------------------------------------------------------------
def explicar(r, now, cupos, cfg):
    L = ["Tipo de tarea: %s" % r.get("tipo")]
    for a in r.get("avisos", []):
        L.append("Ojo: %s." % a)
    res = cfg["reserva"]
    if res is None:
        res_t = "ninguna"
    elif isinstance(res, dict):
        res_t = ", ".join("%s %s" % (nombre_ventana(k), pct(v)) for k, v in sorted(res.items()))
    else:
        res_t = pct(res)
    L.append("Reserva del Claude oficial: %s. Excluidos: %s. Si no hay cupo: %s%s." % (
        res_t, ", ".join(cfg["excluir"]) or "ninguno", cfg["sin_cupo"],
        "" if cfg["sin_cupo_de"] != "gemini.sin_claude" else " (de gemini.sin_claude)"))
    plan = plan_de(cfg, now)
    L.append("Perfil: %s. Reserva para el líder (semanal de Claude): %s. Plan: ausente %s; hoy %s." % (
        cfg["perfil"], pct(reserva_lider_de(cfg)) if reserva_lider_de(cfg) else "ninguna", ", ".join(plan["ausente"]) or "ningún día",
        {"gastar": "gastar", "ahorrar": "ahorrar"}.get(plan["hoy"], "sin pista")))
    for rt in r.get("ritmo", []):
        L.append("  Ritmo %s semanal: usado %s, esperado %s -> %s" % (rt["nombre"] + (" – %s" % rt["grupo"] if rt.get("grupo") else ""),
                                                                    pct(rt["usado"]), pct(rt["esperado"]), veces(rt["ratio"])))
    reglas = [(k, v) for k, v in cfg["uso_por_modelo"] if v != "libre"]
    if reglas:
        L.append("Uso por modelo: %s. Tareas poco importantes: %s. Tareas finales: %s." % (
            "; ".join("%s → %s" % (k, v.replace("_", " ")) for k, v in reglas),
            ", ".join(cfg["tipos_poco_importantes"]) or "ninguna", ", ".join(cfg["tipos_finales"]) or "ninguna"))
    if r.get("tipo") in cfg["tipos_finales"]:
        L.append("Esta tarea cuenta como final: los modelos de uso solo final (Argon) pueden entrar.")
    L.append("")
    L.append("Cupos que mira:")
    for s in cupos.get("suscripciones", []):
        if prov_de(s) != "google":
            L.append("  %s: %s" % (s["nombre"], ventanas_txt(s.get("ventanas", []), now)))
        else:
            for g in s.get("grupos", []) or []:
                extra = "  (hasta el %s)" % g["hasta"] if g.get("hasta") else ""
                L.append("  %s – %s: %s%s" % (s["nombre"], g["nombre"], ventanas_txt(g.get("ventanas", []), now), extra))
            for m in s.get("modelos", []) or []:   # forma vieja
                L.append("  %s – %s: %s" % (s["nombre"], m.get("nombre", m.get("id")), ventanas_txt(m.get("ventanas", []), now)))
    L.append("")
    L.append("Candidatos (de mejor a peor puntaje):")
    for c in r.get("candidatos", []):
        nom = c["modelo"] + (" " + c["effort"] if c.get("effort") else "")
        if c["descartado_por"]:
            L.append("  ✗ %s — descartado: %s" % (nom, c["descartado_por"]))
        else:
            cupo = "cupo libre %s" % pct(c["cupo_libre"]) if c["cupo_libre"] is not None else "sin dato de cupo"
            L.append("  ✓ %s — calidad %s, %s, %.1f puntos%s" % (nom, c["calidad"], cupo, c["puntaje"],
                                                              "  [%s]" % c["aviso"] if c.get("aviso") else ""))
    L.append("")
    if r.get("modelo"):
        L.append("Elijo: %s%s" % (r["modelo"], " (effort %s)" % r["effort"] if r.get("effort") else ""))
    else:
        L.append("No elijo ninguno.")
    L.append(r["motivo"])
    if r.get("todo_lleno") and r.get("modelo"):
        L.append({"otro": "Con sin_cupo \"otro\", pa lo lanza igual y, si choca el límite sin haber hecho nada, "
                           "lo marca agotado y relanza con el siguiente.",
                  "esperar": "Con sin_cupo \"esperar\", pa no lo lanza: con --async hace cola hasta que vuelva un cupo%s." % (
                      " (el primero vuelve en %s)" % humano(horas_hasta(r["vuelve_antes"], now)) if r.get("vuelve_antes") else ""),
                  "fallar": "Con sin_cupo \"fallar\", pa no lo lanza (sale 96)."}[r.get("sin_cupo", "otro")])
    return "\n".join(L)


def ventanas_txt(vs, now):
    if not vs:
        return "sin ventanas"
    out = []
    for w in vs:
        if w.get("usado") is None:
            out.append("%s sin dato" % w["id"])
        else:
            h = horas_hasta(w.get("vuelve"), now)
            out.append("%s %s libre%s" % (w["id"], pct(1 - w["usado"]), " (vuelve en %s)" % humano(h) if h is not None else ""))
    return ", ".join(out)


# --- resolver un id de modelo ------------------------------------------------------------------------
def resolver(mid):
    """Cómo lanzar un id de reparto. {motor: claude|agy|codex|ollama|dsh, modelo, effort?}. None si no se reconoce."""
    if mid.startswith("agy:"):
        return {"motor": "agy", "modelo": mid[4:], "id": mid, "nota": "agy --model %s" % mid[4:]}
    if mid.startswith("gemini-"):
        return {"motor": "agy", "modelo": mid, "id": mid, "nota": "agy --model %s" % mid}
    m = re.match(r"^codex:(.+)-(low|medium|high)$", mid)
    if m:
        return {"motor": "codex", "modelo": m.group(1), "effort": m.group(2), "id": mid,
                "nota": "codex exec -m %s -c model_reasoning_effort=%s" % (m.group(1), m.group(2))}
    if mid.startswith("ollama:"):
        return {"motor": "ollama", "modelo": mid[7:], "id": mid}
    m = re.match(r"^dsh:(ollama|opencode|deepseek)/(.+)$", mid)
    if m:
        return {"motor": "dsh", "modelo": m.group(2), "proveedor": m.group(1), "id": mid, "nota": "pa -m %s (motor/dsh/correr.mjs)" % mid}
    m = re.match(r"^opencode:([A-Za-z0-9][A-Za-z0-9._-]*)/(.+)$", mid)
    if m:
        return {"motor": "opencode", "modelo": m.group(2), "proveedor": m.group(1), "id": mid, "nota": "pa -m %s (motor/opencode/correr.mjs)" % mid}
    if mid.startswith("claude-"):
        return {"motor": "claude", "modelo": mid, "id": mid}
    return None


def cuenta_para(mid, cupos, now):
    """La cuenta del proveedor de ese modelo con más cupo libre (la ventana más llena de su grupo; sin dato = la
    menos libre; agotada = afuera mientras haya otra). Empate: la de siempre. None si el modelo no es de una cuenta."""
    r = resolver(mid)
    if r and r["motor"] == "codex":   # el cupo de codex es de la cuenta de ChatGPT de siempre (cupos_openai)
        return {"cuenta": "chatgpt", "proveedor": "chatgpt", "cupo_libre": None, "agotada": False}
    if not r or r["motor"] not in ("claude", "agy"):
        return None
    prov = "claude" if r["motor"] == "claude" else "google"
    gid = None if prov == "claude" else grupo_de_modelo(mid)
    mejor = None
    for s in cupos.get("suscripciones", []):
        if prov_de(s) != prov:
            continue
        if prov == "claude":
            vs, agot = s.get("ventanas", []) or [], bool(s.get("agotado"))
        else:
            g = next((g for g in s.get("grupos", []) or [] if g.get("id") == gid), {})
            vs, agot = g.get("ventanas", []) or [], bool(g.get("agotado"))
        us = [w["usado"] for w in vs if w.get("usado") is not None]
        libre = -1.0 if not us else 1 - max(us)
        k = (not agot, libre, not suf(cuenta_de(s)))
        if mejor is None or k > mejor[0]:
            mejor = (k, cuenta_de(s), libre, agot)
    if not mejor:
        return {"cuenta": prov, "proveedor": prov, "cupo_libre": None, "agotada": False}
    return {"cuenta": mejor[1], "proveedor": prov, "cupo_libre": None if mejor[2] < 0 else round(mejor[2], 4),
            "agotada": mejor[3]}


# --- main --------------------------------------------------------------------------------------------
def texto_cupos(d, now):
    L = ["Cupos leídos %s" % d.get("leido", "?")]
    for s in d.get("suscripciones", []):
        if prov_de(s) not in ("google", "openai") and not s.get("grupos"):
            L.append("%s: %s%s" % (s["nombre"], ventanas_txt(s.get("ventanas", []), now),
                                   "  (%s)" % s["nota"] if s.get("nota") else ""))
        else:
            L.append("%s:" % s["nombre"])
            for g in s.get("grupos", []) or []:
                L.append("  %s: %s%s" % (g["nombre"], ventanas_txt(g.get("ventanas", []), now),
                                         "  (hasta el %s)" % g["hasta"] if g.get("hasta") else ""))
    return "\n".join(L)


def proveedor_de(c):
    """Proveedor para mostrar: los de dsh salen por su motor (opencode, ollama, deepseek)."""
    if c["proveedor"] != "dsh":
        return c["proveedor"]
    return "opencode" if c["modelo"].startswith("opencode:") else c["modelo"].split(":", 1)[1].split("/")[0]


def extras_tabla(cfg, c):
    """Por esfuerzo, los extras de AA además del índice de inteligencia (que es `calidad_por_effort`): coding y agentic (sus índices), costo por tarea
    (USD), tokens y segundos. Vacío si no se tienen. `fuente_por_effort` dice de dónde sale cada esfuerzo medido: "api" (Artificial Analysis) o
    "suplemento" (tabla manual del dueño; "suplemento~" si la cifra es aproximada)."""
    ex = aa_buscar_extras(cfg.get("aa"), c["modelo"]) if c.get("origen") == "artificial-analysis" else {}
    out = {}
    for campo, clave in (("coding_por_effort", "coding"), ("agentic_por_effort", "agentic"), ("costo_por_effort", "cost"), ("tokens_por_effort", "tokens"), ("tiempo_por_effort", "time")):
        d = {e: (_n(v[clave]) if clave in ("coding", "agentic") else round(v[clave], 4)) for e, v in ex.items() if clave in v}
        if d:
            out[campo] = d
    if ex:
        out["fuente_por_effort"] = {e: ("api" if not v.get("suplemento") else "suplemento~" if v.get("aproximado") else "suplemento") for e, v in ex.items()}
    return out


def efforts_estimados_tabla(c):
    """Los esfuerzos que el modelo puede correr y NO están medidos (se estiman con calidad_en_effort): `efforts_estimados` (lista) y
    `calidad_estimada_por_effort` ({esfuerzo: cifra estimada}). El resto de `calidad_por_effort` es medido (o fijado por el dueño). El
    `effort_usado` es estimado si está en `efforts_estimados`."""
    medido = c.get("calidad_por_effort") or {}
    est = [e for e in c.get("efforts_posibles") or [] if e not in medido]
    if not medido or not est:
        return {}
    return {"efforts_estimados": est, "calidad_estimada_por_effort": {e: calidad_en_effort(medido, e, c["calidad_mejor"]) for e in est}}


def tabla(cfg, cupos, now):
    """Todos los modelos que reparto conoce, con lo que decide su puntaje (mismos candidatos que --tipo: armar_candidatos).
    `permitido` = ninguna regla de `excluir` lo saca. Se arma con el tipo más flojo (lectura) sólo para listar: la
    calidad mínima del tipo no entra en la tabla."""
    # Se arma con el effort de los tipos de código (EFFORT_TABLA = high) para que `calidad` sea el puntaje en el esfuerzo que se usaría de verdad
    # (con efforts_permitidos aplicado), nunca el del mejor esfuerzo medido; `effort_usado` dice cuál es.
    cands, _, _ = armar_candidatos("lectura", cfg, cupos, now, effort=EFFORT_TABLA)
    out = []
    for c in cands:
        fam = c["familia"]
        if fam == "dsh":
            fam = "opencode" if c["modelo"].startswith("opencode:") else "dsh"
        x = excluido_por(c["modelo"], cfg["excluir"], fam)
        gratis = c["proveedor"] == "local" or bool(c.get("gratis"))
        out.append({
            "id": c["modelo"], "nombre": c["nombre"], "proveedor": proveedor_de(c), "cuenta": c.get("cuenta"),
            "grupo": c["grupo"], "familia": c["familia"], "familia_excluir": fam, "calidad": c["calidad"], "effort_usado": c.get("effort_calidad"), "calidad_por_effort": c.get("calidad_por_effort") or {}, "estimada": bool(c.get("estimada")),
            **efforts_estimados_tabla(c),
            **extras_tabla(cfg, c),
            "origen": c.get("origen") or ("estimada" if c.get("estimada") else "defecto"),
            "aa_fecha": cfg["aa"]["fecha"] if c.get("origen") == "artificial-analysis" and cfg.get("aa") else None,
            "gratis": gratis, **({"plan": c["plan_go"], "go": go_topes(cfg, c["modelo"])} if c.get("plan_go") else {}),
            "cupo_libre": c["cupo_libre"], "vuelve": c["vuelve"], "ventanas": c.get("ventanas", []),
            "urgencia": c.get("urgencia", 0.0), "permitido": not x, "excluido_por": x,
            "agotado": bool(c["descartado_por"]) and c["descartado_por"].startswith(("dijo sin cupo", "Claude dijo", "ventana")),
        })
    return out


def texto_tabla(filas, now):
    L = ["%-46s %-9s %5s  %-17s %-6s %-10s %s" % ("modelo", "proveedor", "int.", "esfuerzo", "costo", "cupo libre", "permitido")]
    for f in filas:
        cupo = "-" if f["cupo_libre"] is None else pct(f["cupo_libre"])
        if f["vuelve"]:
            cupo += " (vuelve en %s)" % humano(horas_hasta(f["vuelve"], now))
        ef = f.get("effort_usado")   # medido / estimado con texto (no sólo color o un símbolo): el esfuerzo sin dato propio se interpola
        ef_txt = "-" if not ef else "%s %s" % (ef, "estimado" if ef in (f.get("efforts_estimados") or []) else "medido")
        L.append("%-46s %-9s %5.1f%s  %-17s %-6s %-10s %s" % (f["id"] + (" · " + f["cuenta"] if suf(f.get("cuenta")) else ""),
                 f["proveedor"], f["calidad"], "~" if f["estimada"] else " ", ef_txt, "gratis" if f["gratis"] else "Go" if f.get("plan") else "pago", cupo,
                 "sí" if f["permitido"] else "no (%s)" % f["excluido_por"]))
    return "\n".join(L)


def aa_diag(cfg, filas):
    """Por cada modelo local (ids únicos de la tabla): con qué entrada de AA se emparejó (nombre y slug), su índice de inteligencia, y lo mismo por
    esfuerzo (medido, o estimado para los que faltan); o "sin coincidencia" y de dónde sale entonces su cifra. Para revisar los emparejamientos."""
    aa = cfg.get("aa")
    out = {"aa_fecha": aa["fecha"] if aa else None, "unidades": "Índice de inteligencia de AA (sin calibrar)", "modelos": []}
    vistos = set()
    for f in filas:
        mid = f["id"]
        if mid in vistos:
            continue
        vistos.add(mid)
        e, _ = aa_entrada(aa, mid) if aa else (None, None)
        r = aa_buscar(aa, mid) if aa else None
        d = {"id": mid, "tokens": " ".join(aa_tokens(mid)), "calidad": f["calidad"], "origen": f["origen"], "permitido": f["permitido"],
             "aa": None, "efforts": {}}
        if r and e:
            met = r[2]
            d["aa"] = {"nombre": r[1], "slug": e[met][2], "metrica": met, "indice": round(r[0], 2)}
            crudos = aa_buscar_efforts(aa, mid)
            cal = aa_calidad_efforts(aa, mid)
            fuentes = {ef: v.get("suplemento") and "suplemento" or "api" for ef, v in aa_buscar_extras(aa, mid).items()}
            d["efforts"] = {ef: {"indice": round(crudos[ef], 2), "usado": cal[ef], "estado": "medido", "fuente": fuentes.get(ef, "api")} for ef in EFFORTS_AA if ef in crudos and ef in cal}
            if d["efforts"]:   # los que faltan se estiman (calidad_en_effort): se marcan "estimado", nunca como medidos
                d["efforts"].update({ef: {"indice": None, "usado": calidad_en_effort(cal, ef, d["aa"]["indice"]), "estado": "estimado", "fuente": None}
                                     for ef in EFFORTS_AA if ef not in d["efforts"]})
                d["efforts"] = {ef: d["efforts"][ef] for ef in EFFORTS_AA}
        out["modelos"].append(d)
    return out


def texto_aa_diag(d):
    L = []
    if d["aa_fecha"] is None:
        L.append("sin caché de Artificial Analysis (aa-modelos.json): ningún modelo se mide; valen los defaults y la estimación por el nombre")
    else:
        L.append("Artificial Analysis, dato del %s. Unidades: %s" % (d["aa_fecha"], d["unidades"]))
        L.append("(medido = lo trae AA o la tabla suplementaria; estimado = interpolado entre los medidos, no es un dato de AA)")
    for m in d["modelos"]:
        L.append("")
        L.append("%s%s" % (m["id"], "" if m["permitido"] else "   [excluido en modelos.json]"))
        if m["aa"]:
            a = m["aa"]
            L.append("  AA: %s [%s]  índice de inteligencia %s" % (a["nombre"], a["slug"] or "-", a["indice"]))
            L.append("  por effort: %s" % (" · ".join("%s %s (%s%s)" % (ef, fn(v["usado"]), v["estado"], " en " + v["fuente"] if v["fuente"] == "suplemento" else "")
                                                   for ef, v in m["efforts"].items()) or "ninguno medido"))
        else:
            L.append("  AA: sin coincidencia (buscado como \"%s\"); cifra %s de origen %s" % (m["tokens"], m["calidad"], m["origen"]))
    return "\n".join(L)


def texto_plan(plan, ritmo):
    L = []
    L.append("Días ausentes: %s" % (", ".join(plan["ausente"]) or "ninguno"))
    L.append("Hoy: %s" % {"gastar": "gastar (usar más las suscripciones)", "ahorrar": "ahorrar (cuidar las suscripciones)"}.get(plan["hoy"], "sin pista"))
    for r in ritmo:
        quien = r["nombre"] + (" – %s" % r["grupo"] if r.get("grupo") else "")
        L.append("Ritmo %s semanal: usado %d %%, esperado %d %% -> %s%s" % (
            quien, round(r["usado"] * 100), round(r["esperado"] * 100), veces(r["ratio"]),
            {"encima": " (por encima: los workers usan más modelos gratis)", "debajo": " (por debajo: se aprovecha antes del reinicio)"}.get(r["nivel"], " (al ritmo)")))
    return "\n".join(L)


def cmd_plan(args, json_out, cfg, now):
    """reparto --plan ausente F[,F] | gastar-hoy | ahorrar-hoy | ver | borrar. Guarda en <estado>/plan.json lo que dice el dueño; vence solo."""
    sub = (args[0] if args else "ver").lower()
    plan = plan_leer(now)
    antes = None
    try:
        cupos = leer_cupos(cfg, now)
    except Exception:
        cupos = {"suscripciones": []}
    cfg["plan"] = plan
    antes = resumen_ritmo(cfg, cupos, now)
    if sub == "ausente" and len(args) >= 2:
        try:
            nuevas = fechas_de(",".join(args[1:]), now)
        except ValueError as e:
            err("--plan ausente: %s" % e)
            return 2
        plan["ausente"] = sorted(set(plan["ausente"]) | set(nuevas))
        msg = "Ausente: %s" % ", ".join(nuevas)
    elif sub == "presente" and len(args) >= 2:   # saca días de la lista de ausentes
        try:
            quitar = fechas_de(",".join(args[1:]), now)
        except ValueError as e:
            err("--plan presente: %s" % e)
            return 2
        plan["ausente"] = [d for d in plan["ausente"] if d not in quitar]
        msg = "Ya no ausente: %s" % ", ".join(quitar)
    elif sub in ("gastar-hoy", "ahorrar-hoy") and len(args) == 1:
        plan["hoy"] = sub.split("-")[0]
        msg = "Hoy: %s" % ("gastar más de las suscripciones" if plan["hoy"] == "gastar" else "ahorrar las suscripciones")
    elif sub == "borrar" and len(args) == 1:
        plan = {"ausente": [], "hoy": None, "actualizado": None}
        msg = "Plan borrado"
    elif sub == "ver" and len(args) <= 1:
        msg = None
    else:
        err("uso: reparto --plan ausente <AAAA-MM-DD>[,..] | presente <fecha> | gastar-hoy | ahorrar-hoy | ver | borrar")
        return 2
    if msg:
        plan_grabar(plan, now)
    cfg["plan"] = plan
    despues = resumen_ritmo(cfg, cupos, now)
    if json_out:
        print(json.dumps({"version": VERSION, "plan": plan, "perfil": cfg["perfil"], "reserva_lider": reserva_lider_de(cfg),
                          "ritmo_antes": antes if msg else None, "ritmo": despues}, ensure_ascii=False))
        return 0
    if msg:
        print(msg + ".")
        for x, y in zip(antes, despues):
            if x["ratio"] != y["ratio"]:
                print("Ritmo %s semanal: %s -> %s (esperado %d %% -> %d %%)." % (y["nombre"], veces(x["ratio"]), veces(y["ratio"]),
                                                                                round(x["esperado"] * 100), round(y["esperado"] * 100)))
    print(texto_plan(plan, despues))
    return 0


def uso():
    sys.stdout.write(__doc__)
    return 2


def main(argv):
    a = list(argv)
    json_out = "--json" in a
    expl = "--explicar" in a
    a = [x for x in a if x not in ("--json", "--explicar")]
    opt = {}
    for k in ("--cuenta", "--mismo-proveedor"):
        if k in a[1:]:
            i = a.index(k, 1)
            if i + 1 >= len(a):
                return uso()
            opt[k] = a[i + 1]
            del a[i:i + 2]
    if "--mismo-proveedor" in opt and opt["--mismo-proveedor"] not in PROVEEDORES:
        err("--mismo-proveedor quiere claude, google o chatgpt")
        return 2
    if not a or a[0] in ("-h", "--help"):
        return uso()
    cfg = cargar_config()
    now = ahora()
    if a[0] == "--plan":
        return cmd_plan(a[1:], json_out, cfg, now)
    if a[0] == "--cupos":
        d = leer_cupos(cfg, now)
        print(json.dumps(d, ensure_ascii=False, indent=None if not sys.stdout.isatty() else 2) if json_out
              else texto_cupos(d, now))
        return 0
    if a[0] == "--tabla" and len(a) == 1:
        try:
            d = leer_cupos(cfg, now)
        except Exception as e:
            err("no pude leer los cupos: %s" % e)
            return 1
        filas = tabla(cfg, d, now)
        print(json.dumps({"version": VERSION, "leido": d.get("leido"), "modelos": filas}, ensure_ascii=False) if json_out
              else texto_tabla(filas, now))
        return 0
    if a[0] == "--aa-diag" and len(a) == 1:
        try:
            d = leer_cupos(cfg, now)
        except Exception as e:
            err("no pude leer los cupos: %s" % e)
            return 1
        r = aa_diag(cfg, tabla(cfg, d, now))
        print(json.dumps(r, ensure_ascii=False) if json_out else texto_aa_diag(r))
        return 0
    if a[0] == "--tipo" and len(a) == 2:
        try:
            d = leer_cupos(cfg, now)
        except Exception as e:
            err("no pude leer los cupos: %s" % e)
            return 1
        r = elegir(a[1], cfg, d, now, opt.get("--mismo-proveedor"), opt.get("--cuenta"))
        if expl:
            r["explicacion"] = explicar(r, now, d, cfg)
        if json_out:
            print(json.dumps(r, ensure_ascii=False))
        elif expl:
            print(r["explicacion"])
        else:
            print("%s%s — %s" % (r["modelo"], " " + r["effort"] if r.get("effort") else "", r["motivo"]))
        return 0 if r.get("modelo") else 1
    if a[0] == "--agotar" and len(a) in (2, 4) and (len(a) == 2 or a[2] == "--hasta"):
        return agotar(a[1], a[3] if len(a) == 4 else None, cfg, now, opt.get("--cuenta"))
    if a[0] == "--excluido" and len(a) == 2:
        x = excluido_por(a[1], cfg["excluir"], "local" if a[1].lower().startswith("ollama:") else None)
        if x:
            print(x)
        return 0 if x else 1
    if a[0] == "--olvidar-agotados" and len(a) == 1:
        try:
            os.remove(os.path.join(state_dir(), "agotado.json"))
        except FileNotFoundError:
            pass
        return 0
    if a[0] == "--cuenta-para" and len(a) == 2:
        try:
            r = cuenta_para(a[1], leer_cupos(cfg, now), now)
        except Exception as e:
            err("no pude leer los cupos: %s" % e)
            return 1
        if not r:
            err("%s no se corre con una cuenta (no es claude-* ni de agy)" % a[1])
            return 1
        print(json.dumps(r, ensure_ascii=False) if json_out else r["cuenta"])
        return 0
    if a[0] == "--resolver" and len(a) == 2:
        r = resolver(a[1])
        if not r:
            err("id de modelo desconocido: %s" % a[1])
            return 1
        print(json.dumps(r, ensure_ascii=False) if json_out else "%s %s" % (r["motor"], r["modelo"]))
        return 0
    return uso()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

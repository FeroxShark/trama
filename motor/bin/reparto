import importlib.util
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone

VERSION = 1

# --- unidades de la inteligencia ----------------------------------------------------------------------
# `calidad` y todo lo que se compara con ella está en UNIDADES REALES de Artificial Analysis: su índice de INTELIGENCIA general (sin calibrar a
# 100; coding y agentic son sólo datos extra). Las cifras de abajo (CALIDAD, MINIMO por número, 70, 50, 35...) son de la escala vieja 0-100 en la que
# se escribieron; `vieja_a_aa` las pasa a unidades de AA con la inversa de la calibración que se usaba (Haiku 5.5 -> 60, Sonnet 5.5 -> 88,
# Opus 5.5 -> 100, línea quebrada entre esos puntos y con la pendiente del tramo más cercano afuera). Las anclas son estas AA_REF_VIEJA
# (valores típicos del índice de inteligencia de AA de esos tres modelos en su mejor esfuerzo: Haiku 5.5 max ~43, Sonnet 5.5 ~51, Opus 5.5 max ~58; fijas para que el pasaje sea el mismo en la app y acá). Se usa para: los defaults
# sin dato de AA, la estimación por el nombre y los valores que el dueño escribió en la escala vieja (`calidad`, `calidad_effort`,
# `minimo_por_tipo` numérico) cuando modelos.json NO trae "calidad_unidades": "aa" (la app lo escribe al guardar). Con "aa" valen tal cual.
AA_REF_VIEJA = ((60.0, 43.0), (88.0, 51.0), (100.0, 58.0))   # (escala vieja, unidades de AA)


def _n(x):
    """Un decimal; entero si es redondo (43.0 -> 43): así el JSON no arrastra ceros."""
    r = round(x, 1)
    return int(r) if r == int(r) else r


def fn(x):
    """Una cifra de inteligencia para mostrar: un decimal sin ceros de sobra (43.0 -> 43, 47.9 -> 47.9)."""
    return ("%.1f" % x).rstrip("0").rstrip(".") if isinstance(x, (int, float)) else str(x)


def vieja_a_aa(q):
    """Una inteligencia de la escala vieja 0-100 -> unidades de AA (un decimal, nunca negativa). Ver AA_REF_VIEJA."""
    pts = AA_REF_VIEJA
    i = 0 if q <= pts[1][0] else 1
    (x0, y0), (x1, y1) = pts[i], pts[i + 1]
    return _n(max(0.0, y0 + (y1 - y0) * (q - x0) / (x1 - x0)))



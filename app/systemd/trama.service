[Unit]
Description=trama (hilos): workers de pa y líderes de Claude, siempre viva y escondida
# Con la sesión gráfica, y se va con ella.
PartOf=graphical-session.target
After=graphical-session.target
# El motor (trama-motor.service) corre aparte: la ventana lo quiere cerca y espera su arranque, pero no
# depende de él (sin BindsTo: parar o reiniciar uno no arrastra al otro).
Wants=trama-motor.service
After=trama-motor.service
# Wayland nativo siempre (nunca XWayland): sin compositor no arranca.
ConditionEnvironment=WAYLAND_DISPLAY
# Bucle de arranques fallidos: con RestartSec de 500 ms, 15 arranques en 20 s la rinden (queda caída hasta que
# se la arranque: `trama` o `systemctl --user start`). Un bucle de ~0,7 s la rinde a los ~10 s; uno más lento
# no llega al tope.
StartLimitIntervalSec=20
StartLimitBurst=15

[Service]
# El lanzador que escribe scripts/instalar.sh: sabe dónde está el checkout y arma lo que falte.
# Con TRAMA_UNIDAD va directo a Electron; --escondida: sin ventana hasta que se la pida.
Environment=TRAMA_UNIDAD=1
ExecStart=%h/.local/bin/trama --escondida
# Siempre viva: si muere, si sale con Ctrl+Q o si se la reinicia por un build nuevo, vuelve
# escondida en 0,5 s (el acceso desde el celular vive en este proceso).
Restart=always
RestartSec=500ms
# 3 = ya había una trama abierta a mano (el candado de instancia única es de ella): no se insiste.
RestartPreventExitStatus=3
SuccessExitStatus=3
# Sólo el proceso de Electron. Los workers que lanzan los líderes (`pa`, con setsid) quedan en
# este cgroup: con el default (control-group) cada relanzo de trama los mataría a todos.
KillMode=process
# Al parar, trama espera a los líderes que responden antes de salir (electron/ipc.ts).
TimeoutStopSec=120

[Install]
WantedBy=graphical-session.target

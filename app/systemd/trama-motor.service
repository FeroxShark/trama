[Unit]
Description=trama (hilos): el motor sin ventana (líderes de Claude, cola, vigía y acceso por la tailnet)
Documentation=file://%h/Proyectos/hilos/docs/estado/motor.md
# A diferencia de trama.service (la ventana), no depende de la sesión gráfica: ni PartOf=graphical-session
# ni ConditionEnvironment=WAYLAND_DISPLAY. Con `loginctl enable-linger ana` arranca con la máquina y
# sigue sin sesión abierta (el celular entra igual). Sin linger, arranca con la primera sesión.
# Bucle de arranques fallidos: igual que trama.service, 15 en 20 s la rinden (queda caída hasta que se la arranque
# con `systemctl --user start`). Medido en docs/estado/reinicio-rapido.md.
StartLimitIntervalSec=20
StartLimitBurst=15

[Service]
# Node puro: el binario de Electron del checkout con ELECTRON_RUN_AS_NODE (sin Chromium, sin pantalla,
# sin depender del `node` del sistema). El checkout es siempre ~/Proyectos/hilos: instalar.sh se niega
# a correr desde un worktree.
Environment=ELECTRON_RUN_AS_NODE=1
Environment=HILOS_MOTOR=1
# Como trama.service: el motor no se relanza solo fuera de la unidad (electron/motor.ts).
Environment=TRAMA_UNIDAD=1
# Sin sesión gráfica no hay el PATH del escritorio: `claude`, `pa`, `tablero` y `tailscale` tienen que
# estar acá (~/.local/bin y /usr/bin).
Environment=PATH=%h/.local/bin:/usr/bin
# Los push por ssh de los workers (y de `pa --integrar`) buscan un agente. Sin sesión gráfica nadie
# exporta SSH_AUTH_SOCK a la unidad (`systemctl --user show-environment` lo trae vacío): esta ruta es la
# del ssh-agent.socket de systemd, que ssh ignora si no existe. Hoy no hace falta: ~/.ssh/id_ed25519 no
# tiene passphrase y ssh la lee del disco. Si algún día se le pone una, habilitar `ssh-agent.socket`.
Environment=SSH_AUTH_SOCK=%t/ssh-agent.socket
ExecStart=%h/Proyectos/hilos/node_modules/electron/dist/electron %h/Proyectos/hilos/dist-electron/motor.js
# Siempre vivo: si muere o lo reinicia un build nuevo, vuelve en 0,5 s.
Restart=always
RestartSec=500ms
# 3 = ya había un motor escuchando en el socket (el candado es el socket): no se insiste.
RestartPreventExitStatus=3
SuccessExitStatus=3
# Sólo el proceso del motor. Los workers que lanzan los líderes (`pa`, con setsid) quedan en este cgroup:
# con el default (control-group) cada relanzo del motor los mataría a todos.
KillMode=process
# Con SIGTERM el motor guarda lo leído, cierra a los líderes (tope 10 s) y sale.
TimeoutStopSec=30

[Install]
WantedBy=default.target

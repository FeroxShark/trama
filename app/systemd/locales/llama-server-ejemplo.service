# PLANTILLA de trama (systemd/locales/) para un modelo local de llama-server declarado en ~/.config/trama/locales.json.
# Copiala con el nombre de TU unit (el campo `unit` de locales.json), cambiá <modelo>, <clave>, <alias> y las rutas:
#   cp systemd/locales/llama-server-ejemplo.service ~/.config/systemd/user/llama-server-<modelo>.service && systemctl --user daemon-reload
# No reinicia nada; rige en la próxima carga del modelo. Ver docs/estado/locales.md.
#
# `-c ${LLAMA_CTX}`: el valor sale de %h/.config/trama/locales/<clave>.env (lo escribe el botón de contexto de trama: Guardar / Probar);
# si ese archivo no existe vale el default de abajo. `<clave>` es el campo `clave` de locales.json (sin él, el `id`).
[Unit]
Description=llama-server <modelo> en 127.0.0.1:8080
# Un modelo a la vez en el 8080: sin [Install] a propósito (lo arranca el conmutador de locales.json, o trama con `systemctl --user start`).
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
Environment=LLAMA_CTX=32768
EnvironmentFile=-%h/.config/trama/locales/<clave>.env
# Si la VRAM queda al límite: bajar --ubatch-size (1024 → 512) y después -c.
# `--alias` es el `alias` de locales.json (sin él, el `id`): trama mira /v1/models para saber qué modelo sirve el 8080.
ExecStart=%h/llama.cpp/build/bin/llama-server \
    -m %h/models/<modelo>/<modelo>.gguf \
    --host 127.0.0.1 --port 8080 --alias <alias> \
    -c ${LLAMA_CTX} -ngl 99 --flash-attn on \
    --cache-type-k q8_0 --cache-type-v q8_0 \
    --threads 10 --batch-size 4096 --ubatch-size 1024 --parallel 1 \
    --jinja
Restart=on-failure
RestartSec=5

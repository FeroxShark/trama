# PLANTILLA de trama (systemd/locales/): igual que la unit de ~/.config/systemd/user/ salvo el contexto.
# `-c ${LLAMA_CTX}`: el valor sale de %h/.config/trama/locales/hauhaucs.env (lo escribe el botón de contexto de trama:
# Guardar / Probar); si ese archivo no existe vale el default de abajo (el -c de siempre). Para usarla:
#   cp systemd/locales/qwen-llama-server.service ~/.config/systemd/user/ && systemctl --user daemon-reload
# (no reinicia nada; rige en la próxima carga del modelo). Ver docs/estado/locales.md.
[Unit]
Description=llama-server Qwen3.8 27B HauhauCS (uncensored, multimodal, FastMTP) en 127.0.0.1:8080
# Un modelo a la vez en el 8080: sin [Install] a propósito (ver qwen-model-switch).
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
Environment=LLAMA_CTX=32768
EnvironmentFile=-%h/.config/trama/locales/hauhaucs.env
Environment=LD_LIBRARY_PATH=/opt/cuda/lib64
# VRAM al límite (24 GB compartidos con asistente-tts-qwen + escritorio):
# - --no-mmproj-offload: el mmproj BF16 en GPU (~900 MB) ya no entraba (OOM en
#   mtmd_init_from_file); la visión corre en CPU.
# - -c ${LLAMA_CTX} desde el 2026-09-11 (40960 era el máximo sin TTS; dsh/OpenClaw declaraban 40960).
# - Si vuelve a OOM: bajar --ubatch-size (1024->512), después -c. No sacar el draft MTP.
# - El draft FastMTP necesita el patch HauhauCS-FastMTP (tensor d2t en src/models/qwen35.cpp).
ExecStart=%h/llama.cpp/build/bin/llama-server \
    -m %h/models/qwen38-27b/Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-Q4_K_P.gguf \
    --mmproj %h/models/qwen38-27b/mmproj-Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-BF16.gguf \
    --no-mmproj-offload \
    --spec-draft-model %h/models/qwen38-27b/Qwen3.8-27B-Uncensored-HauhauCS-Aggressive-FastMTP-32K.gguf \
    --host 127.0.0.1 --port 8080 --alias qwen38-uncensored \
    -c ${LLAMA_CTX} -ngl 99 --flash-attn on \
    --cache-type-k q8_0 --cache-type-v q8_0 \
    --reasoning-effort medium \
    --threads 10 --batch-size 4096 --ubatch-size 1024 --parallel 1 \
    --jinja
Restart=on-failure
RestartSec=5

[Unit]
Description=trama (hilos): el motor sin ventana en el servidor (líderes de Claude, cola, vigía y acceso por la tailnet)
Documentation=file://%h/Proyectos/hilos/docs/estado/dell.md
# La versión de servidor de trama-motor.service: unidad de usuario, con `linger` (arranca con la máquina y
# sigue sin sesión). Sin Electron ni pantalla: un `node` oficial instalado en ~/.local, no el del sistema.
# Lo enlaza scripts/instalar-servidor.sh; en una máquina con pantalla no se usa.
# Los límites de memoria y de red NO van acá: los pone el slice del usuario (/etc/systemd/system/user-<uid>.slice.d/).

[Service]
# Node puro: dist-electron/motor.js no importa `electron` (lo comprueba tests/motor.test.ts). El checkout es
# siempre ~/Proyectos/hilos del usuario del servidor.
Environment=HILOS_MOTOR=1
# Como trama-motor.service: el motor no se relanza solo fuera de la unidad (electron/motor.ts).
Environment=TRAMA_UNIDAD=1
# Tope de workers vivos a la vez (entre todos los proyectos): lo lee `pa` y lo heredan los líderes que lanza el
# motor. 2 workers caben en el tope de memoria del slice (2,5 GB); con más RAM se sube acá y en el slice.
Environment=PA_TOPE=2
# Sin sesión gráfica no hay PATH de escritorio: `node`, `claude`, `pa` y `tablero` viven en ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=%h/.local/bin/node %h/Proyectos/hilos/dist-electron/motor.js
# Siempre vivo: si muere o lo reinicia un build nuevo, vuelve en 2 s.
Restart=always
RestartSec=2
# 3 = ya había un motor escuchando en el socket (el candado es el socket): no se insiste.
RestartPreventExitStatus=3
SuccessExitStatus=3
# Sólo el proceso del motor. Los workers que lanzan los líderes (`pa`, con setsid) quedan en este cgroup:
# con el default (control-group) cada relanzo del motor los mataría a todos.
KillMode=process
# El OOM del kernel (el tope del slice se llena) mata a UN proceso de este cgroup, el más pesado, que casi
# siempre es un worker (la fila queda en "Murió"). Con el default de systemd (OOMPolicy=stop) esa sola muerte
# bajaría la unidad entera: el motor y todos los workers. Con `continue` el motor sigue y el vigía lo cuenta.
OOMPolicy=continue
# OJO: acá NO va OOMScoreAdjust=-500. Una unidad de usuario no puede bajar su puntaje (hace falta
# CAP_SYS_RESOURCE): systemd lo ignora sin avisar y el motor queda en el 100 del administrador de usuario
# (comprobado con systemd-run --user). Qué cubre al motor en su lugar: docs/estado/dell.md, "Si falta memoria".
# Con SIGTERM el motor guarda lo leído, cierra a los líderes (tope 10 s) y sale.
TimeoutStopSec=30

[Install]
WantedBy=default.target
